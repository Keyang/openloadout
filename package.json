{
  "name": "loadout",
  "private": true,
  "type": "module",
  "description": "Loadout: procedurally made, customisable, game-ready sprites, sound effects and music, served as a static site.",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "build": "node tools/build.mjs",
    "check": "node tools/check.mjs",
    "render": "node tools/render.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/figtree": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@huggingface/transformers": "4.3.2",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
