{
  "format": "loadout-sprite",
  "version": 2,
  "id": "ui-buttons-grove",
  "name": "Vine buttons",
  "blurb": "A stretchable dark bark menu button wrapped in a pale living vine with leaves and flowers at its corners, in four states (normal, hover, pressed, disabled) plus a tab and an open tab; change the style, corners, vine thickness, leaves and colours.",
  "meta": {
    "type": "ui",
    "role": "interface/button",
    "themes": ["neutral","forest","farm"],
    "gameTypes": ["arcade","farming-sim","top-down-rpg","puzzle"],
    "view": "none",
    "words": ["button","vine","leaf","forest","nature","garden","bark","flower"],
    "license": "draft"
  },
  "size": [96,32],
  "pivot": [48,16],
  "grounded": false,
  "preview": "normal",
  "styles": ["pixel"],
  "palette": [
    {"id":"face","label":"Bark","default":"#7a4f33","material":"interface","swatches":["#7a4f33","#3f5068","#8e3a4a","#434d6d"]},
    {"id":"frame","label":"Vine","default":"#9bd18a","material":"interface","swatches":["#9bd18a","#7fe0a0","#e6c96a","#f0ead8"]},
    {"id":"accent","label":"Leaves and flowers","default":"#6aa83e","material":"interface","swatches":["#6aa83e","#c9423a","#e08a2c","#7a4fc4","#3f6fd1"]}
  ],
  "controls": [
    {
      "key": "style",
      "kind": "choice",
      "label": "Style",
      "options": [{"value":"vine","label":"Vine"},{"value":"bark","label":"Bark"},{"value":"bloom","label":"Bloom"}],
      "default": "vine",
      "group": "Look"
    },
    {"key":"corner","kind":"range","label":"Corner","lo":"Square","hi":"Round","default":0.75,"group":"Look"},
    {"key":"border","kind":"range","label":"Border","lo":"Thin","hi":"Thick","default":0.5,"group":"Look"},
    {"key":"leaves","kind":"toggle","label":"Leaves","default":true,"group":"Look"},
    {"key":"face","kind":"colour","label":"Bark","group":"Colors"},
    {"key":"frame","kind":"colour","label":"Vine","group":"Colors"},
    {"key":"accent","kind":"colour","label":"Leaves and flowers","group":"Colors","when":[{"leaves":[true]},{"style":["bloom"]}]}
  ],
  "versions": [
    {"name":"Vine","params":{}},
    {"name":"Straw bark","params":{"style":"bark","leaves":false,"frame":"#e6c96a"}},
    {"name":"Bloom","params":{"style":"bloom","accent":"#c9423a","frame":"#7fe0a0"}},
    {"name":"Birch at night","params":{"face":"#3f5068","frame":"#f0ead8","accent":"#3f6fd1"}},
    {"name":"Berry","params":{"face":"#8e3a4a","accent":"#e08a2c","corner":0.25}}
  ],
  "body": {
    "panel": {
      "skin": {"use":"skin:grove","v":2,"paint":{"face":"face","frame":"frame","accent":"accent"}},
      "piece": {
        "gen": "ui.slab",
        "v": 1,
        "clip": ["normal","hover","pressed","disabled"],
        "role": "button",
        "at": [1,1],
        "size": [94,30],
        "style": {"from":"style"},
        "corner": {"from":"corner","map":[[0,0],[1,4]]},
        "border": {"from":"border","map":[[0,1],[1,3]]},
        "extras": {"from":"leaves"}
      },
      "states": ["normal","hover","pressed","disabled","tab","tab-active"],
      "draw": [
        {
          "gen": "ui.slab",
          "v": 1,
          "clip": ["tab"],
          "role": "tab",
          "at": [1,1],
          "size": [94,30],
          "style": {"from":"style"},
          "corner": {"from":"corner","map":[[0,0],[1,4]]},
          "border": {"from":"border","map":[[0,1],[1,3]]},
          "extras": {"from":"leaves"}
        },
        {
          "gen": "ui.slab",
          "v": 1,
          "clip": ["tab-active"],
          "role": "tab-open",
          "at": [1,1],
          "size": [94,31],
          "style": {"from":"style"},
          "corner": {"from":"corner","map":[[0,0],[1,4]]},
          "border": {"from":"border","map":[[0,1],[1,3]]},
          "extras": {"from":"leaves"}
        }
      ]
    }
  },
  "clips": {
    "normal": {"frames":1,"fps":8,"label":"At rest, not pointed at"},
    "hover": {"frames":1,"fps":8,"label":"Pointed at by the cursor"},
    "pressed": {"frames":1,"fps":8,"label":"Held down while pressed","sounds":[{"sound":"menu-wood-confirm","preset":"Select","frame":0,"volume":0.6}]},
    "disabled": {"frames":1,"fps":8,"label":"Greyed out, not available now"},
    "tab": {"frames":1,"fps":8,"label":"Tab, for a page that is not open"},
    "tab-active": {"frames":1,"fps":8,"label":"Open tab, for the page on view","sounds":[{"sound":"menu-wood-move","preset":"Tab","frame":0,"volume":0.6}]}
  }
}
