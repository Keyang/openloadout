{ "format": "loadout-sprite",
  "version": 2,
  "id": "ui-crosshair",
  "name": "Crosshair",
  "blurb": "An aiming cursor that breathes, kicks when firing, shows a reload sweep and flashes a hit marker; change its style, size, gap, thickness, spin and colours.",
  "meta": {"type": "ui", "role": "interface/cursor", "themes": ["sci-fi", "neutral"], "gameTypes": ["roguelike-action", "shooter", "arcade"], "view": "none", "words": ["crosshair", "reticle", "cursor", "aim", "target", "sight", "pointer", "shoot", "reload", "hit", "marker", "mouse"], "license": "draft"},
  "size": [32,32],
  "pivot": [16,16],
  "grounded": false,
  "preview": "idle",
  "styles": ["pixel"],
  "palette": [
  {"id": "body", "label": "Body", "default": "#f0ead8", "material": "interface", "swatches": ["#f0ead8", "#5fe0f0", "#9fe040", "#f2a030", "#b48af8"]},
  {"id": "accent", "label": "Accent", "default": "#e2473f", "material": "interface", "swatches": ["#e2473f", "#f2a030", "#2fb3a8", "#3f6fd1", "#5fe0f0", "#9fe040"]} ],
  "controls": [
  {"key": "style", "kind": "choice", "label": "Style", "options": ["cross", "circle", "brackets", "chevrons"], "default": "cross"},
  {"key": "size", "kind": "range", "label": "Size", "lo": "Small", "hi": "Big", "default": 0.6},
  {"key": "gap", "kind": "range", "label": "Gap", "lo": "Tight", "hi": "Open", "default": 0.35},
  {"key": "thickness", "kind": "range", "label": "Thickness", "lo": "Thin", "hi": "Chunky", "default": 0.25},
  {"key": "spin", "kind": "toggle", "label": "Spin", "default": false, "when": {"style": ["cross", "circle", "chevrons"]}},
  {"key": "body", "kind": "colour", "label": "Body"},
  {"key": "accent", "kind": "colour", "label": "Accent"},
  {"key": "speed", "standard": "speed"} ],
  "body": { "pictures": {
    "nodes": [
    {"id": "ui", "parent": null, "at": [16,16]} ],
    "draw": [
    {"gen": "crosshair", "v": 1, "on": "ui", "at": [0,0], "clip": ["idle"], "picture": "idle", "style": {"from": "style", "pick": {"cross": "cross", "circle": "circle", "brackets": "brackets", "chevrons": "chevrons"}}, "size": {"from": "size", "map": [[0,0], [1,1]], "round": "none"}, "gap": {"from": "gap", "map": [[0,0], [1,1]], "round": "none"}, "thickness": {"from": "thickness", "map": [[0,0], [1,1]], "round": "none"}, "spin": {"from": "spin", "pick": {"true": true, "false": false}}, "body": "body", "accent": "accent"},
    {"gen": "crosshair", "v": 1, "on": "ui", "at": [0,0], "clip": ["shoot"], "picture": "shoot", "style": {"from": "style", "pick": {"cross": "cross", "circle": "circle", "brackets": "brackets", "chevrons": "chevrons"}}, "size": {"from": "size", "map": [[0,0], [1,1]], "round": "none"}, "gap": {"from": "gap", "map": [[0,0], [1,1]], "round": "none"}, "thickness": {"from": "thickness", "map": [[0,0], [1,1]], "round": "none"}, "spin": {"from": "spin", "pick": {"true": true, "false": false}}, "body": "body", "accent": "accent"},
    {"gen": "crosshair", "v": 1, "on": "ui", "at": [0,0], "clip": ["reload"], "picture": "reload", "style": {"from": "style", "pick": {"cross": "cross", "circle": "circle", "brackets": "brackets", "chevrons": "chevrons"}}, "size": {"from": "size", "map": [[0,0], [1,1]], "round": "none"}, "gap": {"from": "gap", "map": [[0,0], [1,1]], "round": "none"}, "thickness": {"from": "thickness", "map": [[0,0], [1,1]], "round": "none"}, "spin": {"from": "spin", "pick": {"true": true, "false": false}}, "body": "body", "accent": "accent"},
    {"gen": "crosshair", "v": 1, "on": "ui", "at": [0,0], "clip": ["hit"], "picture": "hit", "style": {"from": "style", "pick": {"cross": "cross", "circle": "circle", "brackets": "brackets", "chevrons": "chevrons"}}, "size": {"from": "size", "map": [[0,0], [1,1]], "round": "none"}, "gap": {"from": "gap", "map": [[0,0], [1,1]], "round": "none"}, "thickness": {"from": "thickness", "map": [[0,0], [1,1]], "round": "none"}, "spin": {"from": "spin", "pick": {"true": true, "false": false}}, "body": "body", "accent": "accent"} ] } },
  "points": [{"id": "tip", "on": "ui", "at": [0,0], "angle": 0}],
  "clips": {
    "idle": {"frames": 8, "fps": 8, "label": "Idle"},
    "shoot": {"frames": 4, "fps": 14, "loop": false, "label": "Firing"},
    "reload": {"frames": 8, "fps": 10, "label": "Reload"},
    "hit": {"frames": 4, "fps": 12, "loop": false, "label": "Hit"} } }
