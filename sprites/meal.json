{ "format": "loadout-sprite", "version": 2, "id": "meal", "name": "Hearty meal",
  "blurb": "A floating roast leg, loaf, cheese or pie that restores a lot of health. Change the food, its size, a bite, steam, sparkle and colours.",
  "meta": { "type": "pickup", "role": "items/food", "themes": ["neutral", "fantasy"], "gameTypes": ["platformer", "arcade", "top-down-rpg", "turn-based-rpg"], "view": "front",
            "words": ["meal", "food", "meat", "roast", "drumstick", "bread", "loaf", "cheese", "pie", "eat", "heal", "health", "collect", "feast"], "license": "draft" },
  "size": [32, 32], "pivot": [16, 30], "grounded": false, "preview": "idle", "styles": ["pixel"],
  "palette": [
    { "id": "body", "label": "Food", "default": "#a06a3c", "material": "wood", "swatches": ["#a06a3c", "#7a4f33", "#a8612a", "#5a3a22", "#c98a4a", "#f2c230", "#e6c96a"] },
    { "id": "accent", "label": "Bone", "default": "#f0ead8", "material": "paint", "swatches": ["#f0ead8", "#d8d8e0", "#e0b040", "#8f97a8"] },
    { "id": "cream", "default": "#f0ead8", "material": "paint", "detail": true },
    { "id": "filling", "default": "#c9423a", "material": "paint", "detail": true },
    { "id": "crumb", "material": "wood", "derive": { "rule": "mix", "of": { "rule": "ramp", "of": "body", "tone": "light" }, "with": "cream", "amount": 0.45 } },
    { "id": "gleam", "material": "light", "derive": { "rule": "mix", "of": { "rule": "tone", "of": "body", "by": 0.85 }, "with": "shine", "amount": 0.6 } },
    { "id": "burst-light", "material": "light", "derive": { "rule": "mix", "of": { "rule": "ramp", "of": "body", "tone": "light" }, "with": "shine", "amount": 0.35 } },
    { "id": "shine", "default": "#ffffff", "material": "light", "detail": true } ],
  "controls": [
    { "key": "size", "kind": "range", "label": "Size", "lo": "Small", "hi": "Big", "default": 0.5 },
    { "key": "shape", "kind": "choice", "label": "Shape", "options": ["drumstick", "bread", "cheese", "pie"], "default": "drumstick" },
    { "key": "bite", "kind": "toggle", "label": "Bitten", "default": false },
    { "key": "steam", "kind": "toggle", "label": "Steam", "default": false },
    { "key": "sparkle", "kind": "toggle", "label": "Sparkle", "default": true },
    { "key": "body", "kind": "colour", "label": "Food" },
    { "key": "accent", "kind": "colour", "label": "Bone", "when": { "shape": ["drumstick"] } },
    { "key": "bob", "kind": "range", "label": "Float", "lo": "Still", "hi": "Floaty", "default": 0.5, "group": "Motion" },
    { "key": "pop", "kind": "range", "label": "Pop height", "lo": "Low", "hi": "High", "default": 0.5, "group": "Motion" },
    { "key": "speed", "standard": "speed" } ],
  "body": { "pictures": {
    "nodes": [ { "id": "food", "parent": null, "at": [16, 17] } ],
    "draw": [
      { "id": "meal", "gen": "meal", "v": 1, "on": "food", "at": [0, { "from": "steam", "pick": { "true": 1.5, "false": 0 } }],
        "kind": { "from": "shape", "pick": { "drumstick": "drumstick", "bread": "bread", "cheese": "cheese", "pie": "pie" } },
        "scale": { "from": "size", "map": [[0, 0.78], [1, 1.06]], "round": "none" },
        "bite": { "from": "bite", "pick": { "true": true, "false": false } },
        "food": "body", "bone": "accent", "filling": "filling", "crumb": "crumb", "gleam": "gleam" },
      { "kind": "outline", "paint": "ink" },
      { "id": "steam", "gen": "meal.steam", "v": 1, "on": "food", "clip": ["idle"], "when": { "steam": [true] }, "at": [0, 1.5],
        "kind": { "from": "shape", "pick": { "drumstick": "drumstick", "bread": "bread", "cheese": "cheese", "pie": "pie" } },
        "scale": { "from": "size", "map": [[0, 0.78], [1, 1.06]], "round": "none" }, "room": { "from": "bob", "map": [[0, 17.5], [0.24, 17.5], [0.25, 16.5], [0.74, 16.5], [0.75, 15.5], [1, 15.5]], "round": "none" }, "paint": "cream" },
      { "id": "sparkle-leg", "gen": "gleam", "v": 1, "on": "food", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["drumstick"] },
        "at": [ { "from": "size", "map": [[0, 7.4], [1, 10.7]], "round": "none" }, { "from": "size", "map": [[0, -5.7], [1, -7.1]], "round": "none" } ],
        "peak": 0.5, "paint": "shine", "core": "shine" },
      { "id": "sparkle-loaf", "gen": "gleam", "v": 1, "on": "food", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["bread", "pie"] },
        "at": [ { "from": "size", "map": [[0, 5.8], [1, 8.6]], "round": "none" }, { "from": "size", "map": [[0, -2.8], [1, -3.8]], "round": "none" } ],
        "peak": 0.5, "paint": "shine", "core": "shine" },
      { "id": "sparkle-cheese", "gen": "gleam", "v": 1, "on": "food", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["cheese"] },
        "at": [ { "from": "size", "map": [[0, 5.8], [1, 8.6]], "round": "none" }, { "from": "size", "map": [[0, -3.2], [1, -4.7]], "round": "none" } ],
        "peak": 0.5, "paint": "shine", "core": "shine" } ],
    "motion": [
      { "gen": "pickup.bob", "v": 1, "clip": ["idle"], "height": { "from": "bob", "map": [[0, 0], [1, 2]] } },
      { "gen": "pickup.collect", "v": 1, "node": "food", "clip": ["collect"], "pop": { "from": "pop", "map": [[0, 0], [1, 1]] },
        "low": { "from": "size", "map": [[0, 2], [1, 0.9]] }, "high": { "from": "size", "map": [[0, 4.5], [1, 2]] }, "room": { "from": "size", "map": [[0, 4.5], [1, 2]] } } ],
    "emitters": [
      { "id": "burst", "gen": "pickup.burst", "v": 1, "on": "food", "at": [0, 0], "reach": { "from": "size", "map": [[0, 10.8], [1, 13.6]] },
        "sparkle": { "from": "sparkle", "pick": { "true": true, "false": false } }, "paint": "body", "bright": "burst-light", "core": "shine" } ] } },
  "clips": {
    "idle": { "frames": 8, "fps": 10 },
    "collect": { "frames": 8, "fps": 14, "loop": false, "frameEdits": { "4": { "flash": true } },
      "keys": [ { "t": 0, "ease": "hold", "emit": { "burst": { "amount": 0 } } }, { "t": 0.6, "ease": "linear", "emit": { "burst": { "amount": 0 } } },
                { "t": 1, "emit": { "burst": { "amount": 1 } } } ],
      "sounds": [ { "sound": "heart-pickup", "preset": "Storybook", "frame": 1, "volume": 0.7 } ] } },
  "versions": [
    { "name": "Roast leg", "params": {} },
    { "name": "Bread loaf", "params": { "shape": "bread", "body": "#e6c96a" } },
    { "name": "Cheese wedge", "params": { "shape": "cheese", "body": "#f2c230", "bite": true } },
    { "name": "Hot pie", "params": { "shape": "pie", "steam": true } },
    { "name": "Snack", "params": { "size": 0.3, "bite": true, "steam": false } } ] }
