      "default": "solid",
      "group": "Look"
    },
    {"key":"corner","kind":"range","label":"Corner","lo":"Square","hi":"Round","default":0.5,"group":"Look","when":{"style":["solid","outline"]}},
    {"key":"border","kind":"range","label":"Border","lo":"Thin","hi":"Thick","default":0.5,"group":"Look"},
    {"key":"shadow","kind":"toggle","label":"Shadow","default":false,"group":"Look"},
    {"key":"face","kind":"colour","label":"Face","group":"Colors"},
    {"key":"frame","kind":"colour","label":"Edge","group":"Colors"},
    {"key":"accent","kind":"colour","label":"Focus","group":"Colors"}
  ],
  "versions": [
    {"name":"Blue panel","params":{}},
    {"name":"Outlined","params":{"style":"outline","border":1}},
    {"name":"Rounded wine","params":{"style":"pill","face":"#8e3a4a","accent":"#a4c44a"}},
    {"name":"Brown with shadow","params":{"face":"#7a4f33","shadow":true}},
    {"name":"Night","params":{"face":"#434d6d","accent":"#5fe0f0","frame":"#8fd0f0"}}
  ],
  "body": {
    "panel": {
      "skin": {"use":"skin:flat","v":3,"paint":{"face":"face","frame":"frame","accent":"accent"}},
