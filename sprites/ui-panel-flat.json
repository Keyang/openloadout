{
  "format": "loadout-sprite",
  "version": 2,
  "id": "ui-panel-flat",
  "name": "Flat panels",
  "blurb": "Stretchable flat boxes with no light or bevel for menus and results: a plain panel, one with a heading, a list well and a tooltip, each with a coloured focus line; change the style, corners, edge, shadow and colours.",
  "meta": {
    "type": "ui",
    "role": "interface/panel",
    "themes": ["neutral","city"],
    "gameTypes": ["arcade","puzzle","card-game","racing"],
    "view": "none",
    "words": ["panel","window","box","menu","flat","modern","pause","results","tooltip","list","popup","card","clean","minimal"],
    "license": "draft"
  },
  "size": [96,64],
  "pivot": [48,32],
  "grounded": false,
  "preview": "panel",
  "styles": ["pixel"],
  "palette": [
    {"id":"face","label":"Face","default":"#3f5068","material":"interface","swatches":["#3f5068","#7a4f33","#434d6d","#8e3a4a"]},
    {"id":"frame","label":"Edge","default":"#f0ead8","material":"interface","swatches":["#f0ead8","#8fd0f0","#9bd18a","#c2c9d6","#f6d3b0"]},
    {"id":"accent","label":"Focus","default":"#4fd8ee","material":"interface","swatches":["#4fd8ee","#e08a2c","#a4c44a","#6aa83e","#5fe0f0"]}
