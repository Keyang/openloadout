{ "format": "loadout-sprite", "version": 2, "id": "shield-cell", "name": "Shield cell",
  "blurb": "A six-sided cell of blue shield energy that turns slowly while a light runs round its rim. Make it a shell, an orb or a ring, with one or two layers, in your colours.",
  "meta": { "type": "pickup", "role": "items/pickup", "themes": ["sci-fi", "space"], "gameTypes": ["roguelike-action", "shooter", "arcade"], "view": "front",
            "words": ["shield", "cell", "energy", "armour", "barrier", "protect", "battery", "power", "hexagon", "orb", "collect", "pickup", "recharge", "blue"], "license": "draft" },
  "size": [32, 32], "pivot": [16, 30], "grounded": false, "preview": "idle", "styles": ["pixel"],
  "palette": [
    { "id": "body", "label": "Casing", "default": "#9aa6c0", "material": "metal", "swatches": ["#9aa6c0", "#c2c9d6", "#6b7896", "#f2c230", "#8f97a8", "#e6c545", "#c98a4a"] },
    { "id": "glow", "label": "Glow", "default": "#4f9ff0", "material": "magic", "swatches": ["#4f9ff0", "#5fe0f0", "#e2473f", "#9fe040", "#f2a030", "#b48af8", "#5fd47a"] },
    { "id": "band", "material": "metal", "derive": { "rule": "mix", "of": { "rule": "ramp", "of": "body", "tone": "light" }, "with": "shine", "amount": 0.3 } },
    { "id": "burst-light", "material": "light", "derive": { "rule": "mix", "of": { "rule": "ramp", "of": "glow", "tone": "light" }, "with": "shine", "amount": 0.35 } },
    { "id": "shine", "default": "#ffffff", "material": "light", "detail": true } ],
  "controls": [
    { "key": "size", "kind": "range", "label": "Size", "lo": "Small", "hi": "Big", "default": 0.5 },
    { "key": "shape", "kind": "choice", "label": "Shape", "options": [{ "value": "hex", "label": "Six sides" }, "orb", "ring"], "default": "hex" },
    { "key": "rings", "kind": "choice", "label": "Layers", "options": ["one", "two"], "default": "one" },
    { "key": "sparkle", "kind": "toggle", "label": "Sparkle", "default": true },
    { "key": "body", "kind": "colour", "label": "Casing" },
    { "key": "glow", "kind": "colour", "label": "Glow" },
    { "key": "bob", "kind": "range", "label": "Float", "lo": "Still", "hi": "Floaty", "default": 0.5, "group": "Motion" },
    { "key": "pop", "kind": "range", "label": "Pop height", "lo": "Low", "hi": "High", "default": 0.5, "group": "Motion" },
    { "key": "speed", "standard": "speed" } ],
  "body": { "pictures": {
    "nodes": [ { "id": "cell", "parent": null, "at": [16, 17] } ],
    "draw": [
      { "id": "cell", "gen": "shield.cell", "v": 1, "on": "cell", "at": [0, 0],
        "shape": { "from": "shape", "pick": { "hex": "hex", "orb": "orb", "ring": "ring" } },
        "size": { "from": "size", "map": [[0, 0], [1, 1]], "round": "none" },
        "layers": { "from": "rings", "pick": { "one": 1, "two": 2 } },
        "casing": "body", "energy": "glow", "band": "band", "shine": "shine" },
      { "kind": "outline", "paint": "ink" },
      { "id": "sparkle-hex", "gen": "gleam", "v": 1, "on": "cell", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["hex"] },
        "at": [ { "from": "size", "map": [[0, 6], [1, 9]], "round": "px" }, { "from": "size", "map": [[0, -6], [1, -9]], "round": "px" } ],
        "peak": 0.56, "paint": "glow.light", "core": "shine" },
      { "id": "sparkle-orb", "gen": "gleam", "v": 1, "on": "cell", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["orb"] },
        "at": [ { "from": "size", "map": [[0, 5], [1, 8]], "round": "px" }, { "from": "size", "map": [[0, -6], [1, -9]], "round": "px" } ],
        "peak": 0.56, "paint": "glow.light", "core": "shine" },
      { "id": "sparkle-ring", "gen": "gleam", "v": 1, "on": "cell", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["ring"] },
        "at": [ { "from": "size", "map": [[0, 6], [1, 9]], "round": "px" }, { "from": "size", "map": [[0, -7], [1, -10]], "round": "px" } ],
        "peak": 0.56, "paint": "glow.light", "core": "shine" } ],
    "motion": [
      { "gen": "pickup.bob", "v": 1, "clip": ["idle"], "height": { "from": "bob", "map": [[0, 0], [1, 2]] } },
      { "gen": "pickup.collect", "v": 1, "node": "cell", "clip": ["collect"], "pop": { "from": "pop", "map": [[0, 0], [1, 1]] },
        "low": { "from": "size", "map": [[0, 2.8], [1, 0.8]] }, "high": { "from": "size", "map": [[0, 6.2], [1, 1.8]] }, "room": { "from": "size", "map": [[0, 6.2], [1, 1.8]] } } ],
    "emitters": [
      { "id": "burst", "gen": "pickup.burst", "v": 1, "on": "cell", "at": [0, 0], "reach": { "from": "size", "map": [[0, 11], [1, 14]] },
        "sparkle": { "from": "sparkle", "pick": { "true": true, "false": false } }, "paint": "glow", "bright": "burst-light", "core": "shine" } ] } },
  "clips": {
    "idle": { "frames": 8, "fps": 10 },
    "collect": { "frames": 8, "fps": 14, "loop": false, "frameEdits": { "4": { "flash": true } },
      "keys": [ { "t": 0, "ease": "hold", "emit": { "burst": { "amount": 0 } } }, { "t": 0.6, "ease": "linear", "emit": { "burst": { "amount": 0 } } },
                { "t": 1, "emit": { "burst": { "amount": 1 } } } ],
      "sounds": [ { "sound": "upgrade-get", "preset": "Shield cell", "frame": 1, "volume": 0.7 } ] } } }
