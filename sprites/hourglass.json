{ "format": "loadout-sprite", "version": 2, "id": "hourglass", "name": "Time bonus",
  "blurb": "A floating hourglass, stopwatch or alarm clock that gives extra time. Change its kind, size, sand left, sparkle and colours.",
  "meta": { "type": "pickup", "role": "items/pickup", "themes": ["neutral"], "gameTypes": ["arcade", "racing", "puzzle", "platformer"], "view": "front",
            "words": ["hourglass", "stopwatch", "clock", "timer", "time", "sand", "extra time", "bonus", "countdown", "collect", "pickup", "hurry"], "license": "draft" },
  "size": [32, 32], "pivot": [16, 30], "grounded": false, "preview": "idle", "styles": ["pixel"],
  "palette": [
    { "id": "body", "label": "Frame", "default": "#a06a3c", "material": "paint", "swatches": ["#a06a3c", "#7a4f33", "#a8612a", "#c98a4a", "#c2c9d6", "#c9423a", "#f2c230"] },
    { "id": "accent", "label": "Sand", "default": "#e6c96a", "material": "earth", "swatches": ["#e6c96a", "#f0ead8", "#4fd8ee", "#a4c44a", "#7a4fc4"] },
    { "id": "sky", "default": "#8fd0f0", "material": "sky", "detail": true },
    { "id": "cavern", "default": "#3f5068", "material": "sky", "detail": true },
    { "id": "glass", "material": "sky", "derive": { "rule": "standOut", "against": "accent", "from": ["sky", { "rule": "mix", "of": "sky", "with": "cavern", "amount": 0.5 }] } },
    { "id": "face", "default": "#f0ead8", "material": "paint", "detail": true },
    { "id": "burst", "material": "paint", "derive": { "rule": "choose", "when": { "shape": ["hourglass"] }, "then": "accent", "else": "body" } },
    { "id": "burst-light", "material": "light", "derive": { "rule": "mix", "of": { "rule": "ramp", "of": "burst", "tone": "light" }, "with": "shine", "amount": 0.35 } },
    { "id": "shine", "default": "#ffffff", "material": "light", "detail": true } ],
  "controls": [
    { "key": "size", "kind": "range", "label": "Size", "lo": "Small", "hi": "Big", "default": 0.5 },
    { "key": "shape", "kind": "choice", "label": "Shape", "options": ["hourglass", "stopwatch", "clock"], "default": "hourglass" },
    { "key": "sand", "kind": "range", "label": "Sand left", "lo": "Little", "hi": "Lots", "default": 0.5, "when": { "shape": ["hourglass"] } },
    { "key": "sparkle", "kind": "toggle", "label": "Sparkle", "default": true },
    { "key": "body", "kind": "colour", "label": "Frame" },
    { "key": "accent", "kind": "colour", "label": "Sand", "when": { "shape": ["hourglass"] } },
    { "key": "bob", "kind": "range", "label": "Float", "lo": "Still", "hi": "Floaty", "default": 0.5, "group": "Motion" },
    { "key": "pop", "kind": "range", "label": "Pop height", "lo": "Low", "hi": "High", "default": 0.5, "group": "Motion" },
    { "key": "speed", "standard": "speed" } ],
  "body": { "pictures": {
    "nodes": [ { "id": "timer", "parent": null, "at": [16, 17] } ],
    "draw": [
      { "id": "piece", "gen": "timepiece", "v": 1, "on": "timer", "at": [0, { "from": "shape", "pick": { "hourglass": 0, "stopwatch": 0, "clock": -1 } }],
        "kind": { "from": "shape", "pick": { "hourglass": "hourglass", "stopwatch": "stopwatch", "clock": "clock" } },
        "scale": { "from": "size", "map": [[0, 0.8], [1, 1.04]], "round": "none" },
        "level": { "from": "sand", "map": [[0, 0], [1, 1]], "round": "none" },
        "frame": "body", "sand": "accent", "glass": "glass", "face": "face", "hand": "ink", "shine": "shine" },
      { "kind": "outline", "paint": "ink" },
      { "id": "sparkle", "gen": "gleam", "v": 1, "on": "timer", "clip": ["idle"], "when": { "sparkle": [true] },
        "at": [ { "from": "size", "map": [[0, 6.4], [1, 8.3]], "round": "none" }, { "from": "size", "map": [[0, -5.8], [1, -8.4]], "round": "none" } ],
        "peak": 0.5, "paint": "shine", "core": "shine" } ],
    "motion": [
      { "gen": "pickup.bob", "v": 1, "clip": ["idle"], "height": { "from": "bob", "map": [[0, 0], [1, 2]] } },
      { "gen": "pickup.collect", "v": 1, "node": "timer", "clip": ["collect"], "pop": { "from": "pop", "map": [[0, 0], [1, 1]] },
        "low": { "from": "size", "map": [[0, 1.9], [1, 0.6]] }, "high": { "from": "size", "map": [[0, 4.2], [1, 1.3]] }, "room": { "from": "size", "map": [[0, 4.2], [1, 1.3]] } } ],
    "emitters": [
      { "id": "burst", "gen": "pickup.burst", "v": 1, "on": "timer", "at": [0, 0], "reach": { "from": "size", "map": [[0, 9.4], [1, 11.3]] },
        "sparkle": { "from": "sparkle", "pick": { "true": true, "false": false } }, "paint": "burst", "bright": "burst-light", "core": "shine" } ] } },
  "clips": {
    "idle": { "frames": 8, "fps": 10 },
    "collect": { "frames": 8, "fps": 14, "loop": false, "frameEdits": { "4": { "flash": true } },
      "keys": [ { "t": 0, "ease": "hold", "emit": { "burst": { "amount": 0 } } }, { "t": 0.6, "ease": "linear", "emit": { "burst": { "amount": 0 } } },
                { "t": 1, "emit": { "burst": { "amount": 1 } } } ],
      "sounds": [ { "sound": "item-get", "preset": "Chiptune", "frame": 1, "volume": 0.7 } ] } },
  "versions": [
    { "name": "Hourglass", "params": {} },
    { "name": "Stopwatch", "params": { "shape": "stopwatch", "body": "#c2c9d6" } },
    { "name": "Alarm clock", "params": { "shape": "clock", "body": "#c9423a" } },
    { "name": "Nearly out", "params": { "sand": 0.1, "body": "#c9423a" } },
    { "name": "Gilded glass", "params": { "body": "#f2c230", "accent": "#4fd8ee" } } ] }
