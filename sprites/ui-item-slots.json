{ "format": "loadout-sprite",
  "version": 2,
  "id": "ui-item-slots",
  "name": "Item slots",
  "blurb": "The boxes that show which tools are in hand, with a lit one, a locked one, a grid cursor and a flash; change the frame style, corners, border, slot marks and colours.",
  "meta": {"type": "ui", "role": "interface/panel", "themes": ["fantasy", "neutral"], "gameTypes": ["top-down-rpg", "turn-based-rpg", "arcade"], "view": "none", "words": ["slot", "item", "tool", "equip", "inventory", "box", "frame", "hud", "select", "cursor", "button", "quick"], "license": "draft"},
  "size": [32,32],
  "pivot": [16,16],
  "grounded": false,
  "preview": "slot",
  "styles": ["pixel", "flat"],
  "palette": [
    {"id": "face", "label": "Slot", "default": "#4a609c", "material": "interface", "swatches": ["#4a609c", "#5a5f7a", "#2f8f9d", "#8e3a4a"]},
    {"id": "slot-face", "material": "interface", "derive": {"rule": "choose", "when": {"face": ["#2f8f9d"]}, "then": {"rule": "shadeTo", "of": "face", "under": "shine", "drop": 0.65, "floor": 0}, "else": "face"}},
    {"id": "frame", "label": "Frame", "default": "#9a6a3e", "material": "interface", "swatches": ["#9a6a3e", "#f2c230", "#c2c9d6", "#a8a4a0", "#f0ead8"]},
    {"id": "accent", "label": "Active light", "default": "#f4e06a", "material": "light", "swatches": ["#f4e06a", "#4fd8ee", "#7fe0a0", "#e8662c"]},
    {"id": "cobble", "default": "#a8a4a0", "material": "interface", "detail": true},
    {"id": "locked", "material": "interface", "derive": {"rule": "mix", "of": "face", "with": "cobble", "amount": 0.5}},
    {"id": "shine", "default": "#ffffff", "material": "light", "detail": true},
    {"id": "flash-near", "material": "interface", "derive": {"rule": "mix", "of": "frame", "with": "shine", "amount": 0.66}},
    {"id": "flash-far", "material": "interface", "derive": {"rule": "mix", "of": "frame", "with": "shine", "amount": 0.33}},
    {"id": "lit-edge", "material": "interface", "derive": {"rule": "mix", "of": "frame.deep", "with": "ink", "amount": 0.85}},
    {"id": "lock-body", "material": "interface", "derive": {"rule": "apart", "of": "frame.dark", "from": [["locked", 0.3]], "least": 0.3}},
    {"id": "lock-key", "material": "interface", "derive": {"rule": "standOut", "against": "lock-body", "from": ["ink", "shine"]}} ],
  "controls": [
    {"key": "style", "kind": "choice", "label": "Style", "options": ["plank", "stone", "plain"], "default": "plank"},
    {"key": "corner", "kind": "range", "label": "Corner", "lo": "Square", "hi": "Round", "default": 0.5},
    {"key": "border", "kind": "range", "label": "Border", "lo": "Thin", "hi": "Thick", "default": 0.5},
    {"key": "pips", "kind": "toggle", "label": "Slot marks", "default": true},
    {"key": "face", "kind": "colour", "label": "Slot"},
    {"key": "frame", "kind": "colour", "label": "Frame"},
    {"key": "accent", "kind": "colour", "label": "Active light"},
    {"key": "speed", "standard": "speed"} ],
