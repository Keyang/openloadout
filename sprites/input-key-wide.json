    {"gen": "key.wide", "v": 1, "at": [32,16], "clip": ["tap"], "picture": "tap", "shape": {"from": "shape", "pick": {"wide": "wide", "long": "long"}}, "mark": {"from": "mark", "pick": {"none": "none", "enter": "enter", "back": "back", "tab": "tab", "shift": "shift"}}, "size": {"from": "size", "map": [[0,0], [1,1]], "round": "none"}, "corner": {"from": "corner", "map": [[0,0], [1,1]], "round": "none"}, "depth": {"from": "depth", "map": [[0,0], [1,1]], "round": "none"}, "lights": {"from": "light", "pick": {"true": true, "false": false}}, "body": "body", "frame": "frame", "lit": "glow"} ] } },
