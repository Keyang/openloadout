  {"key": "body", "kind": "colour", "label": "Key top"},
  {"key": "frame", "kind": "colour", "label": "Key side"},
  {"key": "glow", "kind": "colour", "label": "Light", "when": {"light": [true]}},
  {"key": "speed", "standard": "speed"} ],
  "body": { "panel": {
