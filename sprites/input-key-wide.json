{ "format": "loadout-sprite",
  "version": 2,
  "id": "input-key-wide",
  "name": "Wide keyboard key",
  "blurb": "A wide keyboard key or a space bar for \"press this\" prompts that sinks and lights up when tapped; change its shape, picture (return, back, tab, shift), length, corners, depth and colours.",
  "meta": {"type": "ui", "role": "interface/icon", "themes": ["neutral"], "gameTypes": ["arcade", "platformer", "puzzle", "shooter"], "view": "none", "words": ["key", "keyboard", "space bar", "enter", "return", "shift", "tab", "backspace", "press", "tap", "prompt", "input"], "license": "draft"},
  "size": [64,32],
  "pivot": [32,16],
  "grounded": false,
  "preview": "tap",
  "styles": ["pixel"],
  "palette": [
  {"id": "body", "label": "Key top", "default": "#f0ead8", "material": "paint", "swatches": ["#f0ead8", "#c2c9d6", "#f6d3b0", "#9bd18a", "#e6c96a"]},
  {"id": "frame", "label": "Key side", "default": "#5d6475", "material": "interface", "swatches": ["#5d6475", "#7a4f33", "#3f5068", "#7a4fc4", "#434d6d"]},
  {"id": "glow", "label": "Light", "default": "#f2c230", "material": "interface", "swatches": ["#f2c230", "#4fd8ee", "#a4c44a", "#8fd0f0"]} ],
  "controls": [
