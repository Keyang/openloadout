{ "format": "loadout-sprite", "version": 2, "id": "keycard", "name": "Keycard",
  "blurb": "A security card held at a slant, with a coloured stripe and a blinking light: it opens a locked door. Make it a card, a data chip or a fob, and change its stripes and colours.",
  "meta": { "type": "pickup", "role": "items/key", "themes": ["sci-fi", "space"], "gameTypes": ["roguelike-action", "shooter", "arcade", "puzzle"], "view": "front",
            "words": ["keycard", "key", "card", "access", "pass", "security", "unlock", "open", "door", "chip", "fob", "collect", "pickup", "clearance"], "license": "draft" },
  "size": [32, 32], "pivot": [16, 30], "grounded": false, "preview": "idle", "styles": ["pixel"],
  "palette": [
    { "id": "body", "label": "Card", "default": "#9aa6c0", "material": "paint", "swatches": ["#9aa6c0", "#c2c9d6", "#6b7896", "#f2c230", "#8f97a8", "#e6c545", "#c98a4a"] },
    { "id": "accent", "label": "Stripe", "default": "#e2473f", "material": "signal", "swatches": ["#e2473f", "#f2a030", "#2fb3a8", "#3f6fd1", "#5fe0f0", "#9fe040"] },
    { "id": "glow", "label": "Light", "default": "#5fe0f0", "material": "light", "swatches": ["#5fe0f0", "#e2473f", "#9fe040", "#f2a030", "#b48af8", "#4f9ff0", "#5fd47a"] },
    { "id": "steel", "default": "#c2c9d6", "material": "metal", "detail": true },
    { "id": "plate", "default": "#434d6d", "material": "metal", "detail": true },
    { "id": "glint", "material": "light", "derive": { "rule": "mix", "of": { "rule": "ramp", "of": "accent", "tone": "light" }, "with": "shine", "amount": 0.6 } },
    { "id": "burst-light", "material": "light", "derive": { "rule": "mix", "of": { "rule": "ramp", "of": "accent", "tone": "light" }, "with": "shine", "amount": 0.35 } },
    { "id": "shine", "default": "#ffffff", "material": "light", "detail": true } ],
  "controls": [
    { "key": "size", "kind": "range", "label": "Size", "lo": "Small", "hi": "Big", "default": 0.5 },
    { "key": "shape", "kind": "choice", "label": "Shape", "options": ["card", "chip", "fob"], "default": "card" },
    { "key": "stripes", "kind": "choice", "label": "Stripes", "options": ["one", "two", "chevron"], "default": "one" },
    { "key": "sparkle", "kind": "toggle", "label": "Sparkle", "default": true },
    { "key": "body", "kind": "colour", "label": "Card" },
    { "key": "accent", "kind": "colour", "label": "Stripe" },
    { "key": "glow", "kind": "colour", "label": "Light" },
    { "key": "bob", "kind": "range", "label": "Float", "lo": "Still", "hi": "Floaty", "default": 0.5, "group": "Motion" },
    { "key": "pop", "kind": "range", "label": "Pop height", "lo": "Low", "hi": "High", "default": 0.5, "group": "Motion" },
    { "key": "speed", "standard": "speed" } ],
  "body": { "pictures": {
    "nodes": [ { "id": "card", "parent": null, "at": [16, 16] } ],
    "draw": [
      { "id": "keycard", "gen": "keycard", "v": 1, "on": "card", "at": [0, 0],
        "shape": { "from": "shape", "pick": { "card": "card", "chip": "chip", "fob": "fob" } },
        "stripes": { "from": "stripes", "pick": { "one": "one", "two": "two", "chevron": "chevron" } },
        "height": { "from": "size", "map": [[0, 16], [0.2499, 16], [0.25, 18], [0.7499, 18], [0.75, 20], [1, 20]], "round": "px" },
        "card": "body", "stripe": "accent", "lamp": "glow", "pins": "steel", "bezel": "plate", "glint": "glint", "shine": "shine" },
      { "kind": "outline", "paint": "ink" },
      { "id": "sparkle-card", "gen": "gleam", "v": 1, "on": "card", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["card"] },
        "at": [ { "from": "size", "map": [[0, 5], [0.2499, 5], [0.25, 6], [0.7499, 6], [0.75, 8], [1, 8]], "round": "px" },
                { "from": "size", "map": [[0, -7], [0.2499, -7], [0.25, -8], [0.7499, -8], [0.75, -9], [1, -9]], "round": "px" } ],
        "peak": 0.8, "paint": "body.light", "core": "shine" },
      { "id": "sparkle-chip", "gen": "gleam", "v": 1, "on": "card", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["chip"] },
        "at": [ { "from": "size", "map": [[0, 6], [0.2499, 6], [0.25, 7], [0.7499, 7], [0.75, 8], [1, 8]], "round": "px" },
                { "from": "size", "map": [[0, -7], [0.2499, -7], [0.25, -8], [0.7499, -8], [0.75, -9], [1, -9]], "round": "px" } ],
        "peak": 0.8, "paint": "body.light", "core": "shine" },
      { "id": "sparkle-fob", "gen": "gleam", "v": 1, "on": "card", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["fob"] },
        "at": [ { "from": "size", "map": [[0, 5], [0.7499, 5], [0.75, 6], [1, 6]], "round": "px" },
                { "from": "size", "map": [[0, -7], [0.2499, -7], [0.25, -8], [0.7499, -8], [0.75, -9], [1, -9]], "round": "px" } ],
        "peak": 0.8, "paint": "body.light", "core": "shine" } ],
    "motion": [
      { "gen": "pickup.bob", "v": 1, "clip": ["idle"], "height": { "from": "bob", "map": [[0, 0], [1, 2]] } },
      { "gen": "pickup.collect", "v": 1, "node": "card", "clip": ["collect"], "pop": { "from": "pop", "map": [[0, 0], [1, 1]] },
        "low": { "from": "size", "map": [[0, 1.8], [1, 0.9]] }, "high": { "from": "size", "map": [[0, 4.1], [1, 1.9]] }, "room": { "from": "size", "map": [[0, 4.1], [1, 1.9]] } } ],
    "emitters": [
      { "id": "burst", "gen": "pickup.burst", "v": 1, "on": "card", "at": [0, 0], "reach": { "from": "size", "map": [[0, 11], [1, 13]] },
        "sparkle": { "from": "sparkle", "pick": { "true": true, "false": false } }, "paint": "accent", "bright": "burst-light", "core": "shine" } ] } },
  "clips": {
    "idle": { "frames": 8, "fps": 10 },
    "collect": { "frames": 8, "fps": 14, "loop": false, "frameEdits": { "4": { "flash": true } },
      "keys": [ { "t": 0, "ease": "hold", "emit": { "burst": { "amount": 0 } } }, { "t": 0.6, "ease": "linear", "emit": { "burst": { "amount": 0 } } },
                { "t": 1, "emit": { "burst": { "amount": 1 } } } ],
      "sounds": [ { "sound": "credit-pickup", "preset": "Keycard", "frame": 1, "volume": 0.7 } ] } } }
