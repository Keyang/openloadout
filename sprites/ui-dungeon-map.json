{ "format": "loadout-sprite", "version": 2, "id": "ui-dungeon-map", "name": "Dungeon map marks",
  "blurb": "The marks a dungeon map is drawn from: rooms, doorways, locked doors, boss, chest and stairs marks, floor pips and a blinking you-are-here square. Change the room corners, line weight, mark size, shine and colours.",
  "meta": { "type": "ui", "role": "interface/icon", "themes": ["fantasy", "neutral"], "gameTypes": ["top-down-rpg", "turn-based-rpg", "roguelike-action"], "view": "none",
            "words": ["map", "minimap", "room", "dungeon", "door", "locked", "boss", "stairs", "floor", "compass", "marker", "explore"], "license": "draft" },
  "size": [16, 16], "pivot": [8, 8], "grounded": false, "preview": "room-seen", "styles": ["pixel"],
  "versions": [
    { "name": "Parchment map", "params": {} },
    { "name": "Bold slate lines, flat", "params": { "bold": true, "shine": false, "frame": "#5a5f7a", "face": "#f0ead8" } },
    { "name": "Rounded, big blue marks", "params": { "style": "rounded", "size": 1, "face": "#a8c8d8", "accent": "#3f6fd1", "glow": "#7fe0a0" } },
    { "name": "Cut corners on sand", "params": { "style": "cut", "face": "#c9a06a", "frame": "#8e3a4a", "glow": "#f4e06a" } } ],
  "palette": [
    { "id": "face", "label": "Visited room", "default": "#e6c96a", "material": "interface", "swatches": ["#e6c96a", "#f0ead8", "#c9a06a", "#a8c8d8"] },
    { "id": "frame", "label": "Lines", "default": "#9a6a3e", "material": "interface", "swatches": ["#9a6a3e", "#5a5f7a", "#8e3a4a", "#357a4c"] },
    { "id": "accent", "label": "Marks", "default": "#c9423a", "material": "signal", "swatches": ["#c9423a", "#3f6fd1", "#7a4fc4", "#2f8f9d"] },
    { "id": "glow", "label": "Here", "default": "#4fd8ee", "material": "light", "swatches": ["#4fd8ee", "#7fe0a0", "#f4e06a", "#e8662c"] },
    { "id": "spark", "default": "#ffffff", "material": "light", "detail": true } ],
  "controls": [
    { "key": "size", "kind": "range", "label": "Size", "lo": "Small", "hi": "Big", "default": 0.5 },
    { "key": "shine", "kind": "toggle", "label": "Shine", "default": true },
    { "key": "style", "kind": "choice", "label": "Rooms", "options": ["square", "rounded", "cut"], "default": "square" },
    { "key": "bold", "kind": "toggle", "label": "Bold lines", "default": false },
    { "key": "face", "kind": "colour", "label": "Visited room" },
    { "key": "frame", "kind": "colour", "label": "Lines" },
    { "key": "accent", "kind": "colour", "label": "Marks" },
    { "key": "glow", "kind": "colour", "label": "Here" },
    { "key": "speed", "standard": "speed" } ],
  "body": { "pictures": {
    "nodes": [ { "id": "map", "parent": null, "at": [0, 0] } ],
    "draw": [
      { "id": "fill-square", "kind": "rect", "shade": 0, "on": "map", "at": [2, 2], "size": [12, 12], "paint": "face", "when": { "clip": ["room-seen", "room-boss", "room-chest", "room-stairs"], "style": ["square"] } },
      { "id": "fill-round-a", "kind": "rect", "shade": 0, "on": "map", "at": [3, 2], "size": [10, 12], "paint": "face", "when": { "clip": ["room-seen", "room-boss", "room-chest", "room-stairs"], "style": ["rounded"] } },
      { "id": "fill-round-b", "kind": "rect", "shade": 0, "on": "map", "at": [2, 3], "size": [12, 10], "paint": "face", "when": { "clip": ["room-seen", "room-boss", "room-chest", "room-stairs"], "style": ["rounded"] } },
      { "id": "fill-cut-a", "kind": "rect", "shade": 0, "on": "map", "at": [4, 2], "size": [8, 12], "paint": "face", "when": { "clip": ["room-seen", "room-boss", "room-chest", "room-stairs"], "style": ["cut"] } },
      { "id": "fill-cut-b", "kind": "rect", "shade": 0, "on": "map", "at": [3, 3], "size": [10, 10], "paint": "face", "when": { "clip": ["room-seen", "room-boss", "room-chest", "room-stairs"], "style": ["cut"] } },
      { "id": "fill-cut-c", "kind": "rect", "shade": 0, "on": "map", "at": [2, 4], "size": [12, 8], "paint": "face", "when": { "clip": ["room-seen", "room-boss", "room-chest", "room-stairs"], "style": ["cut"] } },

      { "id": "wall-square", "kind": "stamp", "on": "map", "at": [2, 2], "anchor": "tl", "key": { "a": "frame" }, "when": { "clip": ["room", "room-seen", "room-boss", "room-chest", "room-stairs"], "style": ["square"], "bold": [false] },
        "rows": ["aaaaaaaaaaaa", "a..........a", "a..........a", "a..........a", "a..........a", "a..........a", "a..........a", "a..........a", "a..........a", "a..........a", "a..........a", "aaaaaaaaaaaa"] },
      { "id": "wall-square-bold", "kind": "stamp", "on": "map", "at": [2, 2], "anchor": "tl", "key": { "a": "frame" }, "when": { "clip": ["room", "room-seen", "room-boss", "room-chest", "room-stairs"], "style": ["square"], "bold": [true] },
        "rows": ["aaaaaaaaaaaa", "aaaaaaaaaaaa", "aa........aa", "aa........aa", "aa........aa", "aa........aa", "aa........aa", "aa........aa", "aa........aa", "aa........aa", "aaaaaaaaaaaa", "aaaaaaaaaaaa"] },
      { "id": "wall-round", "kind": "stamp", "on": "map", "at": [2, 2], "anchor": "tl", "key": { "a": "frame" }, "when": { "clip": ["room", "room-seen", "room-boss", "room-chest", "room-stairs"], "style": ["rounded"], "bold": [false] },
        "rows": [".aaaaaaaaaa.", "a..........a", "a..........a", "a..........a", "a..........a", "a..........a", "a..........a", "a..........a", "a..........a", "a..........a", "a..........a", ".aaaaaaaaaa."] },
      { "id": "wall-round-bold", "kind": "stamp", "on": "map", "at": [2, 2], "anchor": "tl", "key": { "a": "frame" }, "when": { "clip": ["room", "room-seen", "room-boss", "room-chest", "room-stairs"], "style": ["rounded"], "bold": [true] },
        "rows": [".aaaaaaaaaa.", "aaaaaaaaaaaa", "aa........aa", "aa........aa", "aa........aa", "aa........aa", "aa........aa", "aa........aa", "aa........aa", "aa........aa", "aaaaaaaaaaaa", ".aaaaaaaaaa."] },
      { "id": "wall-cut", "kind": "stamp", "on": "map", "at": [2, 2], "anchor": "tl", "key": { "a": "frame" }, "when": { "clip": ["room", "room-seen", "room-boss", "room-chest", "room-stairs"], "style": ["cut"], "bold": [false] },
        "rows": ["..aaaaaaaa..", ".a........a.", "a..........a", "a..........a", "a..........a", "a..........a", "a..........a", "a..........a", "a..........a", "a..........a", ".a........a.", "..aaaaaaaa.."] },
      { "id": "wall-cut-bold", "kind": "stamp", "on": "map", "at": [2, 2], "anchor": "tl", "key": { "a": "frame" }, "when": { "clip": ["room", "room-seen", "room-boss", "room-chest", "room-stairs"], "style": ["cut"], "bold": [true] },
        "rows": ["..aaaaaaaa..", ".aaaaaaaaaa.", "aaa......aaa", "aa........aa", "aa........aa", "aa........aa", "aa........aa", "aa........aa", "aa........aa", "aaa......aaa", ".aaaaaaaaaa.", "..aaaaaaaa.."] },

      { "id": "room-shine", "kind": "stamp", "on": "map", "at": [3, 3], "anchor": "tl", "key": { "a": "face.light" }, "rows": ["aaa", "a..", "a.."], "when": { "clip": ["room-seen", "room-boss", "room-chest", "room-stairs"], "shine": [true], "style": ["square", "rounded"], "bold": [false] } },
      { "id": "room-shine-bold", "kind": "stamp", "on": "map", "at": [4, 4], "anchor": "tl", "key": { "a": "face.light" }, "rows": ["aaa", "a..", "a.."], "when": { "clip": ["room-seen", "room-boss", "room-chest", "room-stairs"], "shine": [true], "style": ["square", "rounded"], "bold": [true] } },
      { "id": "room-shine-cut", "kind": "stamp", "on": "map", "at": [3, 3], "anchor": "tl", "key": { "a": "face.light" }, "rows": [".aaa", "a...", "a...", "a..."], "when": { "clip": ["room-seen", "room-boss", "room-chest", "room-stairs"], "shine": [true], "style": ["cut"], "bold": [false] } },
      { "id": "room-shine-cut-bold", "kind": "stamp", "on": "map", "at": [4, 4], "anchor": "tl", "key": { "a": "face.light" }, "rows": [".aaa", "a...", "a...", "a..."], "when": { "clip": ["room-seen", "room-boss", "room-chest", "room-stairs"], "shine": [true], "style": ["cut"], "bold": [true] } },

      { "id": "door-face", "kind": "rect", "shade": 0, "on": "map", "at": [6, 6], "size": [4, 4], "paint": "face", "when": { "clip": ["door-h", "door-v", "door-locked-h", "door-locked-v"] } },
      { "id": "door-h-top", "kind": "rect", "shade": 0, "on": "map", "at": [6, 5], "size": [4, 1], "paint": "frame", "when": { "clip": ["door-h", "door-locked-h"] } },
      { "id": "door-h-foot", "kind": "rect", "shade": 0, "on": "map", "at": [6, 10], "size": [4, 1], "paint": "frame", "when": { "clip": ["door-h", "door-locked-h"] } },
      { "id": "door-h-top-bold", "kind": "rect", "shade": 0, "on": "map", "at": [6, 4], "size": [4, 1], "paint": "frame", "when": { "clip": ["door-h", "door-locked-h"], "bold": [true] } },
      { "id": "door-h-foot-bold", "kind": "rect", "shade": 0, "on": "map", "at": [6, 11], "size": [4, 1], "paint": "frame", "when": { "clip": ["door-h", "door-locked-h"], "bold": [true] } },
      { "id": "door-v-left", "kind": "rect", "shade": 0, "on": "map", "at": [5, 6], "size": [1, 4], "paint": "frame", "when": { "clip": ["door-v", "door-locked-v"] } },
      { "id": "door-v-right", "kind": "rect", "shade": 0, "on": "map", "at": [10, 6], "size": [1, 4], "paint": "frame", "when": { "clip": ["door-v", "door-locked-v"] } },
      { "id": "door-v-left-bold", "kind": "rect", "shade": 0, "on": "map", "at": [4, 6], "size": [1, 4], "paint": "frame", "when": { "clip": ["door-v", "door-locked-v"], "bold": [true] } },
      { "id": "door-v-right-bold", "kind": "rect", "shade": 0, "on": "map", "at": [11, 6], "size": [1, 4], "paint": "frame", "when": { "clip": ["door-v", "door-locked-v"], "bold": [true] } },

      { "id": "pip-wall-square", "kind": "stamp", "on": "map", "at": [3, 6], "anchor": "tl", "key": { "a": "frame" }, "rows": ["aaaaaaaaaa", "a........a", "a........a", "aaaaaaaaaa"], "when": { "clip": ["floor-pip", "floor-pip-here"], "style": ["square"], "bold": [false] } },
      { "id": "pip-wall-square-bold", "kind": "stamp", "on": "map", "at": [3, 6], "anchor": "tl", "key": { "a": "frame" }, "rows": ["aaaaaaaaaa", "aa......aa", "aa......aa", "aaaaaaaaaa"], "when": { "clip": ["floor-pip", "floor-pip-here"], "style": ["square"], "bold": [true] } },
      { "id": "pip-wall-round", "kind": "stamp", "on": "map", "at": [3, 6], "anchor": "tl", "key": { "a": "frame" }, "rows": [".aaaaaaaa.", "a........a", "a........a", ".aaaaaaaa."], "when": { "clip": ["floor-pip", "floor-pip-here"], "style": ["rounded"], "bold": [false] } },
      { "id": "pip-wall-round-bold", "kind": "stamp", "on": "map", "at": [3, 6], "anchor": "tl", "key": { "a": "frame" }, "rows": [".aaaaaaaa.", "aa......aa", "aa......aa", ".aaaaaaaa."], "when": { "clip": ["floor-pip", "floor-pip-here"], "style": ["rounded"], "bold": [true] } },
      { "id": "pip-wall-cut", "kind": "stamp", "on": "map", "at": [3, 6], "anchor": "tl", "key": { "a": "frame" }, "rows": ["..aaaaaa..", "aa......aa", "aa......aa", "..aaaaaa.."], "when": { "clip": ["floor-pip", "floor-pip-here"], "style": ["cut"], "bold": [false] } },
      { "id": "pip-wall-cut-bold", "kind": "stamp", "on": "map", "at": [3, 6], "anchor": "tl", "key": { "a": "frame" }, "rows": ["..aaaaaa..", "aaa....aaa", "aaa....aaa", "..aaaaaa.."], "when": { "clip": ["floor-pip", "floor-pip-here"], "style": ["cut"], "bold": [true] } } ],
    "per": {
      "room-boss": { "draw": [
        { "id": "skull-small", "kind": "stamp", "on": "map", "at": [6, 6], "anchor": "tl", "key": { "a": "accent" }, "rows": ["a...a", "aaaaa", "a.a.a", "aaaaa", ".a.a."], "when": { "size": [{ "below": 0.25 }] } },
        { "id": "skull", "kind": "stamp", "on": "map", "at": [5, 5], "anchor": "tl", "key": { "a": "accent" }, "rows": ["a....a", "aaaaaa", "a.aa.a", "aaaaaa", ".aaaa.", ".a..a."], "when": { "size": [{ "atLeast": 0.25, "below": 0.75 }] } },
        { "id": "skull-big", "kind": "stamp", "on": "map", "at": [5, 5], "anchor": "tl", "key": { "a": "accent" }, "rows": ["a.....a", "a.....a", "aaaaaaa", "a..a..a", "aaaaaaa", ".aaaaa.", ".a.a.a."], "when": { "size": [{ "atLeast": 0.75 }] } } ] },
      "room-chest": { "draw": [
        { "id": "chest-small", "kind": "stamp", "on": "map", "at": [6, 6], "anchor": "tl", "key": { "a": "accent" }, "rows": [".aaa.", "aaaaa", "aa.aa", "aaaaa"], "when": { "size": [{ "below": 0.25 }] } },
        { "id": "chest", "kind": "stamp", "on": "map", "at": [5, 6], "anchor": "tl", "key": { "a": "accent" }, "rows": [".aaaa.", "aaaaaa", "aa..aa", "aaaaaa", "aaaaaa"], "when": { "size": [{ "atLeast": 0.25, "below": 0.75 }] } },
        { "id": "chest-big", "kind": "stamp", "on": "map", "at": [5, 5], "anchor": "tl", "key": { "a": "accent" }, "rows": [".aaaaa.", "aaaaaaa", "aaaaaaa", "aaa.aaa", "aaaaaaa", "aaaaaaa"], "when": { "size": [{ "atLeast": 0.75 }] } } ] },
      "room-stairs": { "draw": [
        { "id": "steps", "kind": "stamp", "on": "map", "at": [5, 5], "anchor": "tl", "key": { "a": "frame" }, "rows": ["aaaaaa", "......", ".aaaaa", "......", ".aaaa.", "......", "..aaa."] } ] },
      "door-locked-h": { "draw": [
        { "id": "bar-h", "kind": "rect", "shade": 0, "on": "map", "at": [7, 6], "size": [2, 4], "paint": "frame" },
        { "id": "keyhole-h", "kind": "rect", "shade": 0, "on": "map", "at": [7, 7], "size": [2, 2], "paint": "accent" } ] },
      "door-locked-v": { "draw": [
        { "id": "bar-v", "kind": "rect", "shade": 0, "on": "map", "at": [6, 7], "size": [4, 2], "paint": "frame" },
        { "id": "keyhole-v", "kind": "rect", "shade": 0, "on": "map", "at": [7, 7], "size": [2, 2], "paint": "accent" } ] },
      "mark-treasure": { "draw": [
        { "id": "gem-small", "kind": "stamp", "on": "map", "at": [6, 6], "anchor": "tl", "key": { "a": "accent" }, "rows": [".aa.", "aaaa", "aaaa", ".aa."], "when": { "size": [{ "below": 0.25 }] } },
        { "id": "gem", "kind": "stamp", "on": "map", "at": [6, 6], "anchor": "tl", "key": { "a": "accent" }, "rows": ["..a..", ".aaa.", "aaaaa", ".aaa.", "..a.."], "when": { "size": [{ "atLeast": 0.25, "below": 0.75 }] } },
        { "id": "gem-big", "kind": "stamp", "on": "map", "at": [5, 5], "anchor": "tl", "key": { "a": "accent" }, "rows": ["..aa..", ".aaaa.", "aaaaaa", "aaaaaa", ".aaaa.", "..aa.."], "when": { "size": [{ "atLeast": 0.75 }] } },
        { "kind": "outline", "paint": "ink" },
        { "id": "gem-shine", "kind": "stamp", "on": "map", "at": [8, 7], "anchor": "tl", "key": { "a": "accent.light" }, "rows": ["a"], "when": { "shine": [true] } } ] },
      "floor-pip-here": { "draw": [
        { "id": "pip-fill", "kind": "rect", "shade": 0, "on": "map", "at": [4, 7], "size": [8, 2], "paint": "glow", "z": -1 } ] },
      "here": { "draw": [
        { "id": "here-small", "kind": "rect", "shade": 0, "on": "map", "at": [7, 7], "size": [3, 3], "paint": "glow", "when": { "size": [{ "below": 0.25 }] } },
        { "id": "here-mid", "kind": "rect", "shade": 0, "on": "map", "at": [6, 6], "size": [4, 4], "paint": "glow", "when": { "size": [{ "atLeast": 0.25, "below": 0.75 }] } },
        { "id": "here-big", "kind": "rect", "shade": 0, "on": "map", "at": [6, 6], "size": [5, 5], "paint": "glow", "when": { "size": [{ "atLeast": 0.75 }] } },
        { "id": "swell-small", "kind": "rect", "shade": 0, "on": "map", "at": [6, 6], "size": [5, 5], "paint": "glow", "hidden": true, "when": { "size": [{ "below": 0.25 }] } },
        { "id": "swell-mid", "kind": "rect", "shade": 0, "on": "map", "at": [5, 5], "size": [6, 6], "paint": "glow", "hidden": true, "when": { "size": [{ "atLeast": 0.25, "below": 0.75 }] } },
        { "id": "swell-big", "kind": "rect", "shade": 0, "on": "map", "at": [5, 5], "size": [7, 7], "paint": "glow", "hidden": true, "when": { "size": [{ "atLeast": 0.75 }] } },
        { "kind": "outline", "paint": "ink" },
        { "id": "heart-small", "kind": "rect", "shade": 0, "on": "map", "at": [7, 7], "size": [3, 3], "paint": "spark", "hidden": true, "when": { "size": [{ "below": 0.25 }] } },
        { "id": "heart-mid", "kind": "rect", "shade": 0, "on": "map", "at": [7, 7], "size": [2, 2], "paint": "spark", "hidden": true, "when": { "size": [{ "atLeast": 0.25, "below": 0.75 }] } },
        { "id": "heart-big", "kind": "rect", "shade": 0, "on": "map", "at": [7, 7], "size": [3, 3], "paint": "spark", "hidden": true, "when": { "size": [{ "atLeast": 0.75 }] } } ] } } } },
  "clips": {
    "room": { "frames": 1, "fps": 1, "label": "Room not visited yet", "noText": true },
    "room-seen": { "frames": 1, "fps": 1, "label": "Room already visited", "noText": true },
    "room-boss": { "frames": 1, "fps": 1, "label": "Boss room", "noText": true },
    "room-chest": { "frames": 1, "fps": 1, "label": "Room with a chest", "noText": true },
    "room-stairs": { "frames": 1, "fps": 1, "label": "Room with stairs", "noText": true },
    "door-h": { "frames": 1, "fps": 1, "label": "Doorway to the room beside", "noText": true },
    "door-v": { "frames": 1, "fps": 1, "label": "Doorway to the room above or below", "noText": true },
    "door-locked-h": { "frames": 1, "fps": 1, "label": "Locked door to the room beside", "noText": true },
    "door-locked-v": { "frames": 1, "fps": 1, "label": "Locked door to the room above or below", "noText": true },
    "mark-treasure": { "frames": 1, "fps": 1, "label": "Treasure the compass shows", "noText": true },
    "floor-pip": { "frames": 1, "fps": 1, "label": "A floor of the dungeon", "noText": true },
    "floor-pip-here": { "frames": 1, "fps": 1, "label": "The floor you are on", "noText": true },
    "here": { "frames": 8, "fps": 8, "label": "You are here", "noText": true,
      "frameEdits": { "2": { "show": ["swell-small", "swell-mid", "swell-big"] },
                      "3": { "show": ["swell-small", "swell-mid", "swell-big", "heart-small", "heart-mid", "heart-big"] } } } } }
