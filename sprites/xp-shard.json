{ "format": "loadout-sprite", "version": 2, "id": "xp-shard", "name": "XP shard",
  "blurb": "A tiny glowing shard of experience, made to be dropped by the hundred: it floats, streaks towards the player and pops. Change its shape, size and colours.",
  "meta": { "type": "pickup", "role": "items/pickup", "themes": ["sci-fi", "space"], "gameTypes": ["roguelike-action", "shooter", "arcade"], "view": "front",
            "words": ["xp", "experience", "shard", "crystal", "orb", "exp", "level up", "points", "collect", "pickup", "attract", "magnet", "tiny", "glowing"], "license": "draft" },
  "size": [16, 16], "pivot": [8, 8], "grounded": false, "preview": "idle", "styles": ["pixel"],
  "palette": [
    { "id": "body", "label": "Shard", "default": "#b48af8", "material": "signal", "swatches": ["#b48af8", "#5fe0f0", "#f2c230", "#9fe040", "#e2473f"] },
    { "id": "glow", "label": "Heart", "default": "#f0ead8", "material": "light", "swatches": ["#f0ead8", "#e8ecf2", "#f6d3b0", "#c2c9d6"] },
    { "id": "burst-light", "material": "light", "derive": { "rule": "mix", "of": { "rule": "ramp", "of": "body", "tone": "light" }, "with": "shine", "amount": 0.35 } },
    { "id": "shine", "default": "#ffffff", "material": "light", "detail": true } ],
  "controls": [
    { "key": "size", "kind": "range", "label": "Size", "lo": "Small", "hi": "Big", "default": 0.5 },
    { "key": "shape", "kind": "choice", "label": "Shape", "options": ["shard", "orb", "star", "cube"], "default": "shard" },
    { "key": "sparkle", "kind": "toggle", "label": "Sparkle", "default": true },
    { "key": "body", "kind": "colour", "label": "Shard" },
    { "key": "glow", "kind": "colour", "label": "Heart" },
    { "key": "bob", "kind": "range", "label": "Float", "lo": "Still", "hi": "Floaty", "default": 0.5, "group": "Motion" },
    { "key": "speed", "standard": "speed" } ],
  "body": { "pictures": {
    "nodes": [ { "id": "shard", "parent": null, "at": [8, 8] } ],
    "draw": [
      { "id": "float", "gen": "xp.shard", "v": 1, "on": "shard", "at": [0, 0], "clip": ["idle", "collect"],
        "shape": { "from": "shape", "pick": { "shard": "shard", "orb": "orb", "star": "star", "cube": "cube" } },
        "length": { "from": "size", "map": [[0, 8], [1, 10]], "round": "px" },
        "body": "body", "heart": "glow" },
      { "id": "pulled", "gen": "xp.shard", "v": 1, "on": "shard", "at": [0, 0], "clip": ["attract"], "layer": "pulled",
        "shape": { "from": "shape", "pick": { "shard": "shard", "orb": "orb", "star": "star", "cube": "cube" } },
        "length": { "from": "size", "map": [[0, 8], [1, 10]], "round": "px" },
        "body": "body", "heart": "glow" },
      { "kind": "outline", "paint": "ink" },
      { "id": "streaks", "gen": "xp.shard", "v": 1, "on": "shard", "at": [0, 0], "clip": ["attract"], "layer": "streaks",
        "shape": { "from": "shape", "pick": { "shard": "shard", "orb": "orb", "star": "star", "cube": "cube" } },
        "length": { "from": "size", "map": [[0, 8], [1, 10]], "round": "px" },
        "body": "body", "heart": "glow" },
      { "id": "sparkle-shard", "gen": "gleam", "v": 1, "on": "shard", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["shard"] },
        "at": [ { "from": "size", "map": [[0, 2], [0.7499, 2], [0.75, 3], [1, 3]], "round": "px" }, { "from": "size", "map": [[0, -3], [0.7499, -3], [0.75, -4], [1, -4]], "round": "px" } ],
        "peak": 0.75, "big": 1, "paint": "glow", "core": "shine" },
      { "id": "sparkle-round", "gen": "gleam", "v": 1, "on": "shard", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["orb", "star", "cube"] },
        "at": [ { "from": "size", "map": [[0, 3], [0.2499, 3], [0.25, 4], [1, 4]], "round": "px" }, { "from": "size", "map": [[0, -3], [0.7499, -3], [0.75, -4], [1, -4]], "round": "px" } ],
        "peak": 0.75, "big": 1, "paint": "glow", "core": "shine" } ],
    "motion": [
      { "gen": "pickup.bob", "v": 1, "clip": ["idle"], "height": { "from": "bob", "map": [[0, 0], [0.5, 1], [1, 1.49]] } },
      { "gen": "pickup.collect", "v": 1, "node": "shard", "clip": ["collect"], "when": { "shape": ["cube"] }, "pop": 0.5,
        "low": { "from": "size", "map": [[0, 0.45], [0.2499, 0.45], [0.25, 0], [1, 0]] }, "high": { "from": "size", "map": [[0, 1], [0.2499, 1], [0.25, 0], [1, 0]] },
        "room": { "from": "size", "map": [[0, 1], [0.2499, 1], [0.25, 0], [1, 0]] } },
      { "gen": "pickup.collect", "v": 1, "node": "shard", "clip": ["collect"], "when": { "shape": ["shard", "orb", "star"] }, "pop": 0.5,
        "low": { "from": "size", "map": [[0, 0.45], [0.7499, 0.45], [0.75, 0], [1, 0]] }, "high": { "from": "size", "map": [[0, 1], [0.7499, 1], [0.75, 0], [1, 0]] },
        "room": { "from": "size", "map": [[0, 1], [0.7499, 1], [0.75, 0], [1, 0]] } } ],
    "emitters": [
      { "id": "burst", "gen": "pickup.burst", "v": 1, "on": "shard", "at": [0, 0], "reach": { "from": "size", "map": [[0, 7], [1, 8]] },
        "sparkle": { "from": "sparkle", "pick": { "true": true, "false": false } }, "paint": "body", "bright": "burst-light", "core": "shine" } ] } },
  "clips": {
    "idle": { "frames": 8, "fps": 10 },
    "attract": { "frames": 6, "fps": 14, "label": "Magnetise" },
    "collect": { "frames": 6, "fps": 14, "loop": false, "frameEdits": { "3": { "flash": true } },
      "keys": [ { "t": 0, "ease": "hold", "emit": { "burst": { "amount": 0 } } }, { "t": 0.6, "ease": "linear", "emit": { "burst": { "amount": 0 } } },
                { "t": 1, "emit": { "burst": { "amount": 1 } } } ],
      "sounds": [ { "sound": "xp-blip", "preset": "XP shard", "frame": 0, "volume": 0.7 } ] } } }
