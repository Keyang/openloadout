{
  "format": "loadout-sprite",
  "version": 2,
  "id": "ui-buttons-flat",
  "name": "Flat buttons",
  "blurb": "A stretchable flat menu button with no light or bevel, in four states (normal, hover, pressed, disabled) plus a tab and an open tab; change its style, corners, edge, shadow and colours.",
  "meta": {
    "type": "ui",
    "role": "interface/button",
    "themes": ["neutral","city"],
    "gameTypes": ["arcade","puzzle","card-game","racing"],
    "view": "none",
    "words": ["button","menu","flat","modern","mobile","tab","pill","press","click","hover","start","clean","minimal","casual"],
    "license": "draft"
  },
  "size": [96,32],
  "pivot": [48,16],
  "grounded": false,
  "preview": "normal",
  "styles": ["pixel"],
  "palette": [
    {"id":"face","label":"Face","default":"#3f5068","material":"interface","swatches":["#3f5068","#7a4f33","#434d6d","#8e3a4a"]},
    {"id":"frame","label":"Edge","default":"#f0ead8","material":"interface","swatches":["#f0ead8","#8fd0f0","#9bd18a","#c2c9d6","#f6d3b0"]}
  ],
  "controls": [
    {
      "key": "style",
      "kind": "choice",
      "label": "Style",
      "options": [{"value":"solid","label":"Solid"},{"value":"outline","label":"Outline"},{"value":"pill","label":"Pill"}],
      "default": "solid",
      "group": "Look"
    },
    {"key":"corner","kind":"range","label":"Corner","lo":"Square","hi":"Round","default":0.5,"group":"Look","when":{"style":["solid","outline"]}},
    {"key":"border","kind":"range","label":"Border","lo":"Thin","hi":"Thick","default":0.5,"group":"Look"},
    {"key":"shadow","kind":"toggle","label":"Shadow","default":false,"group":"Look"},
    {"key":"face","kind":"colour","label":"Face","group":"Colors"},
    {"key":"frame","kind":"colour","label":"Edge","group":"Colors"}
  ],
  "versions": [
    {"name":"Blue button","params":{}},
    {"name":"Outline","params":{"style":"outline","border":1}},
    {"name":"Wine pill","params":{"style":"pill","face":"#8e3a4a"}},
    {"name":"Brown with shadow","params":{"face":"#7a4f33","shadow":true}},
    {"name":"Night square","params":{"face":"#434d6d","corner":0,"frame":"#8fd0f0"}}
  ],
  "body": {
    "panel": {
      "skin": {"use":"skin:flat","v":3,"paint":{"face":"face","frame":"frame"}},
      "piece": {
        "gen": "ui.slab",
        "v": 1,
        "clip": ["normal","hover","pressed","disabled"],
        "role": "button",
        "at": [1,1],
        "size": [94,30],
        "style": {"from":"style"},
        "corner": {"from":"corner","map":[[0,0],[1,4]]},
        "border": {"from":"border","map":[[0,1],[1,3]]},
        "shadow": {"from":"shadow"}
      },
      "states": ["normal","hover","pressed","disabled","tab","tab-active"],
      "draw": [
        {
          "gen": "ui.slab",
          "v": 1,
          "clip": ["tab"],
          "role": "tab",
          "at": [1,1],
          "size": [94,30],
          "style": {"from":"style"},
          "corner": {"from":"corner","map":[[0,0],[1,4]]},
          "border": {"from":"border","map":[[0,1],[1,3]]},
          "shadow": {"from":"shadow"}
        },
        {
          "gen": "ui.slab",
          "v": 1,
          "clip": ["tab-active"],
          "role": "tab-open",
          "at": [1,1],
          "size": [94,31],
          "style": {"from":"style"},
          "corner": {"from":"corner","map":[[0,0],[1,4]]},
          "border": {"from":"border","map":[[0,1],[1,3]]},
          "shadow": {"from":"shadow"}
        }
      ]
    }
  },
  "clips": {
    "normal": {"frames":1,"fps":8,"label":"Normal"},
    "hover": {"frames":1,"fps":8,"label":"Hover"},
    "pressed": {"frames":1,"fps":8,"label":"Pressed","sounds":[{"sound":"tech-click","preset":"Select","frame":0,"volume":0.6}]},
    "disabled": {"frames":1,"fps":8,"label":"Disabled"},
    "tab": {"frames":1,"fps":8,"label":"Tab, for a page that is not open"},
    "tab-active": {"frames":1,"fps":8,"label":"Open tab, for the page on view","sounds":[{"sound":"menu-move","preset":"Tab","frame":0,"volume":0.6}]}
  }
}
