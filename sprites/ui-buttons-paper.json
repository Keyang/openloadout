{
  "format": "loadout-sprite",
  "version": 2,
  "id": "ui-buttons-paper",
  "name": "Paper buttons",
  "blurb": "A stretchable menu button and tab cut from paper and ruled in ink, in four states (normal, hover, pressed, disabled) plus a tab and an open tab; change its style, corners, rule, shadow and colours.",
  "meta": {
    "type": "ui",
    "role": "interface/button",
    "themes": ["neutral"],
    "gameTypes": ["arcade","puzzle","card-game","farming-sim"],
    "view": "none",
    "words": ["button","menu","paper","ink","tab","sheet","card","press","click","hover","start","cosy","notebook","torn"],
    "license": "draft"
  },
  "size": [96,32],
  "pivot": [48,16],
  "grounded": false,
  "preview": "normal",
  "styles": ["pixel", "flat"],
  "palette": [
    {"id":"face","label":"Paper","default":"#f0ead8","material":"interface","swatches":["#f0ead8","#e6c96a","#f6d3b0","#c2c9d6","#9bd18a"]},
    {"id":"frame","label":"Ink","default":"#3f5068","material":"interface","swatches":["#3f5068","#7a4f33","#434d6d","#8e3a4a"]}
  ],
  "controls": [
    {
      "key": "style",
      "kind": "choice",
      "label": "Style",
      "options": [{"value":"sheet","label":"Sheet"},{"value":"torn","label":"Torn"},{"value":"card","label":"Card"}],
      "default": "sheet",
      "group": "Look"
    },
    {"key":"corner","kind":"range","label":"Corner","lo":"Square","hi":"Round","default":0.5,"group":"Look"},
    {"key":"border","kind":"range","label":"Border","lo":"Thin","hi":"Thick","default":0.5,"group":"Look"},
    {"key":"shadow","kind":"toggle","label":"Shadow","default":true,"group":"Look"},
    {"key":"face","kind":"colour","label":"Paper","group":"Colors"},
    {"key":"frame","kind":"colour","label":"Ink","group":"Colors"}
  ],
  "versions": [
    {"name":"Notebook","params":{}},
    {"name":"Torn page","params":{"style":"torn","face":"#f6d3b0"}},
    {"name":"Index card","params":{"style":"card","face":"#e6c96a"}},
    {"name":"Blue print","params":{"face":"#c2c9d6","frame":"#434d6d"}},
    {"name":"Red ink note","params":{"shadow":false,"corner":0,"border":1,"frame":"#8e3a4a"}}
  ],
  "body": {
    "panel": {
      "skin": {"use":"skin:paper","v":3,"paint":{"face":"face","frame":"frame"}},
      "piece": {
        "gen": "ui.slab",
        "v": 1,
        "clip": ["normal","hover","pressed","disabled"],
        "role": "button",
        "at": [1,1],
        "size": [94,30],
        "style": {"from":"style"},
        "corner": {"from":"corner","map":[[0,0],[1,4]]},
        "border": {"from":"border","map":[[0,1],[1,3]]},
        "shadow": {"from":"shadow"}
      },
      "states": ["normal","hover","pressed","disabled","tab","tab-active"],
      "draw": [
        {
          "gen": "ui.slab",
          "v": 1,
          "clip": ["tab"],
          "role": "tab",
          "at": [1,1],
          "size": [94,30],
          "style": {"from":"style"},
          "corner": {"from":"corner","map":[[0,0],[1,4]]},
          "border": {"from":"border","map":[[0,1],[1,3]]},
          "shadow": {"from":"shadow"}
        },
        {
          "gen": "ui.slab",
          "v": 1,
          "clip": ["tab-active"],
          "role": "tab-open",
          "at": [1,1],
          "size": [94,31],
          "style": {"from":"style"},
          "corner": {"from":"corner","map":[[0,0],[1,4]]},
          "border": {"from":"border","map":[[0,1],[1,3]]},
          "shadow": {"from":"shadow"}
        }
      ]
    }
  },
  "clips": {
    "normal": {"frames":1,"fps":8,"label":"Normal"},
    "hover": {"frames":1,"fps":8,"label":"Hover"},
    "pressed": {"frames":1,"fps":8,"label":"Pressed","sounds":[{"sound":"ui-click","preset":"Soft tap","frame":0,"volume":0.6}]},
    "disabled": {"frames":1,"fps":8,"label":"Disabled"},
    "tab": {"frames":1,"fps":8,"label":"Tab, for a page that is not open"},
    "tab-active": {"frames":1,"fps":8,"label":"Open tab, for the page on view","sounds":[{"sound":"menu-move","preset":"Page turn","frame":0,"volume":0.6}]}
  }
}
