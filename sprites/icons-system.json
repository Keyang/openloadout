  {"key": "shine", "kind": "toggle", "label": "Shine", "default": true},
  {"key": "size", "kind": "range", "label": "Size", "lo": "Small", "hi": "Big", "default": 0.5},
  {"key": "face", "kind": "colour", "label": "Plate colour", "when": {"backing": ["hex", "circle"]}},
  {"key": "body", "kind": "colour", "label": "Picture"},
  {"key": "accent", "kind": "colour", "label": "Second colour"}
 ],
