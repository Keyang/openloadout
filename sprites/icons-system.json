  "license": "draft"
 },
 "size": [32, 32],
 "pivot": [16, 16],
 "grounded": false,
 "preview": "settings",
 "styles": ["pixel"],
 "palette": [
  {
   "id": "face",
   "label": "Plate colour",
   "default": "#5d6475",
