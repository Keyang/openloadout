{ "format": "loadout-sprite", "version": 2, "id": "star-charm", "name": "Star charm",
  "blurb": "A star-shaped gold medallion on a loop that swings, turns and twinkles: the power-up. Change its points, jewel, halo and colours.",
  "meta": { "type": "pickup", "role": "items/pickup", "themes": ["fantasy", "forest"], "gameTypes": ["platformer", "arcade", "roguelike-action"], "view": "front",
            "words": ["star", "charm", "medallion", "amulet", "badge", "power up", "powerup", "bonus", "invincible", "collect", "pickup", "reward", "magic", "shiny"], "license": "draft" },
  "size": [32, 32], "pivot": [16, 30], "grounded": false, "preview": "idle", "styles": ["pixel"],
  "palette": [
    { "id": "body", "label": "Metal", "default": "#f2c230", "material": "metal", "swatches": ["#f2c230", "#c2c9d6", "#8f97a8", "#e6c545", "#c98a4a"] },
    { "id": "glow", "label": "Glow", "default": "#4fd8ee", "material": "magic", "swatches": ["#4fd8ee", "#e08a2c", "#a4c44a", "#c9423a", "#7a4fc4"] },
    { "id": "burst-light", "material": "light", "derive": { "rule": "mix", "of": { "rule": "ramp", "of": "body", "tone": "light" }, "with": "shine", "amount": 0.35 } },
    { "id": "shine", "default": "#ffffff", "material": "light", "detail": true } ],
  "controls": [
    { "key": "size", "kind": "range", "label": "Size", "lo": "Small", "hi": "Big", "default": 0.5 },
    { "key": "shape", "kind": "choice", "label": "Shape", "default": "five",
      "options": [{ "value": "four", "label": "Four points" }, { "value": "five", "label": "Five points" }, { "value": "six", "label": "Six points" }, { "value": "eight", "label": "Eight points" }] },
    { "key": "jewel", "kind": "toggle", "label": "Jewel", "default": true },
    { "key": "halo", "kind": "toggle", "label": "Halo", "default": true },
    { "key": "sparkle", "kind": "toggle", "label": "Sparkle", "default": true },
    { "key": "body", "kind": "colour", "label": "Metal" },
    { "key": "glow", "kind": "colour", "label": "Glow" },
    { "key": "bob", "kind": "range", "label": "Float", "lo": "Still", "hi": "Floaty", "default": 0.5, "group": "Motion" },
    { "key": "pop", "kind": "range", "label": "Pop height", "lo": "Low", "hi": "High", "default": 0.5, "group": "Motion" },
    { "key": "speed", "standard": "speed" } ],
  "body": { "pictures": {
    "nodes": [ { "id": "charm", "parent": null, "at": [16, 17] } ],
    "draw": [
      { "id": "halo", "gen": "star.charm", "v": 1, "on": "charm", "at": [0, 0], "layer": "halo", "when": { "halo": [true] },
        "points": { "from": "shape", "pick": { "four": "four", "five": "five", "six": "six", "eight": "eight" } },
        "size": { "from": "size", "map": [[0, 0], [1, 1]], "round": "none" },
        "metal": "body", "energy": "glow", "shine": "shine" },
      { "id": "badge", "gen": "star.charm", "v": 1, "on": "charm", "at": [0, 0], "layer": "charm", "group": "badge",
        "points": { "from": "shape", "pick": { "four": "four", "five": "five", "six": "six", "eight": "eight" } },
        "size": { "from": "size", "map": [[0, 0], [1, 1]], "round": "none" },
        "jewel": { "from": "jewel", "pick": { "true": true, "false": false } },
        "metal": "body", "energy": "glow", "shine": "shine" },
      { "kind": "outline", "paint": "ink", "only": "badge" },
      { "id": "twinkles", "gen": "star.charm", "v": 1, "on": "charm", "at": [0, 0], "layer": "sparkles",
        "points": { "from": "shape", "pick": { "four": "four", "five": "five", "six": "six", "eight": "eight" } },
        "size": { "from": "size", "map": [[0, 0], [1, 1]], "round": "none" },
        "sparkle": { "from": "sparkle", "pick": { "true": true, "false": false } },
        "metal": "body", "energy": "glow", "shine": "shine" } ],
    "motion": [
      { "gen": "pickup.bob", "v": 1, "clip": ["idle"], "height": { "from": "bob", "map": [[0, 0], [1, 2]] } },
      { "gen": "pickup.collect", "v": 1, "node": "charm", "clip": ["collect"], "pop": { "from": "pop", "map": [[0, 0], [1, 1]] },
        "low": { "from": "size", "map": [[0, 2.3], [1, 0.8]] }, "high": { "from": "size", "map": [[0, 5.1], [1, 1.8]] }, "room": { "from": "size", "map": [[0, 5.1], [1, 1.8]] } } ],
    "emitters": [
      { "id": "burst", "gen": "pickup.burst", "v": 1, "on": "charm", "at": [0, 0], "reach": { "from": "size", "map": [[0, 10.5], [1, 13.5]] },
        "sparkle": { "from": "sparkle", "pick": { "true": true, "false": false } }, "paint": "body", "bright": "burst-light", "core": "shine" } ] } },
  "clips": {
    "idle": { "frames": 8, "fps": 10 },
    "collect": { "frames": 8, "fps": 14, "loop": false, "frameEdits": { "4": { "flash": true } },
      "keys": [ { "t": 0, "ease": "hold", "emit": { "burst": { "amount": 0 } } }, { "t": 0.6, "ease": "linear", "emit": { "burst": { "amount": 0 } } },
                { "t": 1, "emit": { "burst": { "amount": 1 } } } ],
      "sounds": [ { "sound": "powerup", "preset": "Charge", "frame": 1, "volume": 0.7 } ] } } }
