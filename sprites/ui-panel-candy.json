{
  "format": "loadout-sprite",
  "version": 2,
  "id": "ui-panel-candy",
  "name": "Candy panels",
  "blurb": "Stretchable glossy sugar boxes for pop-ups, results and shops: a panel, a panel with a heading, a list well and a tooltip, a deep candy slab in a pale sugar rim with sprinkles; change the style, corners, rim, sprinkles and colours.",
  "meta": {
    "type": "ui",
    "role": "interface/panel",
    "themes": ["neutral","candy"],
    "gameTypes": ["arcade","puzzle","card-game","racing"],
    "view": "none",
    "words": ["panel","window","box","popup","menu","candy","sweet","sugar","sprinkles","tooltip","shop","results","list","glossy"],
    "license": "draft"
  },
  "size": [96,64],
  "pivot": [48,32],
  "grounded": false,
  "preview": "panel",
  "styles": ["pixel", "flat"],
  "palette": [
    {"id":"face","label":"Candy","default":"#7a4f33","material":"interface","swatches":["#7a4f33","#3f5068","#8e3a4a","#434d6d"]},
    {"id":"frame","label":"Sugar","default":"#f0ead8","material":"interface","swatches":["#f0ead8","#f6d3b0","#8fd0f0","#9bd18a"]},
    {"id":"accent","label":"Sprinkles","default":"#4fd8ee","material":"interface","swatches":["#4fd8ee","#e08a2c","#c2c9d6","#6aa83e","#a4c44a"]}
  ],
  "controls": [
    {
      "key": "style",
      "kind": "choice",
      "label": "Style",
      "options": [{"value":"jelly","label":"Jelly"},{"value":"striped","label":"Striped"},{"value":"frosted","label":"Frosted"}],
      "default": "jelly",
      "group": "Look"
    },
    {"key":"corner","kind":"range","label":"Corner","lo":"Square","hi":"Round","default":0.75,"group":"Look"},
    {"key":"border","kind":"range","label":"Border","lo":"Thin","hi":"Thick","default":0.5,"group":"Look"},
    {"key":"sprinkles","kind":"toggle","label":"Sprinkles","default":true,"group":"Look"},
    {"key":"face","kind":"colour","label":"Candy","group":"Colors"},
    {"key":"frame","kind":"colour","label":"Sugar","group":"Colors"},
    {"key":"accent","kind":"colour","label":"Sprinkles","group":"Colors","when":{"sprinkles":[true]}}
  ],
  "versions": [
    {"name":"Toffee box","params":{}},
    {"name":"Cherry stripe","params":{"style":"striped","face":"#8e3a4a"}},
    {"name":"Frosted blueberry","params":{"style":"frosted","face":"#3f5068","sprinkles":false}},
    {"name":"Liquorice","params":{"face":"#434d6d","accent":"#6aa83e"}},
    {"name":"Caramel","params":{"frame":"#f6d3b0","accent":"#e08a2c"}}
  ],
  "body": {
    "panel": {
      "skin": {"use":"skin:candy","v":3,"paint":{"face":"face","frame":"frame","accent":"accent"}},
      "piece": {
        "gen": "ui.slab",
        "v": 1,
        "clip": ["panel"],
        "at": [1,1],
        "size": [94,62],
        "style": {"from":"style"},
        "corner": {"from":"corner","map":[[0,0],[1,4]]},
        "border": {"from":"border","map":[[0,1],[1,3]]},
        "extras": {"from":"sprinkles"}
      },
      "states": ["panel","panel-title","inset","tooltip"],
      "draw": [
        {
          "gen": "ui.slab",
          "v": 1,
          "clip": ["panel-title"],
          "role": "title",
          "at": [1,1],
          "size": [94,62],
          "style": {"from":"style"},
          "corner": {"from":"corner","map":[[0,0],[1,4]]},
          "border": {"from":"border","map":[[0,1],[1,3]]},
          "extras": {"from":"sprinkles"}
        },
        {
          "gen": "ui.slab",
          "v": 1,
          "clip": ["inset"],
          "role": "inset",
          "at": [1,1],
          "size": [94,62],
          "style": {"from":"style"},
          "corner": {"from":"corner","map":[[0,0],[1,4]]},
          "border": {"from":"border","map":[[0,1],[1,3]]},
          "extras": {"from":"sprinkles"}
        },
        {
          "gen": "ui.slab",
          "v": 1,
          "clip": ["tooltip"],
          "role": "tooltip",
          "at": [1,1],
          "size": [94,40],
          "style": {"from":"style"},
          "corner": {"from":"corner","map":[[0,0],[1,4]]},
          "border": {"from":"border","map":[[0,1],[1,3]]},
          "extras": {"from":"sprinkles"}
        }
      ]
    }
  },
  "clips": {
    "panel": {"frames":1,"fps":8,"label":"Panel"},
    "panel-title": {"frames":1,"fps":8,"label":"With heading"},
    "inset": {"frames":1,"fps":8,"label":"List well"},
    "tooltip": {"frames":1,"fps":8,"label":"Tooltip"}
  }
}
