{ "format": "loadout-sprite", "version": 2, "id": "drop-streak", "name": "Drop streaks",
  "blurb": "Lines of light left above a piece dropped straight down, and the puffs where it lands. Change how tall and wide they are, how many, their style and colours.",
  "meta": { "type": "effect", "role": "effects/dust", "themes": ["neutral", "sci-fi"], "gameTypes": ["puzzle", "arcade", "shooter"], "view": "none",
            "words": ["drop", "slam", "streak", "fall", "trail", "speed", "landing", "dash", "lines", "impact"], "license": "draft" },
  "size": [64, 64], "pivot": [32, 62], "grounded": false, "preview": "burst", "styles": ["pixel", "flat"],
  "palette": [
    { "id": "core", "label": "Core", "default": "#f0ead8", "material": "light", "swatches": ["#f0ead8", "#e6e8f6", "#f2dc4c", "#5fe0f0"] },
    { "id": "edge", "label": "Edge", "default": "#7d52e6", "material": "light", "swatches": ["#7d52e6", "#f2609e", "#a6dc46", "#46d8a8", "#2a9a9a", "#f5875a"] },
    { "id": "mid", "material": "light", "derive": { "rule": "mix", "of": "core", "with": "edge", "amount": 0.5 } },
    { "id": "rim", "material": "light", "derive": { "rule": "tone", "of": "edge", "by": -1 } },
    { "id": "shine", "default": "#ffffff", "material": "light", "detail": true } ],
  "controls": [
    { "key": "height", "kind": "range", "label": "Height", "lo": "Short", "hi": "Tall", "default": 0.5 },
    { "key": "pieces", "kind": "range", "label": "Streaks", "lo": "Few", "hi": "Many", "min": 2, "max": 5, "step": 1, "default": 3 },
    { "key": "width", "kind": "range", "label": "Width", "lo": "Narrow", "hi": "Wide", "default": 0.5 },
    { "key": "style", "kind": "choice", "label": "Style", "options": ["lines", "dashes", "blocks"], "default": "lines" },
    { "key": "core", "kind": "colour", "label": "Core" },
    { "key": "edge", "kind": "colour", "label": "Edge" },
    { "key": "speed", "standard": "speed" } ],
  "versions": [
    { "name": "Violet lines", "params": {} },
    { "name": "Lemon dashes", "params": { "style": "dashes", "core": "#f2dc4c" } },
    { "name": "Wide blocks", "params": { "style": "blocks", "width": 1, "edge": "#f2609e" } },
    { "name": "Tall, five", "params": { "height": 1, "pieces": 5, "edge": "#46d8a8" } } ],
  "body": { "emitters": [
    { "id": "streaks", "gen": "light.columns", "v": 1, "clip": ["burst"], "at": [32, 62],
      "count": { "from": "pieces", "map": [[2, 2], [5, 5]], "round": "px" },
      "span": { "from": "width", "map": [[0, 16], [1, 60]], "round": "px" },
      "height": { "from": "height", "map": [[0, 40], [1, 56]], "round": "px" },
      "style": { "from": "style", "pick": { "lines": "lines", "dashes": "dashes", "blocks": "blocks" } },
      "paints": ["shine", "core", "mid", "edge", "rim"] },
    { "id": "dust", "gen": "drop.motes", "v": 1, "clip": ["dust"], "at": [32, 62],
      "count": { "from": "pieces", "map": [[2, 2], [5, 5]], "round": "px" },
      "reach": { "from": "width", "map": [[0, 5], [1, 10]] },
      "rise": 2, "keep": 2,
      "paints": ["shine", "core", "mid", "edge", "rim"] } ] },
  "clips": {
    "burst": { "frames": 6, "fps": 14, "loop": false },
    "dust": { "label": "Landing puffs", "frames": 6, "fps": 14, "loop": false } } }
