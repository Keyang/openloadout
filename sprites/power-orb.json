{ "format": "loadout-sprite", "version": 2, "id": "power-orb", "name": "Power orb",
  "blurb": "A floating power-up: a glowing shell with a mark inside and a ring around it, turning slowly. Change the shell, the mark, the ring, its size, sparkle and colours.",
  "meta": { "type": "pickup", "role": "items/pickup", "themes": ["neutral", "fantasy", "sci-fi"], "gameTypes": ["arcade", "platformer", "shooter", "roguelike-action"], "view": "front",
            "words": ["power", "powerup", "orb", "boost", "buff", "energy", "crystal", "sphere", "upgrade", "collect", "pickup", "glowing", "magic"], "license": "draft" },
  "size": [32, 32], "pivot": [16, 30], "grounded": false, "preview": "idle", "styles": ["pixel"],
  "palette": [
    { "id": "glow", "label": "Glow", "default": "#4fd8ee", "material": "magic", "swatches": ["#4fd8ee", "#e08a2c", "#f2c230", "#a4c44a", "#c9423a", "#7a4fc4", "#5fe0f0"] },
    { "id": "metal", "label": "Metal", "default": "#c2c9d6", "material": "metal", "swatches": ["#c2c9d6", "#8f97a8", "#5d6475", "#c98a4a", "#a8806a"] },
    { "id": "mark-ink", "material": "paint", "derive": { "rule": "standOut", "against": "glow", "from": ["shine", "ink"] } },
    { "id": "mark-halo", "material": "light", "derive": { "rule": "standOut", "against": "mark-ink", "from": ["shine", "glow"] } },
    { "id": "burst-light", "material": "light", "derive": { "rule": "mix", "of": { "rule": "ramp", "of": "glow", "tone": "light" }, "with": "shine", "amount": 0.35 } },
    { "id": "shine", "default": "#ffffff", "material": "light", "detail": true } ],
  "controls": [
    { "key": "size", "kind": "range", "label": "Size", "lo": "Small", "hi": "Big", "default": 0.5 },
    { "key": "shape", "kind": "choice", "label": "Shell", "options": ["orb", "prism", "shard"], "default": "orb" },
    { "key": "mark", "kind": "choice", "label": "Mark", "options": ["arrow", "sun", "star", "none"], "default": "star" },
    { "key": "cage", "kind": "toggle", "label": "Ring", "default": true },
    { "key": "sparkle", "kind": "toggle", "label": "Sparkle", "default": true },
    { "key": "glow", "kind": "colour", "label": "Glow" },
    { "key": "metal", "kind": "colour", "label": "Metal", "when": { "cage": [true] } },
    { "key": "bob", "kind": "range", "label": "Float", "lo": "Still", "hi": "Floaty", "default": 0.5, "group": "Motion" },
    { "key": "pop", "kind": "range", "label": "Pop height", "lo": "Low", "hi": "High", "default": 0.5, "group": "Motion" },
    { "key": "speed", "standard": "speed" } ],
  "body": { "pictures": {
    "nodes": [ { "id": "orb", "parent": null, "at": [16, 17] } ],
    "draw": [
      { "id": "aura", "gen": "power.orb", "v": 1, "on": "orb", "at": [0, 0], "layer": "aura",
        "shell": { "from": "shape", "pick": { "orb": "orb", "prism": "prism", "shard": "shard" } }, "size": { "from": "size", "map": [[0, 0], [1, 1]], "round": "none" },
        "energy": "glow", "metal": "metal", "markInk": "mark-ink", "markHalo": "mark-halo", "shine": "shine" },
      { "id": "ring-back", "gen": "power.orb", "v": 1, "on": "orb", "at": [0, 0], "layer": "far", "when": { "cage": [true] },
        "shell": { "from": "shape", "pick": { "orb": "orb", "prism": "prism", "shard": "shard" } }, "size": { "from": "size", "map": [[0, 0], [1, 1]], "round": "none" },
        "energy": "glow", "metal": "metal", "markInk": "mark-ink", "markHalo": "mark-halo", "shine": "shine" },
      { "id": "shell", "gen": "power.orb", "v": 1, "on": "orb", "at": [0, 0], "layer": "shell", "group": "shell",
        "shell": { "from": "shape", "pick": { "orb": "orb", "prism": "prism", "shard": "shard" } }, "size": { "from": "size", "map": [[0, 0], [1, 1]], "round": "none" },
        "mark": { "from": "mark", "pick": { "arrow": "arrow", "sun": "sun", "star": "star", "none": "none" } },
        "energy": "glow", "metal": "metal", "markInk": "mark-ink", "markHalo": "mark-halo", "shine": "shine" },
      { "kind": "outline", "paint": "ink", "only": "shell" },
      { "id": "ring-front", "gen": "power.orb", "v": 1, "on": "orb", "at": [0, 0], "layer": "near", "when": { "cage": [true] },
        "shell": { "from": "shape", "pick": { "orb": "orb", "prism": "prism", "shard": "shard" } }, "size": { "from": "size", "map": [[0, 0], [1, 1]], "round": "none" },
        "energy": "glow", "metal": "metal", "markInk": "mark-ink", "markHalo": "mark-halo", "shine": "shine" },
      { "id": "sparkle-orb", "gen": "gleam", "v": 1, "on": "orb", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["orb"] },
        "at": [ { "from": "size", "map": [[0, 5], [1, 7]], "round": "px" }, { "from": "size", "map": [[0, -5], [1, -7]], "round": "px" } ], "peak": 0.6, "paint": "shine", "core": "shine" },
      { "id": "sparkle-prism", "gen": "gleam", "v": 1, "on": "orb", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["prism"] },
        "at": [ { "from": "size", "map": [[0, 4], [1, 5]], "round": "px" }, { "from": "size", "map": [[0, -7], [1, -9]], "round": "px" } ], "peak": 0.6, "paint": "shine", "core": "shine" },
      { "id": "sparkle-shard", "gen": "gleam", "v": 1, "on": "orb", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["shard"] },
        "at": [ 5, { "from": "size", "map": [[0, -7], [1, -10]], "round": "px" } ], "peak": 0.6, "paint": "shine", "core": "shine" } ],
    "motion": [
      { "gen": "pickup.bob", "v": 1, "clip": ["idle"], "height": { "from": "bob", "map": [[0, 0], [1, 2]] } },
      { "gen": "pickup.collect", "v": 1, "node": "orb", "clip": ["collect"], "pop": { "from": "pop", "map": [[0, 0], [1, 1]] },
        "low": { "from": "size", "map": [[0, 2.3], [1, 0.8]] }, "high": { "from": "size", "map": [[0, 5.1], [1, 1.8]] }, "room": { "from": "size", "map": [[0, 5.1], [1, 1.8]] } } ],
    "emitters": [
      { "id": "burst", "gen": "pickup.burst", "v": 1, "on": "orb", "at": [0, 0], "reach": { "from": "size", "map": [[0, 9], [1, 12.5]] },
        "sparkle": { "from": "sparkle", "pick": { "true": true, "false": false } }, "paint": "glow", "bright": "burst-light", "core": "shine" } ] } },
  "clips": {
    "idle": { "frames": 8, "fps": 10 },
    "collect": { "frames": 8, "fps": 14, "loop": false, "frameEdits": { "4": { "flash": true } },
      "keys": [ { "t": 0, "ease": "hold", "emit": { "burst": { "amount": 0 } } }, { "t": 0.6, "ease": "linear", "emit": { "burst": { "amount": 0 } } },
                { "t": 1, "emit": { "burst": { "amount": 1 } } } ],
      "sounds": [ { "sound": "star-pickup", "preset": "Chiptune", "frame": 1, "volume": 0.7 } ] } },
  "versions": [
    { "name": "Blue power", "params": {} },
    { "name": "Speed boost", "params": { "mark": "arrow", "glow": "#e08a2c" } },
    { "name": "Sun orb", "params": { "mark": "sun", "glow": "#f2c230", "metal": "#c2c9d6" } },
    { "name": "Crystal core", "params": { "shape": "prism", "cage": false, "glow": "#7a4fc4" } },
    { "name": "Star shard", "params": { "shape": "shard", "mark": "star", "glow": "#5fe0f0" } } ] }
