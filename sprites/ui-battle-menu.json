  {"key": "corner", "kind": "range", "label": "Corner", "lo": "Square", "hi": "Round", "default": 0.5},
  {"key": "border", "kind": "range", "label": "Border", "lo": "Thin", "hi": "Thick", "default": 0.5},
  {"key": "face", "kind": "colour", "label": "Face"},
  {"key": "frame", "kind": "colour", "label": "Frame"},
  {"key": "accent", "kind": "colour", "label": "Accent"},
  {"key": "speed", "standard": "speed"} ],
  "body": { "panel": {
    "piece": {"gen": "battle.menu", "v": 1, "at": [48,32], "clip": ["panel"], "picture": "panel", "style": {"from": "style", "pick": {"plain": "plain", "ornate": "ornate", "scroll": "scroll"}}, "corner": {"from": "corner", "map": [[0,0], [1,1]], "round": "none"}, "border": {"from": "border", "map": [[0,0], [1,1]], "round": "none"}, "face": "face", "frame": "frame", "accent": "accent"},
    "states": [
    "panel",
    "row",
    "cursor",
    "turn-marker" ],
    "draw": [
    {"gen": "battle.menu", "v": 1, "at": [48,32], "clip": ["row"], "picture": "row", "style": {"from": "style", "pick": {"plain": "plain", "ornate": "ornate", "scroll": "scroll"}}, "corner": {"from": "corner", "map": [[0,0], [1,1]], "round": "none"}, "border": {"from": "border", "map": [[0,0], [1,1]], "round": "none"}, "face": "face", "frame": "frame", "accent": "accent"},
    {"gen": "battle.menu", "v": 1, "at": [48,32], "clip": ["cursor"], "picture": "cursor", "style": {"from": "style", "pick": {"plain": "plain", "ornate": "ornate", "scroll": "scroll"}}, "corner": {"from": "corner", "map": [[0,0], [1,1]], "round": "none"}, "border": {"from": "border", "map": [[0,0], [1,1]], "round": "none"}, "face": "face", "frame": "frame", "accent": "accent"},
    {"gen": "battle.menu", "v": 1, "at": [48,32], "clip": ["turn-marker"], "picture": "turn-marker", "style": {"from": "style", "pick": {"plain": "plain", "ornate": "ornate", "scroll": "scroll"}}, "corner": {"from": "corner", "map": [[0,0], [1,1]], "round": "none"}, "border": {"from": "border", "map": [[0,0], [1,1]], "round": "none"}, "face": "face", "frame": "frame", "accent": "accent"} ] } },
  "clips": {
    "panel": {"frames": 1, "fps": 8, "label": "Panel"},
    "row": {"frames": 1, "fps": 8, "label": "Highlight"},
