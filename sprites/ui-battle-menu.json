{ "format": "loadout-sprite",
  "version": 2,
  "id": "ui-battle-menu",
  "name": "Battle menu",
  "blurb": "A stretchable command panel with a highlight row, a diamond-headed arrow cursor and a bouncing turn marker; change its style, corners, border and colours.",
  "meta": {"type": "ui", "role": "interface/panel", "themes": ["fantasy", "neutral"], "gameTypes": ["turn-based-rpg", "top-down-rpg", "card-game"], "view": "none", "words": ["menu", "command", "battle", "cursor", "arrow", "pointer", "select", "choose", "turn", "marker", "window", "panel"], "license": "draft"},
  "size": [96,64],
  "pivot": [48,32],
  "grounded": false,
  "preview": "panel",
  "styles": ["pixel"],
  "palette": [
  {"id": "face", "label": "Face", "default": "#4a609c", "material": "interface", "swatches": ["#4a609c", "#5a5f7a", "#8e3a4a", "#6541b9", "#19708e"]},
  {"id": "frame", "label": "Frame", "default": "#f0ead8", "material": "interface", "swatches": ["#f0ead8", "#f6d3b0", "#c9d2dd", "#fdf277", "#a7e5fa"]},
  {"id": "accent", "label": "Accent", "default": "#f2c230", "material": "interface", "swatches": ["#f2c230", "#c9423a", "#f0ead8", "#7fe0a0", "#4fd8ee", "#c8553a"]} ],
  "controls": [
