{ "format": "loadout-sprite", "version": 2, "id": "ui-junk-gauge", "name": "Junk gauge",
  "blurb": "A standing gauge for a two-player falling-block game: an empty housing, a strip of junk rows on their way, a warning strip for junk about to land and a white flash; change the style, corners, frame thickness, row marks and colours.",
  "meta": { "type": "ui", "role": "interface/bar", "themes": ["neutral", "sci-fi"], "gameTypes": ["puzzle", "arcade"], "view": "none",
            "words": ["gauge", "meter", "junk", "garbage", "attack", "incoming", "versus", "rows", "warning", "bar"], "license": "draft" },
  "size": [16, 64], "pivot": [8, 32], "grounded": false, "preview": "frame", "styles": ["pixel"],
  "stylesWhy": "The kit is pixel only until the flat style has been looked at (specification, decision P5); the housing and its strips are laid pixel by pixel by ui.gauge@1 and block.cell@2.",
  "palette": [
    { "id": "frame", "label": "Frame", "default": "#c2c9d6", "material": "paint", "swatches": ["#c2c9d6", "#5fe0f0", "#f2dc4c", "#e6e8f6"] },
    { "id": "fill", "label": "Junk", "default": "#6e78b4", "material": "stone", "swatches": ["#6e78b4", "#4f5894", "#a3abd8", "#7d52e6"] },
    { "id": "fillB", "label": "About to land", "default": "#e2473f", "material": "warning", "swatches": ["#e2473f", "#f5875a", "#f2609e", "#f2c230"] },
    { "id": "accent", "label": "Corner blocks", "default": "#46d8a8", "material": "paint", "swatches": ["#f2609e", "#46d8a8", "#a6dc46", "#f2c230", "#f5875a"] },
    { "id": "shine", "default": "#ffffff", "material": "light", "detail": true } ],
  "controls": [
    { "key": "style", "kind": "choice", "label": "Style", "options": ["blocks", "plate", "tube"], "default": "blocks", "group": "Look" },
    { "key": "corner", "kind": "range", "label": "Corner", "lo": "Square", "hi": "Round", "default": 0.5, "group": "Look", "when": { "style": ["tube", "plate"] } },
    { "key": "border", "kind": "range", "label": "Border", "lo": "Thin", "hi": "Thick", "default": 0.5, "group": "Look" },
    { "key": "marks", "kind": "toggle", "label": "Row marks", "default": true, "group": "Look" },
    { "key": "frame", "kind": "colour", "label": "Frame", "group": "Colors" },
    { "key": "fill", "kind": "colour", "label": "Junk", "group": "Colors" },
    { "key": "fillB", "kind": "colour", "label": "About to land", "group": "Colors" },
    { "key": "accent", "kind": "colour", "label": "Corner blocks", "group": "Colors", "when": { "style": ["blocks"] } } ],
  "versions": [
    { "name": "Block gauge", "params": {} },
    { "name": "Pearl plate", "params": { "style": "plate", "frame": "#e6e8f6" } },
    { "name": "Cyan tube", "params": { "style": "tube", "frame": "#5fe0f0" } },
    { "name": "Lemon, thick", "params": { "frame": "#f2dc4c", "border": 1, "fill": "#7d52e6", "accent": "#f2609e" } } ],
  "body": { "panel": {
    "piece": { "gen": "ui.gauge", "v": 1, "clip": ["frame"], "at": [1, 1], "size": [14, 62],
               "look": { "from": "style", "pick": { "blocks": "blocks", "plate": "plate", "tube": "tube" } },
               "corner": { "from": "corner", "map": [[0, 0], [1, 4]] }, "border": { "from": "border", "map": [[0, 1], [1, 3]] },
               "ends": { "from": "style", "pick": { "blocks": 4, "plate": 0, "tube": 0 } }, "frame": "frame" },
    "states": ["frame", "fill", "fill-b", "flash"],
    "draw": [
      { "id": "cell-top", "gen": "block.cell", "v": 2, "clip": ["frame"], "when": { "style": ["blocks"] }, "at": [6, 1], "size": 4, "edge": 1, "paint": "accent" },
      { "id": "cell-bottom", "gen": "block.cell", "v": 2, "clip": ["frame"], "when": { "style": ["blocks"] }, "at": [6, 59], "size": 4, "edge": 1, "paint": "accent" },
      { "id": "junk", "gen": "ui.gauge", "v": 1, "clip": ["fill"], "layer": "fill", "at": [1, 1], "size": [14, 62],
        "border": { "from": "border", "map": [[0, 1], [1, 3]] }, "ends": { "from": "style", "pick": { "blocks": 4, "plate": 0, "tube": 0 } },
        "marks": { "from": "marks", "pick": { "true": 8, "false": 0 } }, "fill": "fill", "shine": "shine" },
      { "id": "warning", "gen": "ui.gauge", "v": 1, "clip": ["fill-b"], "layer": "fill", "at": [1, 1], "size": [14, 62],
        "border": { "from": "border", "map": [[0, 1], [1, 3]] }, "ends": { "from": "style", "pick": { "blocks": 4, "plate": 0, "tube": 0 } },
        "marks": { "from": "marks", "pick": { "true": 8, "false": 0 } }, "fill": "fillB", "shine": "shine" },
      { "id": "flash", "gen": "ui.gauge", "v": 1, "clip": ["flash"], "layer": "fill", "at": [1, 1], "size": [14, 62],
        "border": { "from": "border", "map": [[0, 1], [1, 3]] }, "ends": { "from": "style", "pick": { "blocks": 4, "plate": 0, "tube": 0 } },
        "marks": { "from": "marks", "pick": { "true": 8, "false": 0 } }, "fill": "fill", "shine": "shine", "flash": 1, "fade": true } ] } },
  "clips": {
    "frame": { "frames": 1, "fps": 8, "label": "Empty gauge housing" },
    "fill": { "frames": 1, "fps": 8, "label": "Junk rows on their way" },
    "fill-b": { "frames": 1, "fps": 8, "label": "Junk about to land, the last moment to clear it" },
    "flash": { "frames": 4, "fps": 8, "loop": false, "label": "Gauge flash, when junk is sent or arrives",
               "sounds": [ { "sound": "junk-send", "preset": "Send one", "frame": 0, "volume": 0.6 } ] } } }
