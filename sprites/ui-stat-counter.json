    {"id":"number-bump","gen":"ui.counter.digits","v":1,"clip":["bump"],"at":[1,1],"width":62,"height":22,"picture":13,"count":{"from":"digits","map":[[2,2],[4,4]],"round":"px"},"big":{"from":"size","map":[[0,0],[1,1]]},"style":{"from":"style","pick":{"plate":"plate","strip":"strip","drum":"drum"}},"value":12,"play":"bump","paint":"glow","flash":"shine"}]}},
