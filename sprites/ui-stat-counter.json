  "controls": [
    {"key":"style","kind":"choice","label":"Style","options":["plate","strip","drum"],"default":"strip"},
    {"key":"digits","kind":"range","label":"Digits","lo":"Few","hi":"Many","min":2,"max":4,"step":1,"default":3},
    {"key":"size","kind":"range","label":"Size","lo":"Small","hi":"Big","default":0.5},
