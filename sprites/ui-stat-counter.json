  "name": "Level and lines counter",
  "blurb": "A small counter for the side of a block puzzle: a picture for level, lines, speed or combo beside a row of digit windows, a digit that rolls up by one and a flash on level up, plus the empty case for the game's own digits; change the style, number of digits, size, picture and colours.",
  "meta": {"type":"ui","role":"interface/panel","themes":["neutral","sci-fi"],"gameTypes":["puzzle","arcade"],"view":"none","words":["level","lines","counter","stage","speed","combo","digits","hud","number","count"],"license":"draft"},
  "size": [64,24],
  "pivot": [32,12],
  "grounded": false,
  "preview": "idle",
  "styles": ["pixel"],
  "stylesWhy": "The kit is pixel only until the flat style has been looked at (specification, decision P5); the case, the digits and the picture are laid pixel by pixel by the ui.counter generators.",
  "palette": [
    {"id":"face","label":"Windows","default":"#2a3058","material":"interface","swatches":["#2a3058","#3a4278","#1e4658","#6a3a8e"]},
