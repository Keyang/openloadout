    {"id":"picture","gen":"ui.counter.mark","v":1,"clip":["idle","roll","frame"],"at":[4,5],"name":{"from":"icon","pick":{"level":"level","lines":"lines","speed":"speed","combo":"combo"}},"paint":"glow"},
    {"id":"picture-bump","gen":"ui.counter.mark","v":1,"clip":["bump"],"at":[4,5],"name":{"from":"icon","pick":{"level":"level","lines":"lines","speed":"speed","combo":"combo"}},"play":"bump","paint":"glow","flash":"shine"},
    {"id":"number","gen":"ui.counter.digits","v":1,"clip":["idle"],"at":[1,1],"width":62,"height":22,"picture":13,"count":{"from":"digits","map":[[2,2],[4,4]],"round":"px"},"big":{"from":"size","map":[[0,0],[1,1]]},"style":{"from":"style","pick":{"plate":"plate","strip":"strip","drum":"drum"}},"value":12,"paint":"glow"},
