{ "format": "loadout-sprite", "version": 2, "id": "trophy", "name": "Trophy",
  "blurb": "A floating prize for the end of a level or a secret: a cup, a medal or a crown. Change the prize, its size, emblem, sparkle and colours.",
  "meta": { "type": "pickup", "role": "items/pickup", "themes": ["neutral"], "gameTypes": ["arcade", "platformer", "racing", "puzzle"], "view": "front",
            "words": ["trophy", "cup", "medal", "crown", "prize", "award", "winner", "champion", "collect", "reward", "secret", "golden"], "license": "draft" },
  "size": [32, 32], "pivot": [16, 30], "grounded": false, "preview": "idle", "styles": ["pixel"],
  "palette": [
    { "id": "metal", "label": "Metal", "default": "#f2c230", "material": "metal", "swatches": ["#f2c230", "#c2c9d6", "#e6c545", "#c98a4a", "#a8806a"] },
    { "id": "accent", "label": "Ribbon", "default": "#3f6fd1", "material": "cloth", "swatches": ["#3f6fd1", "#c9423a", "#7a4fc4", "#f0ead8", "#e08a2c", "#4f9d57"] },
    { "id": "stone", "label": "Base", "default": "#5d6475", "material": "stone", "swatches": ["#5d6475", "#8f97a8", "#f0ead8", "#3f5068", "#a4c44a", "#6b7280"] },
    { "id": "burst-light", "material": "light", "derive": { "rule": "mix", "of": { "rule": "ramp", "of": "metal", "tone": "light" }, "with": "shine", "amount": 0.35 } },
    { "id": "shine", "default": "#ffffff", "material": "light", "detail": true } ],
  "controls": [
    { "key": "size", "kind": "range", "label": "Size", "lo": "Small", "hi": "Big", "default": 0.5 },
    { "key": "shape", "kind": "choice", "label": "Shape", "options": ["cup", "medal", "crown"], "default": "cup" },
    { "key": "emblem", "kind": "choice", "label": "Emblem", "options": ["star", "sun", "diamond", "none"], "default": "star" },
    { "key": "sparkle", "kind": "toggle", "label": "Sparkle", "default": true },
    { "key": "metal", "kind": "colour", "label": "Metal" },
    { "key": "accent", "kind": "colour", "label": "Ribbon", "when": { "shape": ["medal"] } },
    { "key": "stone", "kind": "colour", "label": "Base", "when": { "shape": ["cup"] } },
    { "key": "bob", "kind": "range", "label": "Float", "lo": "Still", "hi": "Floaty", "default": 0.5, "group": "Motion" },
    { "key": "pop", "kind": "range", "label": "Pop height", "lo": "Low", "hi": "High", "default": 0.5, "group": "Motion" },
    { "key": "speed", "standard": "speed" } ],
  "body": { "pictures": {
    "nodes": [ { "id": "prize", "parent": null, "at": [16, 17] } ],
    "draw": [
      { "id": "trophy", "gen": "trophy", "v": 1, "on": "prize", "at": [0, 0],
        "kind": { "from": "shape", "pick": { "cup": "cup", "medal": "medal", "crown": "crown" } },
        "scale": { "from": "size", "map": [[0, 0.8], [1, 1.06]], "round": "none" },
        "emblem": { "from": "emblem", "pick": { "star": "star", "sun": "sun", "diamond": "diamond", "none": "none" } },
        "metal": "metal", "ribbon": "accent", "base": "stone", "shine": "shine" },
      { "kind": "outline", "paint": "ink" },
      { "id": "sparkle-cup", "gen": "gleam", "v": 1, "on": "prize", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["cup"] },
        "at": [ { "from": "size", "map": [[0, 7.8], [1, 10.6]], "round": "none" }, { "from": "size", "map": [[0, -5.8], [1, -8.7]], "round": "none" } ],
        "peak": 0.5, "paint": "shine", "core": "shine" },
      { "id": "sparkle-medal", "gen": "gleam", "v": 1, "on": "prize", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["medal"] },
        "at": [ { "from": "size", "map": [[0, 5.4], [1, 7.5]], "round": "none" }, { "from": "size", "map": [[0, -5.8], [1, -8.7]], "round": "none" } ],
        "peak": 0.5, "paint": "shine", "core": "shine" },
      { "id": "sparkle-crown", "gen": "gleam", "v": 1, "on": "prize", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["crown"] },
        "at": [ { "from": "size", "map": [[0, 7], [1, 9.6]], "round": "none" }, { "from": "size", "map": [[0, -5.8], [1, -8.7]], "round": "none" } ],
        "peak": 0.5, "paint": "shine", "core": "shine" } ],
    "motion": [
      { "gen": "pickup.bob", "v": 1, "clip": ["idle"], "height": { "from": "bob", "map": [[0, 0], [1, 2]] } },
      { "gen": "pickup.collect", "v": 1, "node": "prize", "clip": ["collect"], "pop": { "from": "pop", "map": [[0, 0], [1, 1]] },
        "low": { "from": "size", "map": [[0, 1.9], [1, 0.5]] }, "high": { "from": "size", "map": [[0, 4.2], [1, 1.1]] }, "room": { "from": "size", "map": [[0, 4.2], [1, 1.1]] } } ],
    "emitters": [
      { "id": "burst", "gen": "pickup.burst", "v": 1, "on": "prize", "at": [0, 0], "reach": { "from": "size", "map": [[0, 11], [1, 13.6]] },
        "sparkle": { "from": "sparkle", "pick": { "true": true, "false": false } }, "paint": "metal", "bright": "burst-light", "core": "shine" } ] } },
  "clips": {
    "idle": { "frames": 8, "fps": 10 },
    "collect": { "frames": 8, "fps": 14, "loop": false, "frameEdits": { "4": { "flash": true } },
      "keys": [ { "t": 0, "ease": "hold", "emit": { "burst": { "amount": 0 } } }, { "t": 0.6, "ease": "linear", "emit": { "burst": { "amount": 0 } } },
                { "t": 1, "emit": { "burst": { "amount": 1 } } } ],
      "sounds": [ { "sound": "star-pickup", "preset": "Storybook", "frame": 1, "volume": 0.7 } ] } },
  "versions": [
    { "name": "Gold cup", "params": {} },
    { "name": "Silver medal", "params": { "shape": "medal", "metal": "#c2c9d6" } },
    { "name": "Crown", "params": { "shape": "crown", "emblem": "diamond" } },
    { "name": "Bronze cup", "params": { "metal": "#a8806a" } },
    { "name": "Plain cup", "params": { "emblem": "none", "size": 0.3 } } ] }
