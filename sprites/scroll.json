{ "format": "loadout-sprite", "version": 2, "id": "scroll", "name": "Scroll",
  "blurb": "A floating scroll or sealed letter to collect: a quest item, a spell or a map. Change its kind, size, seal, sparkle and colours.",
  "meta": { "type": "pickup", "role": "items/key", "themes": ["neutral", "fantasy"], "gameTypes": ["top-down-rpg", "turn-based-rpg", "platformer", "arcade"], "view": "front",
            "words": ["scroll", "letter", "map", "parchment", "paper", "message", "spell", "quest", "note", "seal", "collect", "read"], "license": "draft" },
  "size": [32, 32], "pivot": [16, 30], "grounded": false, "preview": "idle", "styles": ["pixel"],
  "palette": [
    { "id": "body", "label": "Paper", "default": "#f0ead8", "material": "paint", "swatches": ["#f0ead8", "#d8d8e0", "#e0b040", "#e6c96a"] },
    { "id": "accent", "label": "Ribbon", "default": "#c9423a", "material": "cloth", "swatches": ["#c9423a", "#f2c230", "#3f6fd1", "#7a4fc4", "#e08a2c", "#4f9d57"] },
    { "id": "wood", "label": "Rods", "default": "#a06a3c", "material": "wood", "swatches": ["#a06a3c", "#7a4f33", "#a8612a", "#5a3a22", "#c98a4a", "#c2c9d6"] },
    { "id": "burst-light", "material": "light", "derive": { "rule": "mix", "of": { "rule": "ramp", "of": "body", "tone": "light" }, "with": "shine", "amount": 0.35 } },
    { "id": "shine", "default": "#ffffff", "material": "light", "detail": true } ],
  "controls": [
    { "key": "size", "kind": "range", "label": "Size", "lo": "Small", "hi": "Big", "default": 0.5 },
    { "key": "shape", "kind": "choice", "label": "Shape", "options": ["rolled", "open", "letter"], "default": "rolled" },
    { "key": "seal", "kind": "toggle", "label": "Seal", "default": true },
    { "key": "sparkle", "kind": "toggle", "label": "Sparkle", "default": true },
    { "key": "body", "kind": "colour", "label": "Paper" },
    { "key": "accent", "kind": "colour", "label": "Ribbon", "when": [{ "shape": ["rolled"] }, { "seal": [true] }] },
    { "key": "wood", "kind": "colour", "label": "Rods", "when": { "shape": ["rolled", "open"] } },
    { "key": "bob", "kind": "range", "label": "Float", "lo": "Still", "hi": "Floaty", "default": 0.5, "group": "Motion" },
    { "key": "pop", "kind": "range", "label": "Pop height", "lo": "Low", "hi": "High", "default": 0.5, "group": "Motion" },
    { "key": "speed", "standard": "speed" } ],
  "body": { "pictures": {
    "nodes": [ { "id": "scroll", "parent": null, "at": [16, 17] } ],
    "draw": [
      { "id": "paper", "gen": "scroll", "v": 1, "on": "scroll", "at": [0, { "from": "shape", "pick": { "rolled": -1, "open": -1, "letter": 0 } }],
        "kind": { "from": "shape", "pick": { "rolled": "rolled", "open": "open", "letter": "letter" } },
        "scale": { "from": "size", "map": [[0, 0.82], [1, 1.06]], "round": "none" },
        "seal": { "from": "seal", "pick": { "true": true, "false": false } },
        "paper": "body", "ribbon": "accent", "rods": "wood", "shine": "shine" },
      { "kind": "outline", "paint": "ink" },
      { "id": "sparkle-rolled", "gen": "gleam", "v": 1, "on": "scroll", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["rolled"] },
        "at": [ { "from": "size", "map": [[0, -5.3], [1, -6.9]], "round": "none" }, -1 ], "peak": 0.5, "paint": "shine", "core": "shine" },
      { "id": "sparkle-open", "gen": "gleam", "v": 1, "on": "scroll", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["open"] },
        "at": [ { "from": "size", "map": [[0, 7.8], [1, 10.7]], "round": "none" }, { "from": "size", "map": [[0, -9], [1, -11.6]], "round": "none" } ],
        "peak": 0.5, "paint": "shine", "core": "shine" },
      { "id": "sparkle-letter", "gen": "gleam", "v": 1, "on": "scroll", "clip": ["idle"], "when": { "sparkle": [true], "shape": ["letter"] },
        "at": [ { "from": "size", "map": [[0, 6.2], [1, 8.6]], "round": "none" }, { "from": "size", "map": [[0, -4.7], [1, -6.4]], "round": "none" } ],
        "peak": 0.5, "paint": "shine", "core": "shine" } ],
    "motion": [
      { "gen": "pickup.bob", "v": 1, "clip": ["idle"], "height": { "from": "bob", "map": [[0, 0], [1, 2]] } },
      { "gen": "pickup.collect", "v": 1, "node": "scroll", "clip": ["collect"], "pop": { "from": "pop", "map": [[0, 0], [1, 1]] },
        "low": { "from": "size", "map": [[0, 2], [1, 0]] }, "high": { "from": "size", "map": [[0, 4.4], [1, 0.4]] }, "room": { "from": "size", "map": [[0, 4.4], [1, 0.4]] } } ],
    "emitters": [
      { "id": "burst", "gen": "pickup.burst", "v": 1, "on": "scroll", "at": [0, 0], "reach": { "from": "size", "map": [[0, 11.2], [1, 13.6]] },
        "sparkle": { "from": "sparkle", "pick": { "true": true, "false": false } }, "paint": "body", "bright": "burst-light", "core": "shine" } ] } },
  "clips": {
    "idle": { "frames": 8, "fps": 10 },
    "collect": { "frames": 8, "fps": 14, "loop": false, "frameEdits": { "4": { "flash": true } },
      "keys": [ { "t": 0, "ease": "hold", "emit": { "burst": { "amount": 0 } } }, { "t": 0.6, "ease": "linear", "emit": { "burst": { "amount": 0 } } },
                { "t": 1, "emit": { "burst": { "amount": 1 } } } ],
      "sounds": [ { "sound": "item-get", "preset": "Storybook", "frame": 1, "volume": 0.7 } ] } },
  "versions": [
    { "name": "Sealed scroll", "params": {} },
    { "name": "Open scroll", "params": { "shape": "open", "seal": false } },
    { "name": "Letter", "params": { "shape": "letter", "accent": "#3f6fd1" } },
    { "name": "Old map", "params": { "shape": "open", "body": "#e6c96a" } },
    { "name": "Royal decree", "params": { "accent": "#f2c230", "wood": "#c2c9d6" } } ] }
