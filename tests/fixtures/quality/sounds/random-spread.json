{
 "format": "sfxpatch/0.1",
 "id": "q-random-spread",
 "name": "Random spread",
 "category": "ui",
 "description": "Test blip: Spread only widens how far each take lands from the written pitch; Fine does almost nothing.",
 "meta": {
  "type": "sfx",
  "role": "interface/click",
  "themes": [
   "neutral"
  ],
  "gameTypes": [
   "platformer"
  ],
  "words": [
   "blip",
   "beep",
   "tick",
   "tone",
   "click",
   "note"
  ],
  "license": "draft"
 },
 "duration": "length + 0.02",
 "params": [
  {
   "id": "pitch",
   "label": "Pitch",
   "min": 300,
   "max": 2000,
   "default": 800,
   "scale": "log"
  },
  {
   "id": "length",
   "label": "Length",
   "min": 0.05,
   "max": 0.3,
   "default": 0.12,
   "scale": "log"
  },
  {
   "id": "spread",
   "label": "Spread",
   "min": 0,
   "max": 1,
   "default": 0.3
  },
  {
   "id": "fine",
   "label": "Fine",
   "min": 0,
   "max": 1,
   "default": 0.5
  }
 ],
 "nodes": [
  {
   "id": "note",
   "type": "expr",
   "expr": "pitch*semi(rnd(-1, 1)*spread*12)*(1 + fine*0.004)"
  },
  {
   "id": "amp",
   "type": "ad",
   "attack": 0.001,
   "decay": "length",
   "curve": 3
  },
  {
   "id": "tone",
   "type": "osc",
   "wave": "tri",
   "freq": "note"
  }
 ],
 "out": "tone*amp"
}
