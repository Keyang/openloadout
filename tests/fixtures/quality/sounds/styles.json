{
 "format": "sfxpatch/0.1",
 "id": "q-styles",
 "name": "Styles",
 "category": "ui",
 "description": "Breaks, in its styles only: one is cut off, one is too long, one is all low end, one is too loud.",
 "meta": {
  "type": "sfx",
  "role": "interface/confirm",
  "themes": [
   "neutral"
  ],
  "gameTypes": [
   "platformer"
  ],
  "words": [
   "blip",
   "beep",
   "tick",
   "tone",
   "click",
   "note"
  ],
  "license": "draft"
 },
 "normalize": false,
 "duration": "length + 0.02",
 "params": [
  {
   "id": "pitch",
   "label": "Pitch",
   "min": 80,
   "max": 2000,
   "default": 800,
   "scale": "log"
  },
  {
   "id": "length",
   "label": "Length",
   "min": 0.1,
   "max": 3,
   "default": 0.2,
   "scale": "log"
  },
  {
   "id": "ring",
   "label": "Ring",
   "min": 0.05,
   "max": 2,
   "default": 0.15,
   "scale": "log"
  },
  {
   "id": "level",
   "label": "Level",
   "min": 0.3,
   "max": 3,
   "default": 0.6
  }
 ],
 "nodes": [
  {
   "id": "amp",
   "type": "ad",
   "attack": 0.001,
   "decay": "ring",
   "curve": 2
  },
  {
   "id": "tone",
   "type": "osc",
   "wave": "tri",
   "freq": "pitch"
  }
 ],
 "out": "tone*amp*level",
 "presets": {
  "Fine": {
   "pitch": 1200
  },
  "Cut short": {
   "ring": 2,
   "length": 0.1
  },
  "Too long": {
   "length": 3
  },
  "Boomy": {
   "pitch": 80
  },
  "Hot": {
   "level": 3
  }
 }
}
