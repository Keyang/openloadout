{
 "version": 1,
 "note": "Everyday searches, in the words a game maker who is not an artist would type, with what a person would expect to see. Written 2026-11-18, before the everyday-words table existed. 'expect' says what a right result is by its kind, type and role (a role matches itself and everything under it), so the set works for any catalogue: the real one (generated/catalog.json) and the stand-in (catalog.json). A list means any one of them. 'named' (only where role and type cannot say it, as with money) also asks for one of these words in the asset's name or words. Scored by tools/search-eval.mjs --everyday: is the first result right, is a right result in the top 5, and how many of the top 5 are right.",
 "queries": [
  { "q": "bad guy", "expect": { "kind": "sprite", "role": ["characters/enemy", "characters/boss"] } },
  { "q": "bad guys", "expect": { "kind": "sprite", "role": ["characters/enemy", "characters/boss"] } },
  { "q": "baddie", "expect": { "kind": "sprite", "role": ["characters/enemy", "characters/boss"] } },
  { "q": "villain", "expect": { "kind": "sprite", "role": ["characters/enemy", "characters/boss"] } },
  { "q": "monster", "expect": { "kind": "sprite", "role": ["characters/enemy", "characters/boss"] } },
  { "q": "enemies", "expect": { "kind": "sprite", "role": ["characters/enemy", "characters/boss"] } },
  { "q": "good guy", "expect": { "kind": "sprite", "role": "characters/player" } },
  { "q": "hero", "expect": { "kind": "sprite", "role": "characters/player" } },
  { "q": "main character", "expect": { "kind": "sprite", "role": "characters/player" } },
  { "q": "player", "expect": { "kind": "sprite", "role": "characters/player" } },
  { "q": "jumping guy", "expect": [{ "kind": "sprite", "role": "characters/player" }, { "role": "actions/jump" }] },
  { "q": "townspeople", "expect": { "kind": "sprite", "role": "characters/npc" } },
  { "q": "shopkeeper", "expect": { "kind": "sprite", "role": "characters/npc" } },
  { "q": "big boss", "expect": [{ "kind": "sprite", "role": "characters/boss" }, { "role": "music/boss" }] },
  { "q": "money", "expect": { "role": ["items/pickup", "items/icon", "interface/bar"], "named": ["coin", "credit", "gem", "gold", "money", "cash", "currency"] } },
  { "q": "cash", "expect": { "role": ["items/pickup", "items/icon", "interface/bar"], "named": ["coin", "credit", "gem", "gold", "money", "cash", "currency"] } },
  { "q": "loot", "expect": [{ "role": ["items/pickup", "items/icon", "items/key"] }, { "role": "world/chest" }, { "role": "world/prop", "named": ["chest", "treasure"] }] },
  { "q": "collectibles", "expect": { "role": ["items/pickup", "items/food", "items/key"] } },
  { "q": "floor", "expect": [{ "type": "tileset" }, { "role": "world/platform" }] },
  { "q": "ground", "expect": [{ "type": "tileset" }, { "role": "world/platform" }] },
  { "q": "wall", "expect": { "type": "tileset" } },
  { "q": "health", "expect": [{ "role": ["interface/bar", "items/food"] }, { "role": "items/pickup", "named": ["heart", "health", "life"] }, { "role": "effects/magic", "named": ["heal"] }] },
  { "q": "extra life", "expect": [{ "role": ["interface/bar", "items/food"] }, { "role": "items/pickup", "named": ["heart", "health", "life"] }] },
  { "q": "hp bar", "expect": { "role": "interface/bar" } },
  { "q": "lives", "expect": [{ "role": "interface/bar" }, { "role": "items/pickup", "named": ["heart", "health", "life"] }] },
  { "q": "win music", "expect": { "role": ["music/victory", "interface/reward"] } },
  { "q": "fight music", "expect": { "role": ["music/battle", "music/boss"] } },
  { "q": "background music", "expect": { "kind": "music" } },
  { "q": "boom", "expect": { "role": "effects/explosion" } },
  { "q": "gun", "expect": { "role": ["effects/projectile", "actions/shoot", "items/weapon"] } },
  { "q": "bullet", "expect": { "role": ["effects/projectile", "actions/shoot"] } },
  { "q": "footsteps", "expect": { "role": "characters/footstep" } },
  { "q": "walking sound", "expect": { "role": "characters/footstep" } },
  { "q": "ouch", "expect": { "role": ["characters/hurt", "actions/hit"] } },
  { "q": "dying sound", "expect": { "kind": "sound", "role": "characters/death" } },
  { "q": "trap", "expect": { "role": "world/hazard" } },
  { "q": "danger", "expect": { "role": "world/hazard" } },
  { "q": "house", "expect": { "role": "world/building" } },
  { "q": "sky", "expect": { "type": "background" } },
  { "q": "scenery", "expect": { "type": "background" } },
  { "q": "button sound", "expect": { "role": ["interface/click", "interface/confirm", "interface/hover"] } },
  { "q": "menu window", "expect": { "role": "interface/panel" } },
  { "q": "mouse pointer", "expect": { "role": "interface/cursor" } },
  { "q": "spell", "expect": { "role": ["effects/magic", "actions/cast"] } },
  { "q": "unlock", "expect": [{ "role": ["items/key", "world/door"] }, { "role": "world/prop", "named": ["chest", "lever"] }] }
 ]
}
