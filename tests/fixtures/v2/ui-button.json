{ "format": "loadout-sprite", "version": 2, "id": "ui-buttons-wood", "name": "Wooden button", "blurb": "A carved wooden button with four states.", "size": [96, 32], "pivot": [48, 16], "grounded": false,
  "meta": { "type": "ui", "role": "interface/button", "view": "none", "themes": ["fantasy"], "gameTypes": ["turn-based-rpg"], "words": ["button", "wood", "menu", "press", "wooden", "click", "interface"], "license": "draft" },
  "palette": [ { "id": "face", "label": "Face", "default": "#a0703c", "material": "wood" },
               { "id": "frame", "label": "Frame", "default": "#5a3a22", "material": "wood" } ],
  "controls": [ { "key": "style", "kind": "choice", "label": "Look", "options": ["plain", "framed", "carved"], "default": "framed" },
                { "key": "corner", "kind": "range", "label": "Corners", "lo": "Square", "hi": "Round", "default": 0.5 },
                { "key": "border", "kind": "range", "label": "Border", "lo": "Thin", "hi": "Thick", "default": 0.5 },
                { "key": "nails", "kind": "toggle", "label": "Nails", "default": true },
                { "key": "texture", "kind": "range", "label": "Grain", "lo": "Smooth", "hi": "Rough", "default": 0.5 } ],
  "body": { "panel": { "skin": { "use": "skin:wood", "v": 1, "paint": { "face": "face", "frame": "frame" } },
    "piece": { "gen": "ui.button", "v": 1, "size": [96, 32], "style": { "from": "style" }, "corner": { "from": "corner", "map": [[0, 1], [1, 4]] },
               "border": { "from": "border", "map": [[0, 1], [1, 3]] }, "nails": { "from": "nails" }, "grain": { "from": "texture", "map": [[0, 0], [1, 1]] } },
    "states": ["normal", "hover", "pressed", "disabled"] } },
  "clips": { "pressed": { "sounds": [{ "sound": "ui-click", "preset": "Soft tap", "frame": 0, "volume": 0.6 }] } },
  "slice": { "left": 6, "top": 6, "right": 6, "bottom": 6 },
  "textArea": { "x": 8, "y": 8, "w": 80, "h": 16, "colour": "frame.dark" } }
