{ "format": "loadout-sprite", "version": 2, "id": "ui-bars-flat", "name": "Flat bars and slider",
  "blurb": "A flat, unlit bar housing with three fill strips (health, magic, a gauge), a white flash, a slider track and its knob; change the style, corners, edge, notches and colours.",
  "size": [64, 16], "pivot": [32, 8], "grounded": false, "preview": "frame",
  "meta": { "type": "ui", "role": "interface/bar", "view": "none", "themes": ["neutral", "city"], "gameTypes": ["arcade", "puzzle", "card-game", "racing"],
            "words": ["bar", "health", "progress", "gauge", "meter", "slider", "volume", "settings", "flat", "modern", "fill", "flash", "hud", "loading"], "license": "draft" },
  "palette": [ { "id": "frame", "label": "Edge", "default": "#f0ead8", "material": "paint", "swatches": ["#f0ead8", "#8fd0f0", "#9bd18a", "#c2c9d6", "#f6d3b0"] },
               { "id": "fill", "label": "Health", "default": "#6aa83e", "material": "paint", "swatches": ["#6aa83e", "#3f8a4f", "#c9423a", "#e08a2c", "#4fd8ee", "#f2c230"] },
               { "id": "fillB", "label": "Magic", "default": "#3f6fd1", "material": "paint", "swatches": ["#3f6fd1", "#3f9fd1", "#4fd8ee", "#8fd0f0", "#4f9ff0"] },
               { "id": "fillC", "label": "Gauge", "default": "#f2c230", "material": "paint", "swatches": ["#f2c230", "#e08a2c", "#a4c44a", "#a06a3c", "#c2c9d6"] } ],
  "controls": [ { "key": "style", "kind": "choice", "label": "Style", "options": ["solid", "outline", "pill"], "default": "solid", "group": "Look" },
                { "key": "corner", "kind": "range", "label": "Corner", "lo": "Square", "hi": "Round", "default": 0.5, "group": "Look", "when": { "style": ["solid", "outline"] } },
                { "key": "border", "kind": "range", "label": "Border", "lo": "Thin", "hi": "Thick", "default": 0.5, "group": "Look" },
                { "key": "notches", "kind": "toggle", "label": "Notches", "default": false, "group": "Look" } ],
  "versions": [ { "name": "Flat bars", "params": {} }, { "name": "Pill", "params": { "style": "pill" } },
                { "name": "Notched", "params": { "notches": true, "frame": "#c2c9d6" } }, { "name": "Outline sky", "params": { "style": "outline", "frame": "#8fd0f0", "border": 1 } } ],
  "body": { "panel": {
    "skin": { "use": "skin:flat", "v": 1, "paint": { "frame": "frame" } },
    "piece": { "gen": "ui.bar", "v": 1, "clip": ["frame"], "at": [1, 1], "size": [62, 14], "style": { "from": "style" },
               "corner": { "from": "corner", "map": [[0, 0], [1, 4]] }, "border": { "from": "border", "map": [[0, 1], [1, 3]] }, "notches": { "from": "notches" } },
    "states": ["frame", "fill", "fill-b", "fill-c", "flash", "slider", "knob"],
    "draw": [
      { "gen": "ui.bar", "v": 1, "clip": ["fill"], "layer": "fill", "at": [1, 1], "size": [62, 14], "border": { "from": "border", "map": [[0, 1], [1, 3]] }, "fill": "fill" },
      { "gen": "ui.bar", "v": 1, "clip": ["fill-b"], "layer": "fill", "at": [1, 1], "size": [62, 14], "border": { "from": "border", "map": [[0, 1], [1, 3]] }, "fill": "fillB" },
      { "gen": "ui.bar", "v": 1, "clip": ["fill-c"], "layer": "fill", "at": [1, 1], "size": [62, 14], "border": { "from": "border", "map": [[0, 1], [1, 3]] }, "fill": "fillC" },
      { "gen": "ui.bar", "v": 1, "clip": ["flash"], "layer": "fill", "at": [1, 1], "size": [62, 14], "border": { "from": "border", "map": [[0, 1], [1, 3]] }, "fill": "fill", "flash": 1, "fade": true },
      { "gen": "ui.slider", "v": 1, "clip": ["slider"], "at": [1, 1], "size": [62, 14], "style": { "from": "style" },
        "corner": { "from": "corner", "map": [[0, 0], [1, 4]] }, "notches": { "from": "notches" } },
      { "gen": "ui.knob", "v": 1, "clip": ["knob"], "at": [32, 8], "size": 12, "style": { "from": "style" }, "corner": { "from": "corner", "map": [[0, 0], [1, 4]] } } ] } },
  "clips": { "frame": { "frames": 1, "fps": 8, "label": "Housing" }, "fill": { "frames": 1, "fps": 8, "label": "Health" }, "fill-b": { "frames": 1, "fps": 8, "label": "Magic" },
             "fill-c": { "frames": 1, "fps": 8, "label": "Gauge" }, "flash": { "frames": 4, "fps": 8, "loop": false }, "slider": { "frames": 1, "fps": 8, "label": "Slider track" },
             "knob": { "frames": 1, "fps": 8, "label": "Slider knob" } },
  "made": { "in": "library", "from": "code:ui-bars-flat" } }
