{ "format": "loadout-sprite", "version": 2, "id": "skinned-pieces", "name": "Skinned pieces",
  "blurb": "Every skinned piece of migration batch M8 in one candy panel body: a button in its states, a bar, a check box, a radio option, a switch, a pointer and a selector.",
  "size": [96, 32], "pivot": [48, 16], "grounded": false, "preview": "normal",
  "meta": { "type": "ui", "role": "interface/button", "view": "none", "themes": ["neutral"], "gameTypes": ["arcade"], "words": ["button", "test", "skin", "candy", "bar", "switch", "pointer"], "license": "draft" },
  "palette": [ { "id": "face", "label": "Candy", "default": "#7a4f33", "material": "interface" },
               { "id": "frame", "label": "Sugar", "default": "#f0ead8", "material": "interface" },
               { "id": "accent", "label": "Sprinkles", "default": "#4fd8ee", "material": "interface" },
               { "id": "fill", "label": "Health", "default": "#6aa83e", "material": "interface" },
               { "id": "white", "default": "#ffffff", "material": "light", "detail": true } ],
  "controls": [ { "key": "style", "kind": "choice", "label": "Style", "options": ["jelly", "striped", "frosted"], "default": "jelly" },
                { "key": "corner", "kind": "range", "label": "Corner", "lo": "Square", "hi": "Round", "default": 0.75 },
                { "key": "sprinkles", "kind": "toggle", "label": "Sprinkles", "default": true },
                { "key": "speed", "standard": "speed" } ],
  "body": { "panel": {
    "skin": { "use": "skin:candy", "v": 1, "paint": { "face": "face", "frame": "frame", "accent": "accent", "fill": "fill", "shine": "white" } },
    "piece": { "gen": "ui.slab", "v": 1, "clip": ["normal", "hover", "pressed", "disabled"], "role": "button", "at": [1, 1], "size": [94, 30],
               "style": { "from": "style" }, "corner": { "from": "corner", "map": [[0, 0], [1, 4]] }, "extras": { "from": "sprinkles" } },
    "states": ["normal", "hover", "pressed", "disabled", "frame", "fill", "check-on", "radio-on", "switch-on", "switch-off", "pointer", "selector"],
    "draw": [
      { "gen": "ui.trough", "v": 1, "clip": ["frame"], "at": [1, 9], "size": [62, 14], "style": { "from": "style" }, "extras": { "from": "sprinkles" } },
      { "gen": "ui.strip", "v": 1, "clip": ["fill"], "at": [1, 9], "size": [62, 14], "style": { "from": "style" }, "fill": "fill", "glint": true },
      { "gen": "ui.toggle", "v": 1, "clip": ["check-on"], "kind": "check", "at": [16, 16], "style": { "from": "style" } },
      { "gen": "ui.toggle", "v": 1, "clip": ["radio-on"], "kind": "radio", "at": [16, 16], "style": { "from": "style" } },
      { "gen": "ui.toggle", "v": 1, "clip": ["switch-on"], "kind": "switch", "size": 28, "at": [16, 16], "style": { "from": "style" } },
      { "gen": "ui.toggle", "v": 1, "clip": ["switch-off"], "kind": "switch", "size": 28, "checked": false, "at": [16, 16], "style": { "from": "style" } },
      { "gen": "ui.pointer", "v": 1, "clip": ["pointer"], "at": [4, 16], "len": 20, "style": { "from": "style" } },
      { "gen": "ui.selector", "v": 1, "clip": ["selector"], "at": [1, 1], "size": [30, 30], "style": { "from": "style" } } ] } },
  "clips": { "normal": { "frames": 1, "fps": 8 }, "hover": { "frames": 1, "fps": 8 }, "pressed": { "frames": 1, "fps": 8 }, "disabled": { "frames": 1, "fps": 8 },
             "frame": { "frames": 1, "fps": 8 }, "fill": { "frames": 1, "fps": 8 }, "check-on": { "frames": 1, "fps": 8 }, "radio-on": { "frames": 1, "fps": 8 },
             "switch-on": { "frames": 1, "fps": 8 }, "switch-off": { "frames": 1, "fps": 8 }, "pointer": { "frames": 8, "fps": 8 }, "selector": { "frames": 8, "fps": 8 } } }
