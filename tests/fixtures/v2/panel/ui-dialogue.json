{ "format": "loadout-sprite", "version": 2, "id": "ui-dialogue", "name": "Dialogue box",
  "blurb": "A stretchable speech box with a name tag, a choice box and a bobbing \"more\" arrow; change its style, corners, border and colours.",
  "size": [96, 48], "pivot": [48, 24], "grounded": false, "preview": "box",
  "meta": { "type": "ui", "role": "interface/panel", "view": "none", "themes": ["fantasy", "neutral"], "gameTypes": ["turn-based-rpg", "top-down-rpg", "arcade"],
            "words": ["dialogue", "dialog", "speech", "textbox", "talk", "message", "conversation", "choice", "name", "window", "panel", "story"], "license": "draft" },
  "palette": [ { "id": "face", "label": "Face", "default": "#4a609c", "material": "paint", "swatches": ["#4a609c", "#5a5f7a", "#8e3a4a", "#6541b9", "#19708e"] },
               { "id": "frame", "label": "Frame", "default": "#f0ead8", "material": "paint", "swatches": ["#f0ead8", "#f6d3b0", "#c9d2dd", "#fdf277", "#a7e5fa"] },
               { "id": "accent", "label": "Accent", "default": "#f2c230", "material": "paint", "swatches": ["#f2c230", "#c9423a", "#f0ead8", "#7fe0a0", "#4fd8ee", "#c8553a"] } ],
  "controls": [ { "key": "style", "kind": "choice", "label": "Style", "options": ["plain", "ornate", "scroll"], "default": "plain", "group": "Look" },
                { "key": "corner", "kind": "range", "label": "Corner", "lo": "Square", "hi": "Round", "default": 0.5, "group": "Look" },
                { "key": "border", "kind": "range", "label": "Border", "lo": "Thin", "hi": "Thick", "default": 0.5, "group": "Look" },
                { "key": "shadow", "kind": "toggle", "label": "Shadow", "default": false, "group": "Look" },
                { "key": "speed", "standard": "speed" } ],
  "body": { "panel": {
    "skin": { "use": "skin:plain", "v": 1, "paint": { "face": "face", "frame": "frame", "accent": "accent" } },
    "piece": { "gen": "ui.panel", "v": 1, "clip": ["box"], "at": [1, 1], "size": [94, 46], "style": { "from": "style" },
               "corner": { "from": "corner", "map": [[0, 0], [1, 4]] }, "border": { "from": "border", "map": [[0, 1], [1, 3]] }, "shadow": { "from": "shadow" } },
    "states": ["box", "name-tag", "choice", "next"],
    "draw": [
      { "gen": "ui.panel", "v": 1, "clip": ["choice"], "at": [1, 1], "size": [94, 46], "style": { "from": "style" }, "row": true,
        "corner": { "from": "corner", "map": [[0, 0], [1, 4]] }, "border": { "from": "border", "map": [[0, 1], [1, 3]] }, "shadow": { "from": "shadow" } },
      { "gen": "ui.panel", "v": 1, "clip": ["name-tag"], "at": [20, 14], "size": [56, 20], "style": { "from": "style" },
        "corner": { "from": "corner", "map": [[0, 0], [1, 4]] }, "border": { "from": "border", "map": [[0, 1], [1, 3]] }, "shadow": { "from": "shadow" } },
      { "gen": "ui.arrow", "v": 1, "clip": ["next"], "at": [48, 23], "size": 9, "bob": 2, "paint": "accent" } ] } },
  "slice": { "choice": { "left": 12, "top": 24, "right": 12, "bottom": 8 } },
  "clips": { "box": { "frames": 1, "fps": 8 }, "name-tag": { "frames": 1, "fps": 8, "label": "Name tag" }, "choice": { "frames": 1, "fps": 8 },
             "next": { "frames": 8, "fps": 8, "loop": true, "label": "More text" } },
  "made": { "in": "library", "from": "code:ui-dialogue" } }
