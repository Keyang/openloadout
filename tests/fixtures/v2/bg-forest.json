{ "format": "loadout-sprite", "version": 2, "id": "bg-forest", "name": "Forest backdrop", "blurb": "Mountains, hills and trees in three layers.", "size": [320, 180], "pivot": [160, 180],
  "meta": { "type": "background", "role": "environment/background", "view": "side", "themes": ["forest"], "gameTypes": ["platformer"], "words": ["forest", "mountains", "sky", "backdrop", "trees", "hills", "parallax"], "license": "draft" },
  "palette": [ { "id": "sky", "label": "Sky", "default": "#7fb8e0", "material": "sky" },
               { "id": "cloud", "label": "Clouds", "default": "#f0f4f8", "material": "sky" },
               { "id": "rock", "label": "Mountains", "default": "#6a7280", "material": "stone" },
               { "id": "air", "label": "Haze", "default": "#c8d8e8", "material": "sky" },
               { "id": "back", "label": "Hills", "default": "#4a7a4a", "material": "plant" },
               { "id": "leaf", "label": "Trees", "default": "#2f5a32", "material": "plant" } ],
  "controls": [ { "key": "time", "kind": "range", "label": "Time of day", "lo": "Dawn", "hi": "Dusk", "default": 0.5 },
                { "key": "clouds", "kind": "range", "label": "Clouds", "lo": "Few", "hi": "Many", "default": 0.5 },
                { "key": "height", "kind": "range", "label": "Mountains", "lo": "Low", "hi": "High", "default": 0.5 },
                { "key": "haze", "kind": "range", "label": "Haze", "lo": "Clear", "hi": "Misty", "default": 0.3 },
                { "key": "density", "kind": "range", "label": "Trees", "lo": "Sparse", "hi": "Dense", "default": 0.5 } ],
  "body": { "layers": [
    { "name": "far", "scroll": 0.1, "draw": [
      { "gen": "sky.bands", "v": 1, "paint": { "rule": "sky.look", "v": 1, "of": "sky", "time": { "from": "time" } }, "bands": 6 },
      { "gen": "scatter", "v": 1, "seed": 12, "stable": true, "count": { "from": "clouds", "map": [[0, 2], [1, 8]], "round": "px" },
        "place": { "gen": "cloud", "v": 1, "paint": "cloud" }, "rows": [14, 59] },
      { "gen": "ridge", "v": 1, "base": 156, "height": { "from": "height", "map": [[0, 44], [1, 84]] }, "seed": 3, "peaks": 4, "shape": "jagged", "rough": 0.55, "paint": "rock", "litEdge": { "depth": 0.75, "paint": "rock.light" } },
      { "gen": "mist.band", "v": 1, "at": 156, "height": { "from": "haze", "map": [[0, 0], [1, 14]] }, "paint": "air" } ] },
    { "name": "mid", "scroll": 0.4, "draw": [ { "gen": "ridge", "v": 1, "id": "hill", "base": 150, "seed": 7, "peaks": 3, "paint": "back" },
      { "gen": "treeline", "v": 1, "on": "hill", "clumps": { "from": "density", "map": [[0, 4], [1, 11]], "round": "px" }, "tall": 12, "seed": 4, "paint": "leaf" } ] } ] } }
