{ "about": "A stand-in for the generator registry (engine/gen/registry.js, build item B2) for the format v2 validator's tests: each entry is { id, v, family, args: { name: type }, cost: { base, per? } }; registry.mjs turns it into the registry interface catalog/sprite-schema.js reads. Arg types follow docs/data-sprites.md 3.1.",
  "generators": [
    { "id": "scatter", "v": 1, "family": "place", "cost": { "base": 1, "per": "count" },
      "args": { "seed": { "type": "seed" }, "count": { "type": "count", "lo": 0, "hi": 64 }, "stable": { "type": "flag", "optional": true },
                "margin": { "type": "px", "lo": 0, "hi": 64, "optional": true }, "gap": { "type": "px", "lo": 0, "hi": 64, "optional": true },
                "rows": { "type": "point", "lo": 0, "hi": 360, "optional": true }, "place": { "type": "place" } } },
