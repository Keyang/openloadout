{ "format": "loadout-sprite", "version": 2, "id": "coin", "name": "Coin", "blurb": "A spinning gold coin.", "size": [32, 32], "pivot": [16, 30], "grounded": false,
  "meta": { "type": "pickup", "role": "items/pickup", "view": "front", "themes": ["fantasy"], "gameTypes": ["platformer"], "words": ["coin", "gold", "money", "collect", "coins", "treasure", "pickup"], "license": "draft" },
  "styles": ["pixel"],
  "palette": [ { "id": "gold", "label": "Gold", "default": "#e8b23a", "material": "metal" },
               { "id": "light", "label": "Shine", "default": "#fff4c0", "material": "light" } ],
  "controls": [ { "key": "size", "kind": "range", "label": "Size", "lo": "Small", "hi": "Big", "default": 0.5 },
                { "key": "shine", "kind": "toggle", "label": "Shine", "default": true },
                { "key": "bob", "kind": "range", "label": "Bob", "lo": "Still", "hi": "Bouncy", "default": 0.5 },
                { "key": "speed", "standard": "speed" } ],
  "body": { "pictures": {
    "nodes": [ { "id": "coin", "parent": null, "at": [16, 15] } ],
    "draw": [ { "id": "face", "kind": "ellipse", "on": "coin", "at": [0, 0], "r": [{ "from": "size", "map": [[0, 5], [1, 8]] }, { "from": "size", "map": [[0, 5], [1, 8]] }], "paint": "gold", "shade": 1, "light": 1 },
              { "id": "mark", "kind": "stamp", "on": "coin", "at": [-1, -2], "rows": ["ab", "b."], "key": { "a": "gold.light", "b": "gold.dark" } },
              { "kind": "outline", "paint": "ink" },
              { "gen": "glint", "v": 1, "on": "coin", "every": 8, "paint": "light", "when": { "shine": [true] } } ],
    "motion": [ { "gen": "pickup.bob", "v": 1, "height": { "from": "bob", "map": [[0, 0], [1, 2]] } },
                { "gen": "pickup.spin", "v": 1, "node": "coin", "clip": ["spin"] } ],
    "emitters": [ { "id": "burst", "gen": "spark.ring", "v": 1, "at": [16, 15], "paints": ["gold.light", "gold"], "glow": true } ] } },
  "clips": { "spin": { "frames": 8, "fps": 10 },
             "collect": { "frames": 6, "fps": 12, "loop": false, "keys": [ { "t": 0, "emit": { "burst": { "amount": 1 } } } ], "sounds": [{ "sound": "coin-pickup", "frame": 0 }] } },
  "preview": "spin" }
