{
  "format": "sfxpatch/0.1",
  "id": "menu-harp-confirm",
  "name": "Harp confirm",
  "category": "ui",
  "description": "Choosing an item: two plucked strings sounded together, then the upper one plucked again a small step higher and a little softer while the lower one still rings, the same every time. Change its pitch, speed, brightness and how much of the hollow wooden soundbox is heard.",
  "meta": {
    "type": "sfx",
    "role": "interface/confirm",
    "themes": ["neutral", "fantasy"],
    "gameTypes": ["arcade", "card-game", "turn-based-rpg", "farming-sim", "puzzle"],
    "words": ["menu", "confirm", "select", "accept", "choose", "ok", "start", "harp", "plucked", "string", "strum", "button", "yes"],
    "license": "draft"
  },
  "duration": "0.09 + 2.33 / speed",
  "params": [
    { "id": "pitch", "label": "Pitch", "unit": "Hz", "min": 220, "max": 520, "default": 330, "scale": "log" },
    { "id": "speed", "label": "Speed", "unit": "notes/s", "min": 5, "max": 14, "default": 9 },
    { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.5 },
    { "id": "body", "label": "Soundbox", "min": 0, "max": 1, "default": 0.5 }
  ],
  "nodes": [
    { "id": "tickA", "type": "ad", "attack": 0.0003, "decay": 0.002, "curve": 2 },
    { "id": "again", "type": "clock", "rate": 1, "count": 1, "delay": "1 / speed" },
    { "id": "tickB", "type": "ad", "attack": 0.0003, "decay": 0.002, "curve": 2, "trig": "again" },
    { "id": "fingerA", "type": "filter", "mode": "lp", "in": "tickA", "freq": "1400 + bright * 3600", "q": 0.6 },
    { "id": "fingerB", "type": "filter", "mode": "lp", "in": "tickA * 0.9 + tickB * 0.7", "freq": "1400 + bright * 3600", "q": 0.6 },
    { "id": "upper", "type": "env", "points": [[0, "pitch * semi(5)"], ["1 / speed", "pitch * semi(5)", "hold"], ["1 / speed + 0.0001", "pitch * semi(7)", "hold"]] },
    { "id": "home", "type": "pluck", "freq": "pitch", "decay": "0.3 + 5.4 / speed", "damp": "0.5 - bright * 0.15", "in": "fingerA", "trig": 0 },
    { "id": "top", "type": "pluck", "freq": "upper", "decay": "0.2 + 3.2 / speed", "damp": "0.5 - bright * 0.15", "in": "fingerB", "trig": 0 },
    { "id": "strings", "type": "expr", "expr": "home + top" },
    { "id": "boxLow", "type": "filter", "mode": "bp", "in": "strings", "freq": 230, "q": 1.4 },
    { "id": "boxHigh", "type": "filter", "mode": "bp", "in": "strings", "freq": 470, "q": 1.4 },
    { "id": "sum", "type": "expr", "expr": "strings * (1 - body * 0.35) + (boxLow + boxHigh * 0.8) * body * 1.6" },
    { "id": "fade", "type": "env", "points": [[0, 1], ["0.04 + 1.9 / speed", 1], ["0.09 + 2.33 / speed", 0]] },
    { "id": "clean", "type": "filter", "mode": "hp", "in": "sum * fade", "freq": 70 }
  ],
  "out": "clean",
  "presets": {
    "Select": { "pitch": 392, "speed": 12, "bright": 0.45, "body": 0.4 },
    "Accept": { "pitch": 330, "speed": 9, "bright": 0.5, "body": 0.5 },
    "Start game": { "pitch": 262, "speed": 6, "bright": 0.65, "body": 0.7 }
  }
}
