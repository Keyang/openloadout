{
  "format": "sfxpatch/0.1",
  "id": "critical-hit",
  "name": "Critical hit",
  "category": "impact",
  "description": "A big, hard crunch with a bright glancing ping right after it, for a critical or finishing blow. Change its weight, length, brightness, crunch and ping.",
  "meta": { "type": "sfx", "role": "actions/hit", "themes": ["neutral", "fantasy", "sci-fi"], "gameTypes": ["turn-based-rpg", "top-down-rpg", "platformer", "arcade", "roguelike-action"],
    "words": ["critical", "crit", "hit", "finisher", "finishing blow", "weak point", "smash", "crunch", "impact", "damage", "bonus damage", "ping", "strike"], "license": "draft" },
  "duration": "length",
  "params": [
    { "id": "weight", "label": "Weight", "min": 0.5, "max": 2, "default": 1 },
    { "id": "length", "label": "Length", "unit": "s", "min": 0.2, "max": 0.6, "default": 0.35, "scale": "log" },
    { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.55 },
    { "id": "crunch", "label": "Crunch", "min": 0, "max": 1, "default": 0.6 },
    { "id": "ping", "label": "Ping", "min": 0, "max": 1, "default": 0.5 }
  ],
  "nodes": [
    { "id": "drop", "type": "env", "points": [[0, "200 / weight * rnd(0.93, 1.07)"], ["0.05 + length * 0.12", "50 / pow(weight, 0.5)", "exp"]] },
    { "id": "thump", "type": "osc", "freq": "drop", "phase": 0.25 },
    { "id": "thumpAmp", "type": "ad", "attack": 0.001, "hold": 0.01, "decay": "length * 0.7 * (0.6 + weight * 0.4)", "curve": 2.6 },
    { "id": "thumpSat", "type": "shaper", "in": "thump * thumpAmp", "drive": "1.6 + crunch * 3", "mode": "tanh" },
    { "id": "n", "type": "noise" },
    { "id": "crackBand", "type": "filter", "mode": "bp", "in": "n", "freq": "(1400 + bright * 1300) * rnd(0.9, 1.1) / pow(weight, 0.3)", "q": 0.9 },
    { "id": "crackAmp", "type": "ad", "attack": 0.0004, "decay": "0.03 + length * 0.1 + crunch * 0.03", "curve": 2.6 },
    { "id": "crack", "type": "shaper", "in": "crackBand * crackAmp", "drive": "2 + crunch * 14", "mode": "clip" },
    { "id": "gritBand", "type": "filter", "mode": "bp", "in": "n", "freq": "520 / pow(weight, 0.5) + 150", "q": 0.8 },
    { "id": "gritAmp", "type": "ad", "attack": 0.001, "decay": "0.05 + length * 0.5", "curve": 2 },
    { "id": "hit", "type": "shaper", "in": "thumpSat * 0.4 + gritBand * gritAmp * (0.5 + crunch * 1.2)", "drive": "1.3 + crunch * 1.5", "mode": "tanh" },
    { "id": "pingAt", "type": "clock", "rate": 1, "count": 1, "delay": 0.03 },
    { "id": "pingAmp", "type": "ad", "attack": 0.001, "decay": "length * 0.95 - 0.03", "curve": 1.5, "trig": "pingAt" },
    { "id": "pingLow", "type": "osc", "freq": "2900 + bright * 500" },
    { "id": "pingHigh", "type": "osc", "freq": "(2900 + bright * 500) * 1.43" },
    { "id": "glance", "type": "expr", "expr": "(pingLow * 0.6 + pingHigh * 0.45 * pingAmp) * pingAmp" },
    { "id": "clean", "type": "filter", "mode": "hp", "in": "hit * 0.8 + crack * (0.45 + crunch * 0.5) + glance * (0.1 + ping * 0.9)", "freq": 30 }
  ],
  "out": "clean",
  "presets": {
    "Critical hit": { "weight": 1, "length": 0.35, "ping": 0.5 },
    "Finishing blow": { "weight": 1.7, "length": 0.5, "crunch": 0.75 },
    "Weak point": { "weight": 0.65, "length": 0.28, "ping": 0.9 }
  }
}
