{
  "format": "sfxpatch/0.1",
  "id": "elite-howl",
  "name": "Elite howl",
  "category": "impact",
  "description": "A made-up voice from inside an iron helmet: two rough buzzing tones that slide together, with a rattle in the throat. Change its pitch, length, how far it glides up or down, its grit and its growl.",
  "meta": { "type": "sfx", "role": "characters/voice", "themes": ["fantasy", "dungeon"], "gameTypes": ["roguelike-action", "platformer"],
    "words": ["howl", "growl", "snarl", "roar", "elite", "champion", "knight", "helmet", "enemy", "voice", "enrage", "war cry", "death cry", "chiptune"], "license": "draft" },
  "duration": "length",
  "params": [
    { "id": "pitch", "label": "Pitch", "unit": "Hz", "min": 90, "max": 300, "default": 150, "scale": "log" },
    { "id": "length", "label": "Length", "unit": "s", "min": 0.4, "max": 1.4, "default": 0.8, "scale": "log" },
    { "id": "rise", "label": "Glide", "unit": "semitones", "min": -12, "max": 7, "default": -5 },
    { "id": "grit", "label": "Grit", "min": 0, "max": 1, "default": 0.5 },
    { "id": "growl", "label": "Growl", "min": 0, "max": 1, "default": 0.6 }
  ],
  "nodes": [
    { "id": "rp", "type": "rand", "lo": 0.97, "hi": 1.03 },
    { "id": "rs", "type": "rand", "lo": 0.94, "hi": 1.06 },
    { "id": "glide", "type": "env", "points": [[0, "pitch"], ["length * 0.3", "pitch * semi(rise * 0.7)", "exp"], ["length * 0.97", "pitch * semi(rise)", "exp"]] },
    { "id": "f0", "type": "expr", "expr": "glide * rp" },
    { "id": "va", "type": "osc", "wave": "pulse", "width": 0.3, "freq": "f0" },
    { "id": "vb", "type": "osc", "wave": "pulse", "width": 0.3, "freq": "f0 * 1.5" },
    { "id": "shake", "type": "osc", "wave": "tri", "phase": 0.75, "freq": "(25 + growl * 20) * rs" },
    { "id": "throat", "type": "expr", "expr": "(va + vb * 0.8) * (1 - growl * 0.9 * (0.5 + 0.5 * shake))" },
    { "id": "helmA", "type": "filter", "mode": "bp", "in": "throat", "freq": 700, "q": 2.2 },
    { "id": "helmB", "type": "filter", "mode": "bp", "in": "throat", "freq": 1800, "q": 2.8 },
    { "id": "helm", "type": "expr", "expr": "(helmA + helmB * 1.1) * 0.2" },
    { "id": "iron", "type": "crush", "in": "helm", "bits": "9 - grit * 6", "rate": "14000 - grit * 10000" },
    { "id": "amp", "type": "env", "points": [[0, 0.3], [0.03, 1], ["length * 0.66", 0.85], ["length * 0.97", 0, 1.5]] },
    { "id": "clean", "type": "filter", "mode": "hp", "in": "iron * amp", "freq": 60 },
    { "id": "room", "type": "reverb", "in": "clean", "size": 0.4, "damp": 0.5, "mix": 0.1 },
    { "id": "fin", "type": "env", "points": [[0, 1], ["length * 0.92", 1], ["length * 0.999", 0]] }
  ],
  "out": "room * fin",
  "presets": {
    "Elite appears": {},
    "Enrage": { "rise": 5, "length": 0.55, "growl": 0.9, "pitch": 190 },
    "Elite falls": { "rise": -12, "length": 1.3, "growl": 0.3, "grit": 0.3 }
  }
}
