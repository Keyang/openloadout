{
  "format": "sfxpatch/0.1",
  "id": "menu-harp-open",
  "name": "Harp open",
  "category": "ui",
  "description": "A panel appearing: a finger swept quickly up across a few plucked strings, landing on the top note, which rings over a small chord, the same every time. Change its pitch, length, brightness and how many strings are swept.",
  "meta": {"type":"sfx","role":"interface/click","themes":["neutral","fantasy"],"gameTypes":["arcade","card-game","turn-based-rpg","farming-sim","puzzle"],"words":["menu","open","panel","window","popup","inventory","harp","plucked","string","strum","sweep","appear","gentle"],"license":"draft"},
  "duration": "length + 0.01",
  "params": [
    {"id":"pitch","label":"Pitch","unit":"Hz","min":220,"max":520,"default":330,"scale":"log"},
    {"id":"length","label":"Length","unit":"s","min":0.18,"max":0.5,"default":0.3,"scale":"log"},
    {"id":"bright","label":"Brightness","min":0,"max":1,"default":0.55},
    {"id":"strings","label":"Strings","min":3,"max":7,"default":5,"step":2}
  ],
  "nodes": [
    {"id":"finger","type":"noise","color":"white","seed":11},
    {"id":"pad","type":"filter","mode":"lp","in":"finger","freq":"1400 + bright * 3600","q":0.6},
    {"id":"slack","type":"expr","expr":"((0.58 - bright * 0.3) / (0.42 + bright * 0.3) - 0.5) / sr"},
    {"id":"go0","type":"clock","rate":1,"count":"strings > 0 ? 1 : 0","delay":"(strings - 1 - 0) / (strings - 1) * length * 0.6"},
    {"id":"tick0","type":"ad","attack":0.0003,"decay":0.0022,"curve":1.5,"trig":"go0"},
    {"id":"str0","type":"pluck","freq":"pitch / (1 - pitch * slack)","decay":"length * 1.1 + 0.05","damp":"0.58 - bright * 0.3","in":"pad * tick0","trig":0},
    {"id":"go1","type":"clock","rate":1,"count":"strings > 1 ? 1 : 0","delay":"(strings - 1 - 1) / (strings - 1) * length * 0.6"},
    {"id":"tick1","type":"ad","attack":0.0003,"decay":0.0022,"curve":1.5,"trig":"go1"},
    {"id":"str1","type":"pluck","freq":"pitch * semi(-3) / (1 - pitch * semi(-3) * slack)","decay":"length * 0.9 + 0.1","damp":"0.58 - bright * 0.3","in":"pad * tick1","trig":0},
    {"id":"go2","type":"clock","rate":1,"count":"strings > 2 ? 1 : 0","delay":"(strings - 1 - 2) / (strings - 1) * length * 0.6"},
    {"id":"tick2","type":"ad","attack":0.0003,"decay":0.0022,"curve":1.5,"trig":"go2"},
    {"id":"str2","type":"pluck","freq":"pitch * semi(-5) / (1 - pitch * semi(-5) * slack)","decay":"length * 0.9 + 0.1","damp":"0.58 - bright * 0.3","in":"pad * tick2","trig":0},
    {"id":"go3","type":"clock","rate":1,"count":"strings > 3 ? 1 : 0","delay":"(strings - 1 - 3) / (strings - 1) * length * 0.6"},
    {"id":"tick3","type":"ad","attack":0.0003,"decay":0.0022,"curve":1.5,"trig":"go3"},
    {"id":"str3","type":"pluck","freq":"pitch * semi(-8) / (1 - pitch * semi(-8) * slack)","decay":"length * 0.9 + 0.1","damp":"0.58 - bright * 0.3","in":"pad * tick3","trig":0},
    {"id":"go4","type":"clock","rate":1,"count":"strings > 4 ? 1 : 0","delay":"(strings - 1 - 4) / (strings - 1) * length * 0.6"},
    {"id":"tick4","type":"ad","attack":0.0003,"decay":0.0022,"curve":1.5,"trig":"go4"},
    {"id":"str4","type":"pluck","freq":"pitch * semi(-10) / (1 - pitch * semi(-10) * slack)","decay":"length * 0.9 + 0.1","damp":"0.58 - bright * 0.3","in":"pad * tick4","trig":0},
    {"id":"go5","type":"clock","rate":1,"count":"strings > 5 ? 1 : 0","delay":"(strings - 1 - 5) / (strings - 1) * length * 0.6"},
    {"id":"tick5","type":"ad","attack":0.0003,"decay":0.0022,"curve":1.5,"trig":"go5"},
    {"id":"str5","type":"pluck","freq":"pitch * semi(-12) / (1 - pitch * semi(-12) * slack)","decay":"length * 0.9 + 0.1","damp":"0.58 - bright * 0.3","in":"pad * tick5","trig":0},
    {"id":"go6","type":"clock","rate":1,"count":"strings > 6 ? 1 : 0","delay":"(strings - 1 - 6) / (strings - 1) * length * 0.6"},
    {"id":"tick6","type":"ad","attack":0.0003,"decay":0.0022,"curve":1.5,"trig":"go6"},
    {"id":"str6","type":"pluck","freq":"pitch * semi(-15) / (1 - pitch * semi(-15) * slack)","decay":"length * 0.9 + 0.1","damp":"0.58 - bright * 0.3","in":"pad * tick6","trig":0},
    {"id":"strum","type":"expr","expr":"str0 * 1.4 + str1 * 0.71 + str2 * 0.68 + str3 * 0.65 + str4 * 0.62 + str5 * 0.59 + str6 * 0.56"},
    {"id":"boxLow","type":"filter","mode":"bp","in":"strum","freq":230,"q":1.4},
    {"id":"boxHigh","type":"filter","mode":"bp","in":"strum","freq":470,"q":1.4},
    {"id":"sum","type":"expr","expr":"strum + (boxLow * 0.5 + boxHigh * 0.8) * 0.45"},
    {"id":"tone","type":"filter","mode":"lp","in":"sum","freq":"2600 + bright * 7000","q":0.6},
    {"id":"clean","type":"filter","mode":"hp","in":"tone","freq":70},
    {"id":"hand","type":"env","points":[[0,1],["length * 0.74",1],["length + 0.008",0,1.6]]}
  ],
  "out": "clean * hand",
  "presets": {
    "Menu": {"pitch":330,"length":0.3,"bright":0.55,"strings":5},
    "Pop-up": {"pitch":370,"length":0.2,"bright":0.65,"strings":3},
    "Inventory": {"pitch":330,"length":0.42,"bright":0.5,"strings":7}
  }
}
