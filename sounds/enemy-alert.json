{
  "format": "sfxpatch/0.1",
  "id": "enemy-alert",
  "name": "Enemy alert",
  "category": "ui",
  "description": "An enemy notices the player: a hard knock with a quick reedy two-note stab, or a soft two-note question when it only suspects. Change the pitch, length, brightness, snap and the reaction.",
  "meta": { "type": "sfx", "role": "interface/error", "themes": ["neutral", "fantasy", "sci-fi"],
    "gameTypes": ["arcade", "platformer", "roguelike-action", "top-down-rpg", "shooter"],
    "words": ["alert", "spotted", "noticed", "enemy", "suspicious", "surprise", "stealth", "detected", "guard", "exclamation", "question", "huh", "aggro"], "license": "draft" },
  "duration": "length + 0.02",
  "params": [
    { "id": "pitch", "label": "Pitch", "unit": "Hz", "min": 300, "max": 1000, "default": 520, "scale": "log" },
    { "id": "length", "label": "Length", "unit": "s", "min": 0.18, "max": 0.5, "default": 0.3, "scale": "log" },
    { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.55 },
    { "id": "snap", "label": "Snap", "min": 0, "max": 1, "default": 0.7 },
    { "id": "mark", "label": "Reaction", "min": 0, "max": 1, "default": 1, "options": ["Suspicious", "Spotted"] }
  ],
  "nodes": [
    { "id": "second", "type": "clock", "rate": 1, "count": 1, "delay": "mark ? 0.04 : length * 0.3" },
    { "id": "tune", "type": "env", "points": [
      [0, "pitch"],
      ["mark ? 0.04 : length * 0.3", "pitch * semi(mark ? 2 : 3)", "hold"],
      ["length * 0.45", "pitch * semi(mark ? 2 : 3)"],
      ["length", "pitch * semi(mark ? 2 : 4)", "exp"]
    ] },
    { "id": "reed", "type": "osc", "wave": "pulse", "freq": "tune", "width": 0.27 },
    { "id": "soft", "type": "osc", "wave": "tri", "freq": "tune" },
    { "id": "voice", "type": "expr", "expr": "reed * (0.22 + 0.78 * mark) + soft * (1 - mark) * 0.9" },
    { "id": "mouth", "type": "filter", "mode": "lp", "in": "voice", "freq": "tune * (2.2 + bright * 7)", "q": 0.9 },
    { "id": "nose", "type": "filter", "mode": "bp", "in": "voice", "freq": "1300 + bright * 900", "q": 2.5 },
    { "id": "first", "type": "ad", "attack": "mark ? 0.006 - snap * 0.005 : 0.02 - snap * 0.015", "hold": "mark ? 0.025 : length * 0.12", "decay": "mark ? 0.012 : length * 0.2", "curve": 1.5 },
    { "id": "held", "type": "ad", "attack": "mark ? 0.006 - snap * 0.005 : 0.02 - snap * 0.015", "hold": "mark ? (length - 0.04) * 0.4 : length * 0.08", "decay": "mark ? (length - 0.04) * 0.58 : length * 0.55", "curve": 1.8, "trig": "second" },
    { "id": "grain", "type": "noise", "seed": 31 },
    { "id": "rap", "type": "filter", "mode": "bp", "in": "grain", "freq": "1500 + bright * 1500", "q": 1.2 },
    { "id": "rapGate", "type": "ad", "attack": 0.0005, "decay": 0.022, "curve": 3 },
    { "id": "thumpFall", "type": "env", "points": [[0, 240], [0.03, 110, "exp"]] },
    { "id": "thump", "type": "osc", "wave": "sine", "freq": "thumpFall" },
    { "id": "thumpGate", "type": "ad", "attack": 0.0005, "decay": 0.04, "curve": 2.5 },
    { "id": "knock", "type": "expr", "expr": "(rap * rapGate * 1.6 + thump * thumpGate * 0.9) * mark * (0.15 + snap * 0.85)" },
    { "id": "notes", "type": "expr", "expr": "(mouth + nose * (0.25 + 0.5 * mark)) * (first * (0.75 + 0.35 * mark) + held)" },
    { "id": "clean", "type": "filter", "mode": "hp", "in": "notes * 0.6 + knock", "freq": 60 }
  ],
  "out": "clean",
  "presets": {
    "Spotted": { "mark": 1 },
    "Heard something": { "mark": 0, "snap": 0.3, "bright": 0.4 },
    "Boss notices": { "mark": 1, "pitch": 340, "length": 0.45, "snap": 0.9 }
  }
}
