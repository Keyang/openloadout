  },
  {
   "id": "sweep",
   "label": "Sweep",
   "min": 0,
   "max": 3,
   "default": 1.5,
   "unit": "oct"
  },
  {
   "id": "sharp",
   "label": "Sharpness",
   "min": 0.5,
   "max": 8,
   "default": 2
  },
  {
   "id": "air",
   "label": "Air",
   "min": 0,
   "max": 1,
   "default": 0.3
  }
 ],
 "nodes": [
  {
   "id": "n",
   "type": "noise"
  },
  {
   "id": "shape",
   "type": "env",
   "points": [
    [
     0,
     0
    ],
    [
     "length*0.45",
     1,
     2
    ],
    [
     "length",
     0,
     0.6
    ]
   ]
  },
  {
   "id": "band",
   "type": "filter",
   "mode": "bp",
   "in": "n",
   "freq": "pitch * 2^(sweep*(shape - 0.5))",
   "q": "sharp"
  },
  {
   "id": "airy",
   "type": "filter",
   "mode": "hp",
   "in": "n",
   "freq": 5000
  }
 ],
 "out": "band*shape + airy*shape*air*0.9",
 "presets": {
  "Quick swipe": {
