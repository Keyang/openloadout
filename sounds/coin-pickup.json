{
 "format": "sfxpatch/0.1",
 "id": "coin-pickup",
 "name": "Coin pickup",
 "category": "pickup",
 "tags": [
  "collect",
  "reward",
  "arcade"
 ],
 "description": "A quick three-note retro game tune for a collected coin: a short low note, then a jump up that is struck twice, a soft hollow tone with a thin bright edge and a short bell on top, the last note ringing. Change its pitch, the jump between notes, the time between notes, the ring and the shine. The same every time.",
 "meta": {
  "type": "sfx",
  "role": "items/pickup",
  "themes": [
   "neutral",
   "fantasy"
  ],
  "gameTypes": [
   "platformer",
   "turn-based-rpg",
   "arcade",
   "puzzle"
  ],
  "words": [
   "coin",
   "gold",
   "money",
   "cash",
   "collect",
   "pickup",
   "grab",
   "loot",
   "treasure",
   "score",
   "blip",
   "ding"
  ],
  "license": "draft"
 },
 "duration": "speed*2 + ring + 0.02",
 "params": [
  {
   "id": "pitch",
   "label": "Pitch",
   "min": 500,
   "max": 2000,
   "default": 880,
   "unit": "Hz",
   "scale": "log"
  },
  {
   "id": "interval",
   "label": "Jump between notes",
   "min": 2,
   "max": 12,
   "default": 9,
   "unit": "semitones"
  },
  {
   "id": "speed",
   "label": "Time between notes",
   "min": 0.035,
   "max": 0.11,
   "default": 0.055,
   "unit": "s"
  },
  {
   "id": "ring",
   "label": "Ring",
   "min": 0.12,
   "max": 0.6,
   "default": 0.3,
   "unit": "s",
   "scale": "log"
  },
  {
   "id": "shine",
   "label": "Shine",
   "min": 0,
   "max": 1,
   "default": 0.5
  }
 ],
 "nodes": [
  {
   "id": "clk",
   "type": "clock",
   "rate": "1/speed",
   "count": 3
  },
  {
   "id": "note",
   "type": "seq",
   "steps": [
    "pitch",
    "pitch*semi(interval)",
    "pitch*semi(interval)"
   ],
   "trig": "clk"
  },
  {
   "id": "lastClk",
   "type": "clock",
   "rate": 1,
   "count": 1,
   "delay": "speed*2"
  },
  {
   "id": "ampShort",
   "type": "ad",
   "attack": 0.002,
   "decay": "speed*0.95",
   "curve": 1.6,
   "trig": "clk"
  },
  {
   "id": "ampLast",
   "type": "ad",
   "attack": 0.002,
   "decay": "ring",
   "curve": 2.2,
   "trig": "lastClk"
  },
  {
   "id": "isLast",
   "type": "expr",
   "expr": "t >= speed*2 - 0.0005 ? 1 : 0"
  },
  {
   "id": "amp",
   "type": "expr",
   "expr": "isLast ? ampLast : ampShort*(note > pitch*1.01 ? 1 : 0.85)"
  },
  {
   "id": "tr",
   "type": "osc",
   "wave": "tri",
   "freq": "note"
  },
  {
   "id": "pl",
   "type": "osc",
   "wave": "pulse",
   "width": 0.2,
   "freq": "note"
  },
  {
   "id": "bell",
   "type": "modal",
   "in": "clk*(note > pitch*1.01 ? 1 : 0)",
   "freq": "note*2",
   "ratios": [
    1,
    2.76,
    5.4
   ],
   "gains": [
    1,
    0.45,
    0.2
   ],
   "decay": "isLast ? ring*0.7 : speed*1.2",
   "tilt": 0.5
  },
  {
   "id": "sum",
   "type": "expr",
   "expr": "(tr*0.8 + pl*(0.06 + shine*0.22))*amp + bell*shine*0.2"
  },
  {
   "id": "clean",
   "type": "filter",
   "mode": "hp",
   "in": "sum",
   "freq": 150,
   "q": 0.7
  }
 ],
 "out": "clean",
 "presets": {
  "Gem": {
   "pitch": 1250,
   "interval": 12,
   "speed": 0.045,
   "ring": 0.36,
   "shine": 1
  },
  "Dull token": {
   "pitch": 620,
   "interval": 3,
   "speed": 0.08,
   "ring": 0.18,
   "shine": 0
  }
 }
}
