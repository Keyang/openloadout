{
 "format": "sfxpatch/0.1",
 "id": "stream-babble",
 "name": "Stream",
 "category": "ambience",
 "description": "A stream running over stones: a flowing rush of water full of quick gurgles and the odd deeper glug. Change how big the stream is, how fast it flows, the brightness and how much it gurgles.",
 "meta": {
  "type": "ambience",
  "role": "environment/ambience",
  "themes": [
   "neutral",
   "forest",
   "farm"
  ],
  "gameTypes": [
   "top-down-rpg",
   "farming-sim",
   "turn-based-rpg",
   "platformer"
  ],
  "words": [
   "stream",
   "brook",
   "creek",
   "river",
   "water",
   "babble",
   "flowing",
   "gurgle",
   "trickle",
   "running water",
   "forest",
   "calm"
  ],
  "license": "draft"
 },
 "loop": true,
 "duration": 6,
 "normalize": false,
 "gain": 0.35,
 "params": [
  {
   "id": "size",
   "label": "Size",
   "min": 0,
   "max": 1,
   "default": 0.5,
   "hint": "From a little brook on the left to a river on the right: lower and fuller."
  },
  {
   "id": "flow",
   "label": "Flow",
   "min": 0,
   "max": 1,
   "default": 0.5,
   "hint": "From a gentle trickle to rushing water."
  },
  {
   "id": "bright",
   "label": "Brightness",
   "min": 0,
   "max": 1,
   "default": 0.5
  },
  {
   "id": "gurgle",
   "label": "Gurgle",
   "min": 0,
   "max": 1,
   "default": 0.5
  }
 ],
 "nodes": [
  {
   "id": "pn",
   "type": "noise",
   "color": "pink"
  },
  {
   "id": "mclk",
   "type": "clock",
   "rate": "1.5 + flow * 3",
   "jitter": 0.7
  },
  {
   "id": "mr",
   "type": "rand",
   "trig": "mclk"
  },
  {
   "id": "move",
   "type": "lag",
   "in": "mr",
   "time": "0.35 - flow * 0.2"
  },
  {
   "id": "washC",
   "type": "expr",
   "expr": "(1500 - size * 800) * (0.75 + move * 0.5) * (0.8 + bright * 0.5)"
  },
  {
   "id": "wash",
   "type": "filter",
   "mode": "bp",
   "in": "pn",
   "freq": "washC",
   "q": "1.6 - size * 0.8"
  },
  {
   "id": "hiss",
   "type": "filter",
   "mode": "hp",
   "in": "pn",
   "freq": 3500
  },
  {
   "id": "bn",
   "type": "noise",
   "color": "brown"
  },
  {
   "id": "rumble",
   "type": "filter",
   "mode": "lp",
   "in": "bn",
   "freq": "180 + size * 220"
  },
  {
   "id": "gd",
   "type": "dust",
   "density": "(10 + flow * 45) * (0.3 + gurgle * 1.2)",
   "spread": 0.7
  },
  {
   "id": "gr",
   "type": "rand",
   "lo": 0,
   "hi": 1,
   "trig": "gd"
  },
  {
   "id": "gglide",
   "type": "env",
   "points": [
    [
     0,
     1
    ],
    [
     0.03,
     1.5,
     "exp"
    ]
   ],
   "trig": "gd"
  },
  {
   "id": "gp",
   "type": "expr",
   "expr": "300 * pow(5, gr) * (1 - size * 0.4) * gglide"
  },
  {
   "id": "blip",
   "type": "modal",
   "in": "gd",
   "freq": "gp",
   "ratios": [
    1,
    2.1
   ],
   "gains": [
    1,
    0.25
   ],
   "decay": "0.05 + size * 0.03",
   "tilt": 1
  },
  {
   "id": "gd2",
   "type": "dust",
   "density": "(14 + flow * 30) * (0.2 + gurgle)",
   "spread": 0.6
  },
  {
   "id": "gr2",
   "type": "rand",
   "lo": 0,
   "hi": 1,
   "trig": "gd2"
  },
  {
   "id": "gglide2",
   "type": "env",
   "points": [
    [
     0,
     1
    ],
    [
     0.025,
     1.7,
     "exp"
    ]
   ],
   "trig": "gd2"
  },
  {
   "id": "blip2",
   "type": "modal",
   "in": "gd2",
   "freq": "320 * pow(4.5, gr2) * (1 - size * 0.4) * gglide2",
   "ratios": [
    1
   ],
   "decay": 0.04,
   "tilt": 1
  },
  {
   "id": "glugT",
   "type": "dust",
   "density": "0.25 + size * 0.15 + gurgle * 0.1",
   "spread": 0.3
  },
  {
   "id": "glr",
   "type": "rand",
   "lo": 0,
   "hi": 1,
   "trig": "glugT"
  },
  {
   "id": "glugUp",
   "type": "env",
   "points": [
    [
     0,
     1
    ],
    [
     0.07,
     1.8,
     "exp"
    ]
   ],
   "trig": "glugT"
  },
  {
   "id": "glugAmp",
   "type": "ad",
   "attack": 0.006,
   "decay": "0.12 + size * 0.06",
   "curve": 2,
   "trig": "glugT"
  },
  {
   "id": "glugO",
   "type": "osc",
   "wave": "sine",
   "freq": "(150 + glr * 90) * (1 - size * 0.3) * glugUp"
  },
  {
   "id": "glug",
   "type": "expr",
   "expr": "glugO * glugAmp"
  },
  {
   "id": "drops",
   "type": "expr",
   "expr": "1.2 * tanh((blip * 0.6 + blip2 * 0.7) * (0.2 + gurgle * 1.1) * (0.35 + flow * 0.65) / 1.2)"
  },
  {
   "id": "tone",
   "type": "filter",
   "mode": "lp",
   "in": "drops + glug * (0.25 + gurgle * 0.4) * (0.5 + flow * 0.5)",
   "freq": "1800 + bright * bright * 7000"
  },
  {
   "id": "body",
   "type": "expr",
   "expr": "wash * (0.15 + flow * 1.55) * (0.85 + move * 0.3) + hiss * (0.05 + bright * 0.35) * (0.15 + flow) + rumble * size * (0.2 + flow * 0.4)"
  },
  {
   "id": "clean",
   "type": "filter",
   "mode": "hp",
   "in": "body + tone",
   "freq": 35
  }
 ],
 "out": "clean",
 "presets": {
  "Trickle": {
   "size": 0.1,
   "flow": 0.15,
   "bright": 0.6,
   "gurgle": 0.75
  },
  "Brook": {
   "size": 0.4,
   "flow": 0.5,
   "bright": 0.5,
   "gurgle": 0.55
  },
  "River": {
   "size": 0.95,
   "flow": 0.85,
   "bright": 0.4,
   "gurgle": 0.3
  }
 }
}
