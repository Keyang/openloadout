{
  "format": "sfxpatch/0.1",
  "id": "top-out",
  "name": "Stack overflow",
  "category": "impact",
  "description": "A stack collapsing: a tumble of short buzzy blips on falling notes, faster and faster, under a tone sliding down, ending on a dull low thud. Change its pitch, its length, the number of pieces, how far it drops and the grit. A little different every time.",
  "meta": {
    "type": "sfx",
    "role": "world/break",
    "themes": ["neutral"],
    "gameTypes": ["puzzle", "arcade"],
    "words": ["collapse", "overflow", "topple", "tumble", "fall", "stack", "crash", "thud", "lose", "fail", "game over", "blips", "chiptune"],
    "license": "draft"
  },
  "duration": "length",
  "params": [
    { "id": "pitch", "label": "Pitch", "unit": "Hz", "min": 300, "max": 1200, "default": 659, "scale": "log" },
    { "id": "length", "label": "Length", "unit": "s", "min": 0.8, "max": 1.5, "default": 1.0, "scale": "log" },
    { "id": "pieces", "label": "Pieces", "min": 6, "max": 16, "default": 10, "step": 1 },
    { "id": "drop", "label": "Drop", "unit": "semitones", "min": 6, "max": 24, "default": 19, "step": 1 },
    { "id": "grit", "label": "Grit", "min": 0, "max": 1, "default": 0.3 }
  ],
  "nodes": [
    { "id": "gap", "type": "expr", "expr": "(1 - pow(0.24, 1 / (pieces - 1))) * length * 0.74 / 0.8 * (1 - 0.8 * min(t / (length * 0.74), 1))" },
    { "id": "tick", "type": "clock", "rate": "1 / gap", "jitter": 0.22, "count": "pieces" },
    { "id": "note", "type": "seq", "steps": [12, 10, 8, 5, 3, 0, -2, -4, -7, -9, -12, -14, -16, -19, -21, -24], "trig": "tick" },
    { "id": "blip", "type": "osc", "wave": "square", "freq": "pitch * semi(note)" },
    { "id": "blipAmp", "type": "ad", "trig": "tick", "attack": 0.001, "hold": 0.012, "decay": 0.05, "curve": 1.6 },
    { "id": "fall", "type": "env", "points": [[0, "pitch"], ["length * 0.78", "pitch * semi(0 - drop)", "exp"]] },
    { "id": "slide", "type": "osc", "wave": "square", "freq": "fall" },
    { "id": "slideAmp", "type": "env", "points": [[0, 0], [0.004, 1], ["length * 0.55", 0.7], ["length * 0.8", 0, 1.5]] },
    { "id": "tones", "type": "filter", "mode": "lp", "in": "blip * blipAmp * 0.62 + slide * slideAmp * 0.42", "freq": "1800 + grit * 7000", "q": 0.8 },
    { "id": "rough", "type": "crush", "in": "tones", "bits": "9 - grit * 5.5", "rate": "16000 - grit * 11500" },
    { "id": "land", "type": "clock", "rate": 1, "count": 1, "delay": "length * 0.8" },
    { "id": "sink", "type": "env", "trig": "land", "start": 150, "points": [[0, 150], [0.07, 52, "exp"]] },
    { "id": "boom", "type": "osc", "wave": "sine", "freq": "sink" },
    { "id": "boomAmp", "type": "ad", "trig": "land", "attack": 0.002, "decay": "length * 0.19", "curve": 2.2 },
    { "id": "hiss", "type": "noise" },
    { "id": "knock", "type": "filter", "mode": "lp", "in": "hiss", "freq": "520 + grit * 500", "q": 1.1 },
    { "id": "knockAmp", "type": "ad", "trig": "land", "attack": 0.001, "decay": 0.07, "curve": 2.4 },
    { "id": "thud", "type": "shaper", "in": "boom * boomAmp * 1.1 + knock * knockAmp * 1.3", "drive": 1.8 },
    { "id": "clean", "type": "filter", "mode": "hp", "in": "rough + thud * 0.95", "freq": 30 }
  ],
  "out": "clean",
  "presets": {
    "Top out": {},
    "Collapse": { "pieces": 16, "length": 1.4 },
    "Small collapse": { "pieces": 6, "drop": 12, "grit": 0.1 }
  }
}
