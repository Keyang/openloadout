{
 "format": "sfxpatch/0.1",
 "id": "menu-console-move",
 "name": "Console move",
 "category": "ui",
 "description": "A warm console menu cursor: one short, soft, round electric-piano note with a gentle echo after it. Change its pitch, length, brightness and echo. The same every time.",
 "meta": {
  "type": "sfx",
  "role": "interface/hover",
  "themes": [
   "neutral"
  ],
  "gameTypes": [
   "arcade",
   "turn-based-rpg",
   "puzzle",
   "card-game"
  ],
  "words": [
   "hover",
   "cursor",
   "move",
   "menu",
   "select",
   "navigate",
   "retro",
   "console",
   "tine",
   "echo",
   "soft",
   "button"
  ],
  "license": "draft"
 },
 "duration": "length + 0.09 + 0.01",
 "params": [
  {
   "id": "pitch",
   "label": "Pitch",
   "unit": "Hz",
   "min": 260,
   "max": 700,
   "default": 440,
   "scale": "log"
  },
  {
   "id": "length",
   "label": "Length",
   "unit": "s",
   "min": 0.05,
   "max": 0.15,
   "default": 0.08,
   "scale": "log"
  },
  {
   "id": "bright",
   "label": "Brightness",
   "min": 0,
   "max": 1,
   "default": 0.5
  },
  {
   "id": "echo",
   "label": "Echo",
   "min": 0.15,
   "max": 0.6,
   "default": 0.35
  }
 ],
 "nodes": [
  {
   "id": "c1",
   "type": "clock",
   "rate": 1,
   "count": 1
  },
  {
   "id": "a1",
   "type": "ad",
   "attack": 0.002,
   "decay": "length",
   "curve": 2.2,
   "trig": "c1"
  },
  {
   "id": "k1",
   "type": "ad",
   "attack": 0.0005,
   "decay": 0.03,
   "curve": 2,
   "trig": "c1"
  },
  {
   "id": "m1",
   "type": "osc",
   "freq": "pitch"
  },
  {
   "id": "o1",
   "type": "osc",
   "freq": "pitch",
   "pm": "m1*(0.04 + (0.08 + bright*0.12)*k1)"
  },
  {
   "id": "notes",
   "type": "expr",
   "expr": "o1*a1"
  },
  {
   "id": "grain",
   "type": "crush",
   "in": "notes",
   "bits": 12,
   "rate": 30000
  },
  {
   "id": "tone",
   "type": "filter",
   "mode": "lp",
   "in": "grain",
   "freq": "2000 + bright*3000",
   "q": 0.6
  },
  {
   "id": "rep",
   "type": "delay",
   "in": "tone",
   "time": 0.09,
   "feedback": 0,
   "mix": 1,
   "max": 0.2
  },
  {
   "id": "soft",
   "type": "filter",
   "mode": "lp",
   "in": "rep",
   "freq": "1500 + bright*1500",
   "q": 0.6
  },
  {
   "id": "clean",
   "type": "filter",
   "mode": "hp",
   "in": "tone + soft*echo",
   "freq": 120
  }
 ],
 "out": "clean",
 "presets": {
  "List": {
   "pitch": 440,
   "length": 0.08
  },
  "Grid": {
   "pitch": 494,
   "length": 0.06
  },
  "Tab": {
   "pitch": 415,
   "length": 0.12,
   "echo": 0.4
  }
 }
}
