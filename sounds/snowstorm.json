{
 "format": "sfxpatch/0.1",
 "id": "snowstorm",
 "name": "Snowstorm",
 "category": "ambience",
 "description": "A blizzard: a muffled roar under a two-part howl that rises and falls with the gusts, with fine ice blowing past. Change how hard it storms, the pitch of the howl, the brightness, how much it howls, and whether it is heard from outside, from inside a tent or from behind a window.",
 "meta": {
  "type": "ambience",
  "role": "environment/weather",
  "themes": ["neutral", "fantasy", "horror"],
  "gameTypes": ["top-down-rpg", "turn-based-rpg", "platformer", "roguelike-action", "puzzle"],
  "words": ["snowstorm", "blizzard", "snow", "storm", "howl", "ice", "winter", "cold", "frost", "mountain", "tent", "cabin", "window", "gale"],
  "license": "draft"
 },
 "loop": true,
 "duration": 8,
 "normalize": false,
 "params": [
  { "id": "amount", "label": "Storm", "min": 0, "max": 1, "default": 0.5 },
  { "id": "pitch", "label": "Pitch", "min": 250, "max": 900, "default": 450, "unit": "Hz", "scale": "log" },
  { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.4 },
  { "id": "howl", "label": "Howl", "min": 0, "max": 1, "default": 0.5 },
  { "id": "shelter", "label": "Heard from", "min": 0, "max": 2, "default": 0, "options": ["Outside", "Tent", "Window"] }
 ],
 "nodes": [
  { "id": "isOut", "type": "expr", "expr": "shelter < 0.5 ? 1 : 0" },
  { "id": "isTent", "type": "expr", "expr": "shelter >= 0.5 && shelter < 1.5 ? 1 : 0" },
  { "id": "isWin", "type": "expr", "expr": "shelter >= 1.5 ? 1 : 0" },

  { "id": "gclk", "type": "clock", "rate": 0.75, "jitter": 0.6 },
  { "id": "gr", "type": "rand", "trig": "gclk" },
  { "id": "g", "type": "lag", "in": "gr", "time": 0.8 },
  { "id": "sclk", "type": "clock", "rate": 0.45, "jitter": 0.7, "delay": "rnd(0, 1)" },
  { "id": "sr2", "type": "rand", "trig": "sclk" },
  { "id": "sw", "type": "lag", "in": "sr2", "time": 1.3 },
  { "id": "gust", "type": "expr", "expr": "(1 - 0.75*amount) + 0.75*amount*g*1.7" },

  { "id": "nL", "type": "noise", "color": "pink" },
  { "id": "nR", "type": "noise", "color": "pink" },
  { "id": "roarLoL", "type": "filter", "mode": "lp", "in": "nL", "freq": "(340 + 450*bright)*(0.8 + 0.4*sw)", "q": 0.6 },
  { "id": "roarLoR", "type": "filter", "mode": "lp", "in": "nR", "freq": "(340 + 450*bright)*(0.8 + 0.4*sw)", "q": 0.6 },
  { "id": "roarL", "type": "filter", "mode": "hp", "in": "roarLoL", "freq": 150 },
  { "id": "roarR", "type": "filter", "mode": "hp", "in": "roarLoR", "freq": 150 },

  { "id": "hn", "type": "noise" },
  { "id": "hf", "type": "expr", "expr": "pitch*(0.76 + 0.5*g)" },
  { "id": "howlLo", "type": "filter", "mode": "bp", "in": "hn", "freq": "hf", "q": "8 + 7*howl" },
  { "id": "howlHi", "type": "filter", "mode": "bp", "in": "hn", "freq": "hf*1.5", "q": "8 + 7*howl" },
  { "id": "howlLvl", "type": "expr", "expr": "howl*(0.25 + 1.1*g)*pow(450/pitch, 0.5)" },

  { "id": "bedL", "type": "expr", "expr": "roarL*(0.6 + 0.6*sw)*1.4 + (howlLo*0.62 + howlHi*0.34)*howlLvl" },
  { "id": "bedR", "type": "expr", "expr": "roarR*(0.6 + 0.6*sw)*1.4 + (howlLo*0.34 + howlHi*0.62)*howlLvl" },
  { "id": "cut", "type": "expr", "expr": "isOut*9000 + isTent*(1100 + 900*bright) + isWin*(520 + 380*bright)" },
  { "id": "shL", "type": "filter", "mode": "lp", "in": "bedL", "freq": "cut", "q": 0.6 },
  { "id": "shR", "type": "filter", "mode": "lp", "in": "bedR", "freq": "cut", "q": 0.6 },

  { "id": "iceL", "type": "dust", "density": "2500 + 3500*amount", "spread": 1 },
  { "id": "iceR", "type": "dust", "density": "2500 + 3500*amount", "spread": 1 },
  { "id": "iceHiL", "type": "filter", "mode": "hp", "in": "iceL", "freq": 4000, "q": 0.7 },
  { "id": "iceHiR", "type": "filter", "mode": "hp", "in": "iceR", "freq": 4000, "q": 0.7 },
  { "id": "grainL", "type": "filter", "mode": "lp", "in": "iceHiL", "freq": "4600 + 3400*bright", "q": 0.7 },
  { "id": "grainR", "type": "filter", "mode": "lp", "in": "iceHiR", "freq": "4600 + 3400*bright", "q": 0.7 },
  { "id": "grainLvl", "type": "expr", "expr": "(0.4 + 0.6*amount)*(0.5 + 0.8*g)*(0.6 + 0.7*bright)" },

  { "id": "patClk", "type": "clock", "rate": "3.2 + 2.6*g", "jitter": 0.8 },
  { "id": "patLvl", "type": "rand", "lo": 0.3, "hi": 1, "trig": "patClk" },
  { "id": "patTone", "type": "rand", "lo": 0.75, "hi": 1.3, "trig": "patClk" },
  { "id": "patAmp", "type": "ad", "attack": 0.004, "decay": 0.11, "curve": 2, "trig": "patClk" },
  { "id": "flapAmp", "type": "ad", "attack": 0.006, "decay": 0.06, "curve": 1.6, "trig": "patClk" },
  { "id": "patN", "type": "noise", "color": "brown" },
  { "id": "pat", "type": "filter", "mode": "bp", "in": "patN", "freq": "190*patTone", "q": 1.4 },
  { "id": "flap", "type": "filter", "mode": "bp", "in": "nL", "freq": "(520 + 500*bright)*patTone", "q": 0.9 },
  { "id": "cloth", "type": "expr", "expr": "(pat*patAmp*2.6 + flap*flapAmp*0.9)*patLvl*(0.5 + 0.5*amount)" },

  { "id": "tickL", "type": "dust", "density": "4 + 22*amount", "spread": 1 },
  { "id": "tickR", "type": "dust", "density": "4 + 22*amount", "spread": 1 },
  { "id": "glassL", "type": "modal", "in": "tickL", "freq": "(3600 + 1500*bright)*rnd(0.92, 1.08)", "ratios": [1, 1.71, 2.63], "gains": [1, 0.6, 0.35], "decay": 0.022, "tilt": 0.6 },
  { "id": "glassR", "type": "modal", "in": "tickR", "freq": "(4300 + 1500*bright)*rnd(0.92, 1.08)", "ratios": [1, 1.71, 2.63], "gains": [1, 0.6, 0.35], "decay": 0.02, "tilt": 0.6 },
  { "id": "draught", "type": "filter", "mode": "bp", "in": "nR", "freq": "pitch*2.6*(0.85 + 0.3*sw)", "q": 14 },
  { "id": "draughtLvl", "type": "expr", "expr": "(0.3 + 0.7*howl)*(0.35 + 0.65*sw)" },

  { "id": "level", "type": "expr", "expr": "(0.22 + 0.78*amount)*gust" },
  { "id": "mixL", "type": "expr", "expr": "(shL*(isOut + isTent*0.7 + isWin*0.9) + grainL*grainLvl*isOut*1.3 + cloth*isTent*0.9 + draught*draughtLvl*isWin*0.3)*level + glassL*isWin*0.3*(0.4 + 0.6*amount)" },
  { "id": "mixR", "type": "expr", "expr": "(shR*(isOut + isTent*0.7 + isWin*0.9) + grainR*grainLvl*isOut*1.3 + cloth*isTent*0.75 + draught*draughtLvl*isWin*0.42)*level + glassR*isWin*0.3*(0.4 + 0.6*amount)" },
  { "id": "outL", "type": "filter", "mode": "hp", "in": "mixL", "freq": 40 },
  { "id": "outR", "type": "filter", "mode": "hp", "in": "mixR", "freq": 40 }
 ],
 "out": ["tanh(outL*0.6)*0.8", "tanh(outR*0.6)*0.8"],
 "presets": {
  "Blizzard": { "shelter": 0, "amount": 0.9, "howl": 0.7 },
  "Mountain tent": { "shelter": 1, "amount": 0.6 },
  "Cabin window": { "shelter": 2, "amount": 0.25, "howl": 0.4 }
 }
}
