{
  "format": "sfxpatch/0.1",
  "id": "swamp-bog",
  "name": "Swamp",
  "category": "ambience",
  "description": "A still, wet bog: low bubbles of marsh gas that blup up and fizz, drips falling into the water and a fly circling near and far, over quiet damp air. Change the bog's size, the bubbles, the brightness, the flies and the drips.",
  "meta": {
    "type": "ambience",
    "role": "environment/ambience",
    "themes": ["forest", "horror", "fantasy"],
    "gameTypes": ["top-down-rpg", "platformer", "turn-based-rpg", "roguelike-action", "puzzle"],
    "words": ["swamp", "bog", "marsh", "mire", "wetland", "bubbles", "blup", "drip", "fly", "buzzing", "murky", "damp", "still water", "gas"],
    "license": "draft"
  },
  "loop": true,
  "duration": 8,
  "params": [
    { "id": "size", "label": "Bog size", "min": 0, "max": 1, "default": 0.5, "hint": "A small pond on the left; a wide, deep bog on the right: lower, slower bubbles and darker air." },
    { "id": "gas", "label": "Bubbles", "min": 0, "max": 1, "default": 0.5, "hint": "How many bubbles of marsh gas come up: two in a loop on the left, five on the right." },
    { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.45 },
    { "id": "flies", "label": "Flies", "min": 0, "max": 1, "default": 0.4, "hint": "None on the left; one circling fly, then a second one near the right." },
    { "id": "drip", "label": "Drips", "min": 0, "max": 1, "default": 0.4, "hint": "None on the left; up to four drips in a loop on the right." }
  ],
  "nodes": [
    { "id": "bn1", "type": "noise" },
    { "id": "bn2", "type": "noise" },
    { "id": "swc", "type": "clock", "rate": "1.1 - size * 0.6", "jitter": 0.5 },
    { "id": "swr", "type": "rand", "lo": 0.45, "hi": 1, "trig": "swc" },
    { "id": "swell", "type": "lag", "in": "swr", "time": "0.5 + size * 0.5" },
    { "id": "bedA1", "type": "filter", "mode": "lp", "in": "bn1", "freq": "1250 - size * 600 + bright * 500", "q": 0.6 },
    { "id": "bedA2", "type": "filter", "mode": "lp", "in": "bedA1", "freq": "1250 - size * 600 + bright * 500", "q": 0.6 },
    { "id": "bedL", "type": "filter", "mode": "hp", "in": "bedA2", "freq": "260 - size * 80", "q": 0.6 },
    { "id": "bedB1", "type": "filter", "mode": "lp", "in": "bn2", "freq": "1250 - size * 600 + bright * 500", "q": 0.6 },
    { "id": "bedB2", "type": "filter", "mode": "lp", "in": "bedB1", "freq": "1250 - size * 600 + bright * 500", "q": 0.6 },
    { "id": "bedR", "type": "filter", "mode": "hp", "in": "bedB2", "freq": "260 - size * 80", "q": 0.6 },

    { "id": "g3", "type": "expr", "expr": "smooth(0.2, 0.3, gas)" },
    { "id": "g4", "type": "expr", "expr": "smooth(0.55, 0.65, gas)" },
    { "id": "g5", "type": "expr", "expr": "smooth(0.8, 0.9, gas)" },
    { "id": "b1", "type": "clock", "rate": 0.1, "count": 1, "delay": "rnd(0.4, 1.2)" },
    { "id": "b2", "type": "clock", "rate": 0.1, "count": 1, "delay": "rnd(4.3, 5.2)" },
    { "id": "b3", "type": "clock", "rate": 0.1, "count": 1, "delay": "rnd(2.4, 3.3)" },
    { "id": "b4", "type": "clock", "rate": 0.1, "count": 1, "delay": "rnd(6.2, 6.9)" },
    { "id": "b5", "type": "clock", "rate": 0.1, "count": 1, "delay": "rnd(1.6, 2.1)" },
    { "id": "q1", "type": "env", "trig": "b1", "start": 1, "points": [[0, 1], ["(0.07 + size * 0.14) * rnd(0.8, 1.3)", "semi(rnd(4, 6.8))", "exp"]] },
    { "id": "q2", "type": "env", "trig": "b2", "start": 1, "points": [[0, 1], ["(0.07 + size * 0.14) * rnd(0.8, 1.3)", "semi(rnd(4, 6.8))", "exp"]] },
    { "id": "q3", "type": "env", "trig": "b3", "start": 1, "points": [[0, 1], ["(0.07 + size * 0.14) * rnd(0.8, 1.3)", "semi(rnd(4, 6.8))", "exp"]] },
    { "id": "q4", "type": "env", "trig": "b4", "start": 1, "points": [[0, 1], ["(0.07 + size * 0.14) * rnd(0.8, 1.3)", "semi(rnd(4, 6.8))", "exp"]] },
    { "id": "q5", "type": "env", "trig": "b5", "start": 1, "points": [[0, 1], ["(0.07 + size * 0.14) * rnd(0.8, 1.3)", "semi(rnd(4, 6.8))", "exp"]] },
    { "id": "u1", "type": "osc", "freq": "(225 - size * 75) * rnd(1, 1.2) * q1" },
    { "id": "u2", "type": "osc", "freq": "(225 - size * 75) * rnd(1, 1.2) * q2" },
    { "id": "u3", "type": "osc", "freq": "(225 - size * 75) * rnd(1, 1.2) * q3" },
    { "id": "u4", "type": "osc", "freq": "(225 - size * 75) * rnd(1, 1.2) * q4" },
    { "id": "u5", "type": "osc", "freq": "(225 - size * 75) * rnd(1, 1.2) * q5" },
    { "id": "e1", "type": "ad", "trig": "b1", "attack": 0.012, "hold": "0.03 + size * 0.06", "decay": "0.09 + size * 0.14", "curve": 1.6 },
    { "id": "e2", "type": "ad", "trig": "b2", "attack": 0.012, "hold": "0.03 + size * 0.06", "decay": "0.09 + size * 0.14", "curve": 1.6 },
    { "id": "e3", "type": "ad", "trig": "b3", "attack": 0.012, "hold": "0.03 + size * 0.06", "decay": "0.09 + size * 0.14", "curve": 1.6 },
    { "id": "e4", "type": "ad", "trig": "b4", "attack": 0.012, "hold": "0.03 + size * 0.06", "decay": "0.09 + size * 0.14", "curve": 1.6 },
    { "id": "e5", "type": "ad", "trig": "b5", "attack": 0.012, "hold": "0.03 + size * 0.06", "decay": "0.09 + size * 0.14", "curve": 1.6 },
    { "id": "blupL", "type": "expr", "expr": "u1 * e1 * rnd(0.75, 1) * 0.6 + u2 * e2 * rnd(0.75, 1) * 0.4 + u3 * e3 * g3 * rnd(0.7, 1) * 0.3 + u4 * e4 * g4 * rnd(0.7, 1) * 0.65 + u5 * e5 * g5 * rnd(0.6, 0.9) * 0.5" },
    { "id": "blupR", "type": "expr", "expr": "u1 * e1 * rnd(0.75, 1) * 0.4 + u2 * e2 * rnd(0.75, 1) * 0.6 + u3 * e3 * g3 * rnd(0.7, 1) * 0.7 + u4 * e4 * g4 * rnd(0.7, 1) * 0.35 + u5 * e5 * g5 * rnd(0.6, 0.9) * 0.5" },

    { "id": "wn", "type": "noise" },
    { "id": "wq", "type": "env", "trig": "b1 + b2 + b3 * g3 + b4 * g4 + b5 * g5", "start": 1, "points": [[0, 1], ["0.09 + size * 0.16", 1.5, "exp"]] },
    { "id": "wet", "type": "filter", "mode": "bp", "in": "wn * (e1 + e2 + e3 * g3 + e4 * g4 + e5 * g5)", "freq": "(620 - size * 220 + bright * 260) * wq", "q": 2.5 },
    { "id": "fzEnv", "type": "env", "trig": "b1 + b2 + b3 * g3 + b4 * g4 + b5 * g5", "points": [[0, 0], ["0.08 + size * 0.14", 0], ["0.1 + size * 0.14", 1], ["0.42 + size * 0.3", 0, 2]] },
    { "id": "fzDust", "type": "dust", "density": "320 - size * 140", "spread": 1 },
    { "id": "fizz", "type": "filter", "mode": "bp", "in": "fzDust * fzEnv", "freq": "2600 - size * 800 + bright * 2600", "q": 1.6 },

    { "id": "h2", "type": "expr", "expr": "smooth(0.02, 0.1, drip)" },
    { "id": "h3", "type": "expr", "expr": "smooth(0.28, 0.38, drip)" },
    { "id": "h4", "type": "expr", "expr": "smooth(0.7, 0.8, drip)" },
    { "id": "d1", "type": "clock", "rate": 0.1, "count": 1, "delay": "rnd(1.3, 2.3)" },
    { "id": "d2", "type": "clock", "rate": 0.1, "count": 1, "delay": "rnd(5.4, 6.1)" },
    { "id": "d3", "type": "clock", "rate": 0.1, "count": 1, "delay": "rnd(3.4, 4.2)" },
    { "id": "d4", "type": "clock", "rate": 0.1, "count": 1, "delay": "rnd(7.0, 7.6)" },
    { "id": "y1", "type": "env", "trig": "d1", "start": 1, "points": [[0, 1], [0.03, "semi(rnd(4, 8))", "exp"]] },
    { "id": "y2", "type": "env", "trig": "d2", "start": 1, "points": [[0, 1], [0.026, "semi(rnd(4, 8))", "exp"]] },
    { "id": "y3", "type": "env", "trig": "d3", "start": 1, "points": [[0, 1], [0.034, "semi(rnd(4, 8))", "exp"]] },
    { "id": "y4", "type": "env", "trig": "d4", "start": 1, "points": [[0, 1], [0.028, "semi(rnd(4, 8))", "exp"]] },
    { "id": "w1", "type": "osc", "freq": "(1150 - size * 450) * rnd(0.62, 0.95) * y1" },
    { "id": "w2", "type": "osc", "freq": "(1150 - size * 450) * rnd(0.7, 0.98) * y2" },
    { "id": "w3", "type": "osc", "freq": "(1150 - size * 450) * rnd(0.62, 0.9) * y3" },
    { "id": "w4", "type": "osc", "freq": "(1150 - size * 450) * rnd(0.66, 0.98) * y4" },
    { "id": "x1", "type": "ad", "trig": "d1", "attack": 0.001, "decay": "rnd(0.05, 0.08)", "curve": 2.2 },
    { "id": "x2", "type": "ad", "trig": "d2", "attack": 0.001, "decay": "rnd(0.05, 0.08)", "curve": 2.2 },
    { "id": "x3", "type": "ad", "trig": "d3", "attack": 0.001, "decay": "rnd(0.05, 0.08)", "curve": 2.2 },
    { "id": "x4", "type": "ad", "trig": "d4", "attack": 0.001, "decay": "rnd(0.05, 0.08)", "curve": 2.2 },
    { "id": "tk", "type": "ad", "trig": "d1 * h2 + d2 * h2 + d3 * h3 + d4 * h4", "attack": 0.0003, "decay": 0.005, "curve": 2 },
    { "id": "tn", "type": "noise" },
    { "id": "tick", "type": "filter", "mode": "bp", "in": "tn * tk", "freq": "2500 + bright * 3000", "q": 1.5 },
    { "id": "k1", "type": "expr", "expr": "w1 * x1 * h2 * rnd(0.75, 1)" },
    { "id": "k2", "type": "expr", "expr": "w2 * x2 * h2 * rnd(0.7, 1)" },
    { "id": "k3", "type": "expr", "expr": "w3 * x3 * h3 * rnd(0.7, 1)" },
    { "id": "k4", "type": "expr", "expr": "w4 * x4 * h4 * rnd(0.65, 0.95)" },
    { "id": "dripL", "type": "filter", "mode": "lp", "in": "k1 * 0.7 + k2 * 0.3 + k3 * 0.45 + k4 * 0.6 + tick * (0.1 + bright * 0.5)", "freq": "2400 + bright * 8000" },
    { "id": "dripR", "type": "filter", "mode": "lp", "in": "k1 * 0.3 + k2 * 0.7 + k3 * 0.55 + k4 * 0.4 + tick * (0.1 + bright * 0.5)", "freq": "2400 + bright * 8000" },

    { "id": "fc1", "type": "clock", "rate": 7, "jitter": 0.6 },
    { "id": "fr1", "type": "rand", "lo": 0.9, "hi": 1.1, "trig": "fc1" },
    { "id": "wav1", "type": "lag", "in": "fr1", "time": 0.09 },
    { "id": "buzz1", "type": "osc", "wave": "saw", "freq": "(250 - size * 60) * rnd(0.96, 1.04) * wav1" },
    { "id": "band1", "type": "expr", "expr": "(1000 + bright * 1500) * rnd(0.92, 1.08)" },
    { "id": "thin1", "type": "filter", "mode": "bp", "in": "buzz1", "freq": "band1", "q": 6 },
    { "id": "fly1", "type": "filter", "mode": "bp", "in": "thin1", "freq": "band1", "q": 3 },
    { "id": "ang1", "type": "expr", "expr": "tau * (2 * t / dur + rnd(0, 1)) + 1.2 * sin(tau * (3 * t / dur + rnd(0, 1)))" },
    { "id": "near1", "type": "expr", "expr": "0.03 + 0.97 * pow(0.5 + 0.5 * cos(ang1), 3)" },
    { "id": "pan1", "type": "expr", "expr": "0.5 + 0.42 * sin(ang1)" },

    { "id": "f2", "type": "expr", "expr": "smooth(0.6, 0.8, flies)" },
    { "id": "fc2", "type": "clock", "rate": 9, "jitter": 0.6 },
    { "id": "fr2", "type": "rand", "lo": 0.9, "hi": 1.1, "trig": "fc2" },
    { "id": "wav2", "type": "lag", "in": "fr2", "time": 0.07 },
    { "id": "buzz2", "type": "osc", "wave": "saw", "freq": "(218 - size * 38) * rnd(0.96, 1.04) * wav2" },
    { "id": "band2", "type": "expr", "expr": "(1150 + bright * 1350) * rnd(0.92, 1.08)" },
    { "id": "thin2", "type": "filter", "mode": "bp", "in": "buzz2", "freq": "band2", "q": 7 },
    { "id": "fly2", "type": "filter", "mode": "bp", "in": "thin2", "freq": "band2", "q": 3 },
    { "id": "ang2", "type": "expr", "expr": "tau * (3 * t / dur + rnd(0, 1)) + 1.4 * sin(tau * (1 * t / dur + rnd(0, 1)))" },
    { "id": "near2", "type": "expr", "expr": "0.02 + 0.98 * pow(0.5 + 0.5 * cos(ang2), 4)" },
    { "id": "pan2", "type": "expr", "expr": "0.5 - 0.42 * sin(ang2)" },

    { "id": "flyL", "type": "expr", "expr": "flies * (fly1 * near1 * (1 - pan1) + fly2 * near2 * (1 - pan2) * f2 * 0.8)" },
    { "id": "flyR", "type": "expr", "expr": "flies * (fly1 * near1 * pan1 + fly2 * near2 * pan2 * f2 * 0.8)" },

    { "id": "gl", "type": "expr", "expr": "0.4 + gas * 0.6" },
    { "id": "sumL", "type": "filter", "mode": "hp", "in": "bedL * swell * 0.4 + (blupL * 0.5 + wet * 0.3 + fizz * 0.6) * gl + dripL * (0.35 + drip * 0.3) + flyL * 0.1", "freq": 30 },
    { "id": "sumR", "type": "filter", "mode": "hp", "in": "bedR * swell * 0.4 + (blupR * 0.5 + wet * 0.3 + fizz * 0.6) * gl + dripR * (0.35 + drip * 0.3) + flyR * 0.1", "freq": 30 }
  ],
  "out": ["sumL", "sumR"],
  "presets": {
    "Misty marsh": { "size": 0.5, "gas": 0.5, "bright": 0.4, "flies": 0.15, "drip": 0.5 },
    "Fly-ridden bog": { "size": 0.4, "gas": 0.6, "bright": 0.55, "flies": 0.95, "drip": 0.4 },
    "Dead water": { "size": 0.75, "gas": 0.1, "bright": 0.3, "flies": 0, "drip": 0 }
  }
}
