{
  "format": "sfxpatch/0.1",
  "id": "item-drop",
  "name": "Item drop",
  "category": "pickup",
  "description": "An item dropped or thrown away: it lands with a small thud and bounces up to twice, each bounce sooner and softer. A bag thumps and rustles, a wooden thing knocks, a metal thing clanks and rings. Change its weight, length, brightness, bounces and what it is.",
  "meta": {
    "type": "sfx",
    "role": "items/drop",
    "themes": ["neutral", "fantasy", "dungeon"],
    "gameTypes": ["top-down-rpg", "arcade", "roguelike-action", "platformer", "turn-based-rpg"],
    "words": ["drop", "item", "discard", "throw away", "toss", "bounce", "thud", "clank", "knock", "bag", "loot", "inventory", "land", "clatter"],
    "license": "draft"
  },
  "duration": "length",
  "params": [
    { "id": "weight", "label": "Weight", "min": 0.5, "max": 2, "default": 1, "scale": "log" },
    { "id": "length", "label": "Length", "unit": "s", "min": 0.15, "max": 0.55, "default": 0.3, "scale": "log" },
    { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.5 },
    { "id": "bounces", "label": "Bounces", "min": 0, "max": 2, "default": 1, "step": 1 },
    { "id": "thing", "label": "Item", "min": 0, "max": 2, "default": 0, "options": ["Bag", "Wooden", "Metal"] }
  ],
  "nodes": [
    { "id": "j", "type": "rand", "lo": 0.94, "hi": 1.06 },
    { "id": "j2", "type": "rand", "lo": 0.92, "hi": 1.08 },
    { "id": "isB", "type": "expr", "expr": "thing < 0.5 ? 1 : 0" },
    { "id": "isW", "type": "expr", "expr": "thing >= 0.5 && thing < 1.5 ? 1 : 0" },
    { "id": "isM", "type": "expr", "expr": "thing >= 1.5 ? 1 : 0" },
    { "id": "g1", "type": "expr", "expr": "bounces >= 0.5 ? 0.5 : 0" },
    { "id": "g2", "type": "expr", "expr": "bounces >= 1.5 ? 0.26 : 0" },
    { "id": "c1", "type": "clock", "rate": 1, "count": 1, "delay": "length*0.4*rnd(0.92, 1.08)" },
    { "id": "c2", "type": "clock", "rate": 1, "count": 1, "delay": "length*0.66*rnd(0.95, 1.05)" },
    { "id": "n", "type": "noise" },
    { "id": "k0", "type": "ad", "attack": 0.0003, "decay": 0.005, "curve": 2 },
    { "id": "k1", "type": "ad", "attack": 0.0003, "decay": 0.005, "curve": 2, "trig": "c1" },
    { "id": "k2", "type": "ad", "attack": 0.0003, "decay": 0.005, "curve": 2, "trig": "c2" },
    { "id": "kick", "type": "expr", "expr": "k0 + k1*g1 + k2*g2" },
    { "id": "a0", "type": "ad", "attack": 0.001, "decay": "length*0.3*(0.7 + 0.3*weight)", "curve": 2.4 },
    { "id": "a1", "type": "ad", "attack": 0.001, "decay": "length*0.22*(0.7 + 0.3*weight)", "curve": 2.4, "trig": "c1" },
    { "id": "a2", "type": "ad", "attack": 0.001, "decay": "length*0.16*(0.7 + 0.3*weight)", "curve": 2.4, "trig": "c2" },
    { "id": "amp", "type": "expr", "expr": "a0 + a1*g1 + a2*g2" },
    { "id": "s0", "type": "ad", "attack": 0.0005, "decay": "0.022 + 0.012*weight", "curve": 2.2 },
    { "id": "s1", "type": "ad", "attack": 0.0005, "decay": "0.018 + 0.01*weight", "curve": 2.2, "trig": "c1" },
    { "id": "s2", "type": "ad", "attack": 0.0005, "decay": "0.015 + 0.008*weight", "curve": 2.2, "trig": "c2" },
    { "id": "slapA", "type": "expr", "expr": "s0 + s1*g1 + s2*g2" },
    { "id": "th", "type": "osc", "wave": "sine", "freq": "(95 + 130*slapA)*pow(weight, -0.6)*j" },
    { "id": "slap", "type": "filter", "mode": "bp", "in": "n*slapA", "freq": "(420 + bright*380)*pow(weight, -0.5)*j2", "q": 0.9 },
    { "id": "rd", "type": "dust", "density": 700, "spread": 1 },
    { "id": "rGate", "type": "ad", "attack": 0.005, "decay": "length*0.95", "curve": 1.2 },
    { "id": "rustle", "type": "filter", "mode": "bp", "in": "(rd*3 + n*0.12)*(rGate*0.5 + amp*0.7)*isB", "freq": "(2000 + bright*2600)*pow(weight, -0.3)", "q": 0.7 },
    { "id": "exc", "type": "filter", "mode": "lp", "in": "n*kick", "freq": "1500 + bright*7000" },
    { "id": "knock", "type": "modal", "in": "exc*isW", "freq": "(520 + bright*90)*pow(weight, -0.6)*j", "ratios": [1, 2.4, 3.95, 5.6], "decay": "length*0.22*(0.7 + 0.3*weight)", "tilt": 0.7 },
    { "id": "hollow", "type": "modal", "in": "exc*isW", "freq": "(205 + bright*30)*pow(weight, -0.6)*j2", "ratios": [1, 1.62, 2.3], "decay": "length*0.3*(0.7 + 0.3*weight)", "tilt": 0.4 },
    { "id": "clank", "type": "modal", "in": "exc*isM", "freq": "(760 + bright*160)*pow(weight, -0.6)*j", "ratios": [1, 1.58, 2.31, 3.17, 4.43], "decay": "length*0.3*(0.7 + 0.3*weight)", "tilt": 0.8 },
    { "id": "ring", "type": "modal", "in": "exc*isM", "freq": "(1750 + bright*500)*pow(weight, -0.6)*j2", "ratios": [1, 2.76, 5.4], "decay": "length*0.95", "tilt": 0.5 },
    { "id": "sum", "type": "expr", "expr": "th*amp*(0.26*isB + 0.22*isW + 0.16*isM) + slap*(4.2*isB + 0.8*isW + 0.5*isM) + rustle*0.8 + knock*0.2 + hollow*0.12 + clank*0.2 + ring*0.12 + exc*(0.5*isW + 0.7*isM)" },
    { "id": "tone", "type": "filter", "mode": "lp", "in": "sum", "freq": "(2200 + bright*10000)*pow(weight, -0.5)" },
    { "id": "clean", "type": "filter", "mode": "hp", "in": "tone", "freq": 40 }
  ],
  "out": "clean",
  "presets": {
    "Drop bag": { "thing": 0, "bounces": 0, "weight": 1.3, "length": 0.28, "bright": 0.4 },
    "Drop tool": { "thing": 1, "bounces": 1, "weight": 1, "length": 0.3, "bright": 0.5 },
    "Drop weapon": { "thing": 2, "bounces": 2, "weight": 1.3, "length": 0.42, "bright": 0.6 }
  }
}
