{
  "format": "sfxpatch/0.1",
  "id": "beast-roar",
  "name": "Beast roar",
  "category": "impact",
  "description": "A made-up roar of a big furred animal: a rough falling voice with a thump in the chest that ends in a grunt, in a cave. Change its weight, length, how far it falls, its grit, its growl and the room.",
  "meta": {
    "type": "sfx",
    "role": "characters/voice",
    "themes": ["fantasy", "dungeon"],
    "gameTypes": ["top-down-rpg", "turn-based-rpg", "roguelike-action"],
    "words": ["roar", "beast", "growl", "monster", "boss", "animal", "bear", "mole", "groan", "grunt", "snarl", "voice", "death"],
    "license": "draft"
  },
  "duration": "clamp(length * (0.85 + weight * 0.3), 0.4, 1.6)",
  "params": [
    { "id": "weight", "label": "Weight", "min": 0, "max": 1, "default": 0.5 },
    { "id": "length", "label": "Length", "unit": "s", "min": 0.4, "max": 1.6, "default": 0.9, "scale": "log" },
    { "id": "drop", "label": "Drop", "unit": "semitones", "min": 0, "max": 12, "default": 5, "step": 1 },
    { "id": "grit", "label": "Grit", "min": 0, "max": 1, "default": 0.5 },
    { "id": "flutter", "label": "Growl", "min": 0, "max": 1, "default": 0.5 },
    { "id": "space", "label": "Room", "min": 0, "max": 0.3, "default": 0.12 }
  ],
  "nodes": [
    { "id": "f0", "type": "env", "points": [
      [0, "165 * semi(-weight * 10) * rnd(0.95, 1.05)"],
      ["dur * 0.07", "165 * semi(-weight * 10 + 1.5) * rnd(0.97, 1.03)", "exp"],
      ["dur * 0.5", "165 * semi(-weight * 10 - drop * 0.75)", "exp"],
      ["dur * 0.7", "165 * semi(-weight * 10 - drop * 0.9)", "exp"],
      ["dur * 0.78", "165 * semi(-weight * 10 - drop * 0.9 + 2)", "exp"],
      ["dur * 0.9", "165 * semi(-weight * 10 - drop - 2)", "exp"]
    ] },
    { "id": "wob", "type": "osc", "phase": 0.75, "freq": "(26 - weight * 6) * rnd(0.93, 1.05)" },
    { "id": "sa", "type": "osc", "wave": "saw", "freq": "f0" },
    { "id": "sq", "type": "osc", "wave": "square", "freq": "f0 * 0.5" },
    { "id": "hiss", "type": "noise", "color": "pink" },
    { "id": "rasp", "type": "shaper", "in": "sa * 0.6 + sq * 0.5 + hiss * grit * 0.15", "drive": "1.5 + grit * 7", "mode": "tanh" },
    { "id": "mouth", "type": "env", "points": [
      [0, "0.8 * (1.2 - weight * 0.4)"],
      ["dur * 0.1", "1.2 - weight * 0.4"],
      ["dur * 0.7", "0.72 * (1.2 - weight * 0.4)"],
      ["dur * 0.78", "0.8 * (1.2 - weight * 0.4)"],
      ["dur * 0.9", "0.667 * (1.2 - weight * 0.4)"]
    ] },
    { "id": "src", "type": "expr", "expr": "rasp + hiss * 0.35" },
    { "id": "fa", "type": "filter", "mode": "bp", "in": "src", "freq": "600 * mouth", "q": 3 },
    { "id": "fb", "type": "filter", "mode": "bp", "in": "src", "freq": "1300 * mouth", "q": 4 },
    { "id": "fc", "type": "filter", "mode": "bp", "in": "src", "freq": "2600 * mouth", "q": 4 },
    { "id": "voice", "type": "expr", "expr": "fa + fb * 0.8 + fc * (0.15 + grit * 0.75) + rasp * 0.14" },
    { "id": "swell", "type": "env", "points": [
      [0, 0.5],
      [0.03, 1],
      ["dur * 0.45", 0.85],
      ["dur * 0.69", 0.22],
      ["dur * 0.76", 0.9],
      ["dur * 0.9", 0, 1.6]
    ] },
    { "id": "growlAmp", "type": "expr", "expr": "1 - flutter * 0.9 * (0.5 + 0.5 * wob)" },
    { "id": "top", "type": "filter", "mode": "lp", "in": "voice * swell * growlAmp", "freq": "(1600 + grit * 6000) * (1.2 - weight * 0.4)" },
    { "id": "chestPitch", "type": "env", "points": [[0, 90], [0.06, 50, "exp"]] },
    { "id": "chestTone", "type": "osc", "freq": "chestPitch" },
    { "id": "chestAmp", "type": "ad", "attack": 0.003, "decay": 0.06, "curve": 1.5 },
    { "id": "body", "type": "shaper", "in": "top * 0.55 + chestTone * chestAmp * 0.6", "drive": 1.6, "mode": "tanh" },
    { "id": "dry", "type": "filter", "mode": "hp", "in": "body", "freq": 40 },
    { "id": "room", "type": "reverb", "in": "dry", "size": 0.55, "damp": 0.5, "mix": "space" },
    { "id": "fin", "type": "env", "points": [[0, 1], ["dur * 0.9", 1], ["dur * 0.995", 0, 1.5]] }
  ],
  "out": "room * fin",
  "presets": {
    "Roar": { "weight": 0.5, "length": 0.9, "drop": 5, "grit": 0.5, "flutter": 0.5, "space": 0.12 },
    "Short growl": { "length": 0.45, "drop": 2, "flutter": 0.8 },
    "Death groan": { "length": 1.5, "drop": 12, "weight": 0.8, "flutter": 0.3 }
  }
}
