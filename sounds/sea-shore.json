{
  "format": "sfxpatch/0.1",
  "id": "sea-shore",
  "name": "Sea shore",
  "category": "ambience",
  "description": "Waves on a beach: each one swells, breaks with a soft crash and draws back in a long hiss of foam, two to a loop. Change the size of the waves, the brightness, sand or pebbles, and how much foam.",
  "meta": {
    "type": "ambience",
    "role": "environment/ambience",
    "themes": ["neutral"],
    "gameTypes": ["top-down-rpg", "platformer", "farming-sim", "turn-based-rpg", "puzzle"],
    "words": ["sea", "ocean", "waves", "beach", "shore", "surf", "coast", "tide", "foam", "seaside", "pebbles", "island"],
    "license": "draft"
  },
  "loop": true,
  "normalize": false,
  "duration": 8,
  "params": [
    { "id": "size", "label": "Wave size", "min": 0, "max": 1, "default": 0.5, "hint": "Bigger waves are deeper, louder and take longer to break and draw back." },
    { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.5 },
    { "id": "beach", "label": "Beach", "min": 0, "max": 1, "default": 0, "options": ["Sand", "Pebbles"] },
    { "id": "foam", "label": "Foam", "min": 0, "max": 1, "default": 0.5 }
  ],
  "nodes": [
    { "id": "s", "type": "expr", "expr": "t % 4" },
    { "id": "second", "type": "expr", "expr": "(t % 8) >= 4 ? 1 : 0" },
    { "id": "brk", "type": "expr", "expr": "second ? 1.55 + size * 0.55 + rnd(-0.15, 0.15) : 1.35 + size * 0.55 + rnd(-0.1, 0.1)" },
    { "id": "lvl", "type": "expr", "expr": "second ? rnd(0.72, 0.88) : 1" },
    { "id": "draw", "type": "expr", "expr": "(second ? rnd(1.05, 1.3) : rnd(0.85, 1.05)) * (1.25 - size * 0.55)" },

    { "id": "swellRaw", "type": "expr", "expr": "s < brk ? pow(s / brk, 2.4) : exp(-(s - brk) * 3.2)" },
    { "id": "swellE", "type": "lag", "in": "swellRaw * lvl", "time": 0.08 },
    { "id": "crashRaw", "type": "expr", "expr": "s < brk ? 0 : smooth(0, 0.05, s - brk) * exp(-(s - brk) * 4.5)" },
    { "id": "crashE", "type": "lag", "in": "crashRaw * lvl", "time": 0.01 },
    { "id": "foamRaw", "type": "expr", "expr": "s < brk ? 0 : smooth(0.05, 0.45, s - brk) * exp(-(s - brk) * draw) * (1 - smooth(3.2, 3.98, s))" },
    { "id": "foamE", "type": "lag", "in": "foamRaw * lvl", "time": 0.06 },
    { "id": "rattleRaw", "type": "expr", "expr": "s < brk ? 0 : smooth(0.4, 1.0, s - brk) * exp(-(s - brk - 0.4) * draw * 1.3) * (1 - smooth(3.2, 3.98, s))" },
    { "id": "rattleE", "type": "lag", "in": "rattleRaw * lvl", "time": 0.08 },

    { "id": "nL", "type": "noise", "color": "pink" },
    { "id": "nR", "type": "noise", "color": "pink" },
    { "id": "deep", "type": "noise", "color": "brown" },
    { "id": "wL", "type": "noise" },
    { "id": "wR", "type": "noise" },

    { "id": "roarCut", "type": "expr", "expr": "(260 + swellE * (1500 - size * 700)) * (0.7 + bright * 0.6)" },
    { "id": "roarL", "type": "filter", "mode": "lp", "in": "nL * 0.7 + deep * 0.6", "freq": "roarCut", "q": 0.8 },
    { "id": "roarR", "type": "filter", "mode": "lp", "in": "nR * 0.7 + deep * 0.6", "freq": "roarCut * 1.05", "q": 0.8 },
    { "id": "roarMid", "type": "filter", "mode": "bp", "in": "nL * 0.5 + nR * 0.5", "freq": "(500 + swellE * 600) * (1.15 - size * 0.35)", "q": 0.9 },

    { "id": "crashL", "type": "filter", "mode": "bp", "in": "nL", "freq": "(1500 - size * 600) * (0.8 + bright * 0.5)", "q": 0.6 },
    { "id": "crashR", "type": "filter", "mode": "bp", "in": "nR", "freq": "(1600 - size * 600) * (0.8 + bright * 0.5)", "q": 0.6 },

    { "id": "foamCut", "type": "expr", "expr": "(2200 + bright * 3500) * (0.65 + foamE * 0.5)" },
    { "id": "foamL", "type": "filter", "mode": "bp", "in": "wL", "freq": "foamCut", "q": 0.7 },
    { "id": "foamR", "type": "filter", "mode": "bp", "in": "wR", "freq": "foamCut * 1.1", "q": 0.7 },

    { "id": "stonesL", "type": "dust", "density": "rattleE * (1800 + size * 1400)", "spread": 0.8 },
    { "id": "stonesR", "type": "dust", "density": "rattleE * (1800 + size * 1400)", "spread": 0.8 },
    { "id": "clackL", "type": "filter", "mode": "bp", "in": "stonesL", "freq": "2600 + bright * 1800", "q": 2.5 },
    { "id": "clackR", "type": "filter", "mode": "bp", "in": "stonesR", "freq": "3100 + bright * 1800", "q": 2.5 },

    { "id": "big", "type": "expr", "expr": "0.45 + size * 0.55" },
    { "id": "bedL", "type": "expr", "expr": "roarL * swellE * 0.55 + roarMid * swellE * 0.5 + crashL * crashE * 0.75 + foamL * foamE * (0.1 + foam * 0.55) * (1 - beach * 0.55) + clackL * rattleE * beach * 3 * (1.15 - size * 0.55)" },
    { "id": "bedR", "type": "expr", "expr": "roarR * swellE * 0.55 + roarMid * swellE * 0.5 + crashR * crashE * 0.75 + foamR * foamE * (0.1 + foam * 0.55) * (1 - beach * 0.55) + clackR * rattleE * beach * 3 * (1.15 - size * 0.55)" },
    { "id": "air", "type": "expr", "expr": "0.09 + foam * 0.05" },
    { "id": "outL", "type": "filter", "mode": "hp", "in": "(bedL + (roarL * 0.5 + roarMid * 0.6 + foamL * 0.12) * air) * big * 1.4", "freq": 35 },
    { "id": "outR", "type": "filter", "mode": "hp", "in": "(bedR + (roarR * 0.5 + roarMid * 0.6 + foamR * 0.12) * air) * big * 1.4", "freq": 35 }
  ],
  "out": ["tanh(outL * 1.15)", "tanh(outR * 1.15)"],
  "presets": {
    "Calm bay": { "size": 0.2, "bright": 0.45, "beach": 0, "foam": 0.35 },
    "Pebble beach": { "size": 0.5, "bright": 0.55, "beach": 1, "foam": 0.5 },
    "Rough sea": { "size": 1, "bright": 0.6, "beach": 0, "foam": 0.85 }
  }
}
