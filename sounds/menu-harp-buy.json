{
  "format": "sfxpatch/0.1",
  "id": "menu-harp-buy",
  "name": "Harp buy",
  "category": "ui",
  "description": "Buying or equipping in a shop: a knuckle knock on a small harp's hollow wooden box, then three warm plucked string notes that climb and ring into each other (two for equipping), the same every time. Change its pitch, speed, brightness, how many notes and how loud the knock is.",
  "meta": {
    "type": "sfx",
    "role": "interface/confirm",
    "themes": ["neutral", "fantasy"],
    "gameTypes": ["arcade", "card-game", "turn-based-rpg", "farming-sim", "top-down-rpg"],
    "words": ["menu", "buy", "shop", "purchase", "equip", "trade", "store", "spend", "harp", "plucked", "string", "knock", "button"],
    "license": "draft"
  },
  "duration": "3.6 / speed",
  "params": [
    { "id": "pitch", "label": "Pitch", "unit": "Hz", "min": 220, "max": 520, "default": 330, "scale": "log" },
    { "id": "speed", "label": "Speed", "unit": "notes/s", "min": 6, "max": 13, "default": 9, "scale": "log" },
    { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.55 },
    { "id": "notes", "label": "Notes", "min": 2, "max": 3, "default": 3, "step": 1 },
    { "id": "knock", "label": "Knock", "min": 0, "max": 1, "default": 0.5 }
  ],
  "nodes": [
    { "id": "tickA", "type": "ad", "attack": 0.0003, "decay": 0.002, "curve": 1.5 },
    { "id": "fingerA", "type": "filter", "mode": "lp", "in": "tickA", "freq": "1800 + bright * 6000", "q": 0.6 },
    { "id": "stringA", "type": "pluck", "freq": "pitch", "decay": "5.5 / speed", "damp": "0.5 - bright * 0.25", "in": "fingerA", "trig": 0 },

    { "id": "c2", "type": "clock", "rate": 1, "count": 1, "delay": "1 / speed" },
    { "id": "tickB", "type": "ad", "attack": 0.0003, "decay": 0.002, "curve": 1.5, "trig": "c2" },
    { "id": "fingerB", "type": "filter", "mode": "lp", "in": "tickB", "freq": "1800 + bright * 6000", "q": 0.6 },
    { "id": "stringB", "type": "pluck", "freq": "pitch * semi(7)", "decay": "(notes > 2.5 ? 4.5 : 5.5) / speed", "damp": "0.5 - bright * 0.25", "in": "fingerB", "trig": 0 },

    { "id": "c3", "type": "clock", "rate": 1, "count": "notes > 2.5 ? 1 : 0", "delay": "2 / speed" },
    { "id": "tickC", "type": "ad", "attack": 0.0003, "decay": 0.002, "curve": 1.5, "trig": "c3" },
    { "id": "fingerC", "type": "filter", "mode": "lp", "in": "tickC", "freq": "1800 + bright * 6000", "q": 0.6 },
    { "id": "stringC", "type": "pluck", "freq": "pitch * semi(9)", "decay": "3.4 / speed", "damp": "0.5 - bright * 0.25", "in": "fingerC", "trig": 0 },

    { "id": "strings", "type": "expr", "expr": "stringA + stringB * 0.95 + stringC * 1.05" },
    { "id": "boxLow", "type": "filter", "mode": "bp", "in": "strings", "freq": 230, "q": 1.4 },
    { "id": "boxHigh", "type": "filter", "mode": "bp", "in": "strings", "freq": 470, "q": 1.4 },

    { "id": "k2", "type": "clock", "rate": 1, "count": 1, "delay": "(notes - 1) / speed" },
    { "id": "rapA", "type": "ad", "attack": 0.0004, "decay": 0.003, "curve": 2 },
    { "id": "rapB", "type": "ad", "attack": 0.0004, "decay": 0.003, "curve": 2, "trig": "k2" },
    { "id": "knuckle", "type": "filter", "mode": "lp", "in": "rapA + rapB * 0.55 * clamp((knock - 0.6) / 0.4, 0, 1)", "freq": 900, "q": 0.6 },
    { "id": "box", "type": "modal", "in": "knuckle", "freq": 230, "ratios": [1, 2.04, 3.6], "gains": [1, 1, 0.4], "decay": 0.085, "tilt": 1.1 },

    { "id": "fade", "type": "env", "points": [[0, 1], ["2.7 / speed", 1], ["3.6 / speed", 0]] },
    { "id": "sum", "type": "expr", "expr": "(strings + (boxLow * 1.1 + boxHigh * 1.3) * 0.8) * fade + box * knock * 0.05" },
    { "id": "tone", "type": "filter", "mode": "lp", "in": "sum", "freq": "2200 + bright * 8000", "q": 0.6 },
    { "id": "clean", "type": "filter", "mode": "hp", "in": "tone", "freq": 90 }
  ],
  "out": "clean",
  "presets": {
    "Buy": { "pitch": 330, "speed": 9, "bright": 0.55, "notes": 3, "knock": 0.5 },
    "Equip": { "pitch": 330, "speed": 8, "bright": 0.5, "notes": 2, "knock": 0.4 }
  }
}
