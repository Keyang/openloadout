{
  "format": "sfxpatch/0.1",
  "id": "board-clear",
  "name": "Board clear",
  "category": "jingle",
  "description": "The whole field is empty: a short bright bell tune that climbs in two steps, the second starting higher, and lands on a held ringing chord with a shimmering roll. Change its pitch, the time between notes, the brightness and the room. The same every time.",
  "meta": {
    "type": "jingle",
    "role": "interface/reward",
    "themes": ["neutral"],
    "gameTypes": ["puzzle", "arcade"],
    "words": ["board", "clear", "all clear", "perfect", "empty", "field", "wipe", "bells", "chime", "tune", "reward", "bonus", "win", "sparkle"],
    "license": "draft"
  },
  "duration": "speed * 7 + 0.84 + space * 0.9",
  "params": [
    { "id": "pitch", "label": "Pitch", "unit": "Hz", "min": 260, "max": 700, "default": 392, "scale": "log" },
    { "id": "speed", "label": "Time between notes", "unit": "s", "min": 0.08, "max": 0.16, "default": 0.11 },
    { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.6 },
    { "id": "space", "label": "Room", "min": 0, "max": 0.25, "default": 0.12 }
  ],
  "nodes": [
    { "id": "beat", "type": "clock", "rate": "1 / speed", "count": 8 },
    { "id": "hit", "type": "pattern", "trig": "beat", "steps": "XXX.XXXX" },
    { "id": "note", "type": "seq", "steps": [-5, -3, 0, 2, 5, 7, 12], "trig": "hit" },
    { "id": "hz", "type": "expr", "expr": "pitch * semi(note)" },

    { "id": "glint", "type": "ad", "attack": 0.001, "decay": "speed * 1.1 + 0.04", "curve": 2, "trig": "hit" },
    { "id": "partial", "type": "osc", "wave": "sine", "freq": "hz * 6" },
    { "id": "bell", "type": "osc", "wave": "sine", "freq": "hz * 2", "pm": "partial * glint * (0.05 + bright * 0.4)" },
    { "id": "bellAmp", "type": "ad", "attack": 0.002, "decay": "speed * 2.2 + 0.12", "curve": 2.4, "trig": "hit" },
    { "id": "sq", "type": "osc", "wave": "square", "freq": "hz" },
    { "id": "sqSoft", "type": "filter", "mode": "lp", "in": "sq", "freq": "700 + bright * 2600", "q": 0.6 },
    { "id": "sqAmp", "type": "ad", "attack": 0.004, "hold": "speed * 0.35", "decay": "speed * 0.9", "curve": 1.8, "trig": "hit" },
    { "id": "tune", "type": "expr", "expr": "bell * bellAmp * 0.7 + sqSoft * sqAmp * 0.3" },

    { "id": "land", "type": "clock", "rate": 1, "count": 1, "delay": "speed * 7" },
    { "id": "holdAmp", "type": "ad", "attack": 0.003, "hold": 0.06, "decay": "0.7 + space * 0.9", "curve": 2.2, "trig": "land" },
    { "id": "holdGlint", "type": "ad", "attack": 0.001, "decay": 0.35, "curve": 1.6, "trig": "land" },
    { "id": "topPart", "type": "osc", "wave": "sine", "freq": "pitch * 12" },
    { "id": "top", "type": "osc", "wave": "sine", "freq": "pitch * 4", "pm": "topPart * holdGlint * (0.04 + bright * 0.3)" },
    { "id": "fifthBell", "type": "osc", "wave": "sine", "freq": "pitch * semi(7) * 2" },
    { "id": "rootSq", "type": "osc", "wave": "square", "freq": "pitch" },
    { "id": "fifthSq", "type": "osc", "wave": "square", "freq": "pitch * semi(7)" },
    { "id": "padSoft", "type": "filter", "mode": "lp", "in": "rootSq * 0.55 + fifthSq * 0.45", "freq": "600 + bright * 2200", "q": 0.6 },
    { "id": "chord", "type": "expr", "expr": "(top * 0.4 + fifthBell * 0.34 + padSoft * 0.3) * holdAmp" },

    { "id": "rollTick", "type": "clock", "rate": 22, "count": 12, "delay": "speed * 7 + 0.05" },
    { "id": "rollNote", "type": "seq", "steps": [12, 19, 24, 19], "trig": "rollTick", "loop": true },
    { "id": "rollAmp", "type": "ad", "attack": 0.001, "decay": 0.07, "curve": 2, "trig": "rollTick" },
    { "id": "rollFade", "type": "ad", "attack": 0.02, "hold": 0.1, "decay": 0.5, "curve": 1.4, "trig": "land" },
    { "id": "rollTone", "type": "osc", "wave": "sine", "freq": "pitch * 2 * semi(rollNote)" },
    { "id": "roll", "type": "expr", "expr": "rollTone * rollAmp * rollFade * (0.12 + bright * 0.3)" },

    { "id": "sum", "type": "expr", "expr": "tune + chord * 0.8 + roll" },
    { "id": "tone", "type": "filter", "mode": "lp", "in": "sum", "freq": "2200 + bright * 11000", "q": 0.6 },
    { "id": "room", "type": "reverb", "in": "tone", "size": 0.6, "damp": 0.35, "mix": "space * 2" },
    { "id": "clean", "type": "filter", "mode": "hp", "in": "room", "freq": 40 }
  ],
  "out": "clean * (1 - smooth(dur - 0.25, dur - 0.005, t))",
  "presets": {
    "All clear": {},
    "Small clear": { "speed": 0.08, "space": 0.05 },
    "Perfect round": { "space": 0.25, "bright": 0.85 }
  }
}
