{
  "format": "sfxpatch/0.1",
  "id": "item-get",
  "name": "Item get",
  "category": "pickup",
  "description": "Any ordinary item put in the bag: a soft pop with a short plain two-note \"got it\" that jumps up. Change its pitch, speed, brightness and how much pop. The same every time.",
  "meta": {
    "type": "sfx",
    "role": "items/pickup",
    "themes": ["neutral", "fantasy", "sci-fi"],
    "gameTypes": ["arcade", "top-down-rpg", "turn-based-rpg", "platformer", "roguelike-action"],
    "words": ["item", "get", "got it", "pickup", "collect", "loot", "bag", "inventory", "grab", "take", "pop", "plain"],
    "license": "draft"
  },
  "duration": "1/speed + 0.16 + 0.05*(1 - bright)^2",
  "params": [
    { "id": "pitch", "label": "Pitch", "unit": "Hz", "min": 330, "max": 1000, "default": 523, "scale": "log" },
    { "id": "speed", "label": "Speed", "unit": "notes/s", "min": 9, "max": 18, "default": 12, "scale": "log" },
    { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.4 },
    { "id": "pop", "label": "Pop", "min": 0, "max": 1, "default": 0.5 }
  ],
  "nodes": [
    { "id": "clk", "type": "clock", "rate": "speed", "count": 2 },
    { "id": "note", "type": "seq", "steps": ["pitch", "pitch*2"], "trig": "clk" },
    { "id": "lastClk", "type": "clock", "rate": 1, "count": 1, "delay": "1/speed" },
    { "id": "ampFirst", "type": "ad", "attack": 0.003, "decay": "0.95/speed", "curve": 1.8, "trig": "clk" },
    { "id": "ampLast", "type": "ad", "attack": 0.003, "hold": 0.02, "decay": 0.13, "curve": 2.4, "trig": "lastClk" },
    { "id": "isLast", "type": "expr", "expr": "t >= 1/speed - 0.0005 ? 1 : 0" },
    { "id": "amp", "type": "expr", "expr": "isLast ? ampLast*0.85 : ampFirst" },
    { "id": "sn", "type": "osc", "wave": "sine", "freq": "note" },
    { "id": "tr", "type": "osc", "wave": "tri", "freq": "note" },
    { "id": "sq", "type": "osc", "wave": "pulse", "width": 0.3, "freq": "note" },
    { "id": "body", "type": "expr", "expr": "sn*clamp(1 - bright*1.4, 0, 1)*0.7 + tr*0.55 + sq*bright*0.4" },
    { "id": "tone", "type": "filter", "mode": "lp", "in": "body", "freq": "note*(3 + bright*12)", "q": 0.7 },
    { "id": "crushed", "type": "crush", "in": "tone", "bits": 5, "rate": 8000 },
    { "id": "tune", "type": "expr", "expr": "mix(tone, crushed, smooth(0.7, 1, bright)*0.7)*amp" },
    { "id": "popPitch", "type": "env", "points": [[0, "pitch*1.6"], [0.03, "pitch*0.6", "exp"]] },
    { "id": "popOsc", "type": "osc", "wave": "sine", "freq": "popPitch" },
    { "id": "popAmp", "type": "ad", "attack": 0.0008, "decay": "0.025 + pop*0.02", "curve": 2.2 },
    { "id": "hiss", "type": "noise", "seed": 5 },
    { "id": "tickAmp", "type": "ad", "attack": 0.0003, "decay": 0.004, "curve": 2 },
    { "id": "tick", "type": "filter", "mode": "bp", "in": "hiss", "freq": "1500 + bright*2500", "q": 1 },
    { "id": "popL", "type": "expr", "expr": "(popOsc*popAmp + tick*tickAmp*0.5)*pop" },
    { "id": "dry", "type": "expr", "expr": "tune + popL*1.3" },
    { "id": "room", "type": "reverb", "in": "dry", "size": 0.3, "damp": 0.5, "mix": "0.12*(1 - bright)^2" },
    { "id": "clean", "type": "filter", "mode": "hp", "in": "room", "freq": 180, "q": 0.7 }
  ],
  "out": "clean",
  "presets": {
    "Chiptune": { "pitch": 587, "speed": 14, "bright": 0.6, "pop": 0.3 },
    "Storybook": { "pitch": 440, "speed": 10, "bright": 0.1, "pop": 0.7 },
    "Gritty": { "pitch": 523, "speed": 16, "bright": 0.95, "pop": 0.5 }
  }
}
