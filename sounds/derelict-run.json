   "expr": "rsN*rsE*rsE"
  },
  {
   "id": "duck",
   "type": "expr",
   "expr": "1 - kA*gBeat*0.35"
  },
  {
   "id": "ctr",
   "type": "expr",
   "expr": "kD*0.82/(1.06 + 1.1*grit)*gBeat + dC + bD*0.42*(1 - 0.44*smooth(0, 0.5, grit))*(0.7 + 0.3*gOpen)*gBed"
  },
  {
   "id": "muL",
   "type": "expr",
   "expr": "(pL*0.6*gBed*(1 - 0.4*gTune*lead) + arL*0.34*gArp*(1 - 0.67*gTune*lead) + aeO*0.11*gArp*(1 - 0.67*gTune*lead) + lF*lead*1.1*gTune*gLift + ecO*0.55*lead*gTop + rsO*0.45*gRise)*duck"
  },
  {
   "id": "muR",
   "type": "expr",
   "expr": "(pR*0.6*gBed*(1 - 0.4*gTune*lead) + arL*0.18*gArp*(1 - 0.67*gTune*lead) + aeO*0.26*gArp*(1 - 0.67*gTune*lead) + lF*lead*1.1*gTune*gLift + ecO*0.25*lead*gTop + rsO*0.45*gRise)*duck"
  },
  {
   "id": "rv",
   "type": "reverb",
   "in": "(muL + muR)*0.5 + (dC*0.35)",
   "size": 0.85,
   "damp": 0.35,
   "mix": 1
  },
  {
   "id": "mL",
   "type": "shaper",
   "in": "(ctr + muL + rv*space*2)*0.49",
   "drive": "1 + grit*0.25"
  },
  {
   "id": "mR",
   "type": "shaper",
   "in": "(ctr + muR + rv*space*2)*0.49",
   "drive": "1 + grit*0.25"
  }
 ],
 "out": [
  "mL",
  "mR"
 ],
