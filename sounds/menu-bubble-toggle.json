{
 "format": "sfxpatch/0.1",
 "id": "menu-bubble-toggle",
 "name": "Bubble toggle",
 "category": "ui",
 "description": "A switch or checkbox: one water drop with a wet pop that bloops up to its note when switched on and sinks down when switched off. Change its pitch, length, brightness, how far it bloops and which way the switch goes.",
 "meta": {
  "type": "sfx",
  "role": "interface/click",
  "themes": ["neutral", "underwater"],
  "gameTypes": ["arcade", "puzzle", "card-game", "platformer"],
  "words": ["bubble", "drop", "bloop", "toggle", "switch", "checkbox", "on", "off", "setting", "option", "menu", "water", "wet"],
  "license": "draft"
 },
 "duration": "length + 0.1",
 "params": [
  { "id": "pitch", "label": "Pitch", "unit": "Hz", "min": 350, "max": 900, "default": 560, "scale": "log" },
  { "id": "length", "label": "Length", "unit": "s", "min": 0.08, "max": 0.2, "default": 0.12, "scale": "log" },
  { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.5 },
  { "id": "bloop", "label": "Bloop", "unit": "semitones", "min": 0, "max": 12, "default": 6, "hint": "How far the drop jumps up (on) or sinks down (off) as it sounds" },
  { "id": "dir", "label": "Switch", "min": 0, "max": 1, "default": 1, "options": ["Off", "On"] }
 ],
 "nodes": [
  { "id": "t0", "type": "clock", "rate": 1, "count": 1 },
  { "id": "j0", "type": "env", "trig": "t0", "points": [[0, "dir > 0.5 ? semi(-bloop) : 1"], ["clamp(length * 0.35, 0.02, 0.05)", "dir > 0.5 ? 1 : semi(-bloop - 1)", "exp"]] },
  { "id": "a0", "type": "ad", "trig": "t0", "attack": 0.0025, "hold": "length * 0.25", "decay": "length * 0.75", "curve": 2 },
  { "id": "f0", "type": "expr", "expr": "pitch * j0" },
  { "id": "o0", "type": "osc", "freq": "f0" },
  { "id": "h0", "type": "osc", "freq": "f0 * 2" },
  { "id": "n0", "type": "expr", "expr": "(o0 + h0 * (0.04 + bright * 0.3)) * a0 * 1" },
  { "id": "pe0", "type": "ad", "trig": "t0", "attack": 0.0003, "decay": 0.007, "curve": 3 },
  { "id": "pf0", "type": "env", "trig": "t0", "points": [[0, "pitch * 3"], [0.007, "pitch * 6", "exp"]] },
  { "id": "po0", "type": "osc", "wave": "square", "freq": "pf0" },
  { "id": "p0", "type": "expr", "expr": "po0 * pe0 * (dir > 0.5 ? 1 : 0.7)" },
  { "id": "body", "type": "expr", "expr": "n0" },
  { "id": "popmix", "type": "filter", "mode": "bp", "in": "p0", "freq": "1800 + bright * 1800", "q": 1.3 },
  { "id": "dry", "type": "expr", "expr": "body + popmix * (0.6 + bright * 0.9)" },
  { "id": "wet", "type": "reverb", "in": "dry", "size": 0.08, "damp": 0.7, "mix": 1 },
  { "id": "wetlp", "type": "filter", "mode": "lp", "in": "wet", "freq": 2500 },
  { "id": "clean", "type": "filter", "mode": "hp", "in": "dry + wetlp * 0.25", "freq": 90 }
 ],
 "out": "clean",
 "presets": {
  "Switch on": { "pitch": 560, "length": 0.12, "bright": 0.55, "bloop": 6, "dir": 1 },
  "Switch off": { "pitch": 560, "length": 0.12, "bright": 0.45, "bloop": 6, "dir": 0 }
 }
}
