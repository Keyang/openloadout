   "mode": "lp",
   "in": "rep",
   "freq": "1500 + bright*1500",
   "q": 0.6
  },
  {
   "id": "clean",
   "type": "filter",
   "mode": "hp",
   "in": "tone + soft*echo",
   "freq": 120
