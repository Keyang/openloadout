{
 "format": "sfxpatch/0.1",
 "id": "secret-found",
 "name": "Secret found",
 "category": "jingle",
 "description": "A hidden room or a solved puzzle: three hushed, wandering notes, then a leap up to a bright, shining chord. Change its pitch, speed, brightness and room. The same every time.",
 "meta": {
  "type": "jingle",
  "role": "interface/reward",
  "themes": [
   "neutral",
   "fantasy",
   "dungeon"
  ],
  "gameTypes": [
   "arcade",
   "puzzle",
   "platformer",
   "top-down-rpg",
   "turn-based-rpg"
  ],
  "words": [
   "secret",
   "hidden",
   "discover",
   "found",
   "puzzle",
   "solved",
   "reveal",
   "mystery",
   "unlock",
   "jingle",
   "sting",
   "reward"
  ],
  "license": "draft"
 },
 "duration": "7/speed + 0.05 + 0.55*0.85 + space*0.6 + 0.05",
 "params": [
  {
   "id": "pitch",
   "label": "Pitch",
   "min": 330,
   "max": 880,
   "default": 523,
   "unit": "Hz",
   "scale": "log"
  },
  {
   "id": "speed",
   "label": "Speed",
   "min": 8.5,
   "max": 12.5,
   "default": 10,
   "unit": "notes/s"
  },
  {
   "id": "bright",
   "label": "Brightness",
   "min": 0,
   "max": 1,
   "default": 0.45
  },
  {
   "id": "space",
   "label": "Room",
   "min": 0,
   "max": 0.4,
   "default": 0.12
  }
 ],
 "nodes": [
  {
   "id": "wSoft",
   "type": "expr",
   "expr": "1 - smooth(0.1, 0.75, bright)"
  },
  {
   "id": "wGrit",
   "type": "expr",
   "expr": "smooth(0.65, 0.95, bright)"
  },
  {
   "id": "wChip",
   "type": "expr",
   "expr": "clamp(1 - wSoft - wGrit, 0, 1)"
  },
  {
   "id": "clk",
   "type": "clock",
   "rate": "speed",
   "count": 8
  },
  {
   "id": "hit",
   "type": "pattern",
   "trig": "clk",
   "steps": "X.X.X..X"
  },
  {
   "id": "note",
   "type": "seq",
   "steps": [
    "pitch*semi(0)",
    "pitch*semi(3)",
    "pitch*semi(1)",
    "pitch*semi(12)"
   ],
   "trig": "hit"
  },
  {
   "id": "endClk",
   "type": "clock",
   "rate": 1,
   "count": 1,
   "delay": "7/speed"
  },
  {
   "id": "aShort",
   "type": "ad",
   "attack": "0.003 + 0.01*(1 - smooth(0.1, 0.75, bright))",
   "hold": "0.6/speed",
   "decay": "(1 - 0.35*smooth(0.65, 0.95, bright))*1.6/speed",
   "curve": 2,
   "trig": "hit"
  },
  {
   "id": "aLast",
   "type": "ad",
   "attack": "0.003 + 0.01*(1 - smooth(0.1, 0.75, bright))",
   "hold": 0.05,
   "decay": "(1 - 0.35*smooth(0.65, 0.95, bright))*0.55",
   "curve": 2.2,
   "trig": "endClk"
  },
  {
   "id": "isLast",
   "type": "expr",
   "expr": "t >= 7/speed - 0.0005 ? 1 : 0"
  },
  {
   "id": "amp",
   "type": "expr",
   "expr": "isLast ? aLast : aShort"
  },
  {
   "id": "mSin",
   "type": "osc",
   "freq": "note"
  },
  {
   "id": "mTri",
   "type": "osc",
   "wave": "tri",
   "freq": "note*2"
  },
  {
   "id": "mSq",
   "type": "osc",
   "wave": "square",
   "freq": "note"
  },
  {
   "id": "mPl",
   "type": "osc",
   "wave": "pulse",
   "width": 0.25,
   "freq": "note*2"
  },
  {
   "id": "mBell",
   "type": "modal",
   "in": "hit",
   "freq": "note*2",
   "ratios": [
    1,
    2.76,
    5.4
   ],
   "gains": [
    1,
    0.4,
    0.15
   ],
   "decay": "0.35",
   "tilt": 0.7
  },
  {
   "id": "mFold",
   "type": "shaper",
   "in": "mSq*0.6 + mPl*0.3",
   "drive": 3.5,
   "mode": "fold"
  },
  {
   "id": "mMix",
   "type": "expr",
   "expr": "(mSin*0.75 + mTri*0.12)*wSoft + (mSq*0.32 + mPl*0.12)*wChip + mFold*0.3*wGrit"
  },
  {
   "id": "mBellMix",
   "type": "expr",
   "expr": "mBell*0.35*wSoft"
  },
  {
   "id": "c0",
   "type": "expr",
   "expr": "pitch*semi(16)"
  },
  {
   "id": "c0Sin",
   "type": "osc",
   "freq": "c0"
  },
  {
   "id": "c0Tri",
   "type": "osc",
   "wave": "tri",
   "freq": "c0*2"
  },
  {
   "id": "c0Sq",
   "type": "osc",
   "wave": "square",
   "freq": "c0"
  },
  {
   "id": "c0Pl",
   "type": "osc",
   "wave": "pulse",
   "width": 0.25,
   "freq": "c0*2"
  },
  {
   "id": "c0Bell",
   "type": "modal",
   "in": "endClk",
   "freq": "c0*2",
   "ratios": [
    1,
    2.76,
    5.4
   ],
   "gains": [
    1,
    0.4,
    0.15
   ],
   "decay": "0.55*0.8",
   "tilt": 0.7
  },
  {
   "id": "c0Fold",
   "type": "shaper",
   "in": "c0Sq*0.6 + c0Pl*0.3",
   "drive": 3.5,
   "mode": "fold"
  },
  {
   "id": "c0Mix",
   "type": "expr",
   "expr": "(c0Sin*0.75 + c0Tri*0.12)*wSoft + (c0Sq*0.32 + c0Pl*0.12)*wChip + c0Fold*0.3*wGrit"
  },
  {
   "id": "c0BellMix",
   "type": "expr",
   "expr": "c0Bell*0.3*wSoft"
  },
  {
   "id": "c1",
   "type": "expr",
   "expr": "pitch*semi(19)"
  },
  {
   "id": "c1Sin",
   "type": "osc",
   "freq": "c1"
  },
  {
   "id": "c1Tri",
   "type": "osc",
   "wave": "tri",
   "freq": "c1*2"
  },
  {
   "id": "c1Sq",
   "type": "osc",
   "wave": "square",
   "freq": "c1"
  },
  {
   "id": "c1Pl",
   "type": "osc",
   "wave": "pulse",
   "width": 0.25,
   "freq": "c1*2"
  },
  {
   "id": "c1Bell",
   "type": "modal",
   "in": "endClk",
   "freq": "c1*2",
   "ratios": [
    1,
    2.76,
    5.4
   ],
   "gains": [
    1,
    0.4,
    0.15
   ],
   "decay": "0.55*0.8",
   "tilt": 0.7
  },
  {
   "id": "c1Fold",
   "type": "shaper",
   "in": "c1Sq*0.6 + c1Pl*0.3",
   "drive": 3.5,
   "mode": "fold"
  },
  {
   "id": "c1Mix",
   "type": "expr",
   "expr": "(c1Sin*0.75 + c1Tri*0.12)*wSoft + (c1Sq*0.32 + c1Pl*0.12)*wChip + c1Fold*0.3*wGrit"
  },
  {
   "id": "c1BellMix",
   "type": "expr",
   "expr": "c1Bell*0.3*wSoft"
  },
  {
   "id": "lead",
   "type": "expr",
   "expr": "(mMix*amp + mBellMix)*1"
  },
  {
   "id": "chord",
   "type": "expr",
   "expr": "((c0Mix + c0BellMix)*0.32 + (c1Mix + c1BellMix)*0.28)*aLast"
  },
  {
   "id": "tone",
   "type": "filter",
   "mode": "lp",
   "in": "lead + chord",
   "freq": "(isLast ? 1 : 0.45)*(1400 + bright*9000)",
   "q": 0.6
  },
  {
   "id": "crushed",
   "type": "crush",
   "in": "tone",
   "bits": 6,
   "rate": 12000
  },
  {
   "id": "gritMix",
   "type": "expr",
   "expr": "tone*(1 - wGrit*0.7) + crushed*wGrit*0.7"
  },
  {
   "id": "hpf",
   "type": "filter",
   "mode": "hp",
   "in": "gritMix",
   "freq": 60
  },
  {
   "id": "room",
   "type": "reverb",
   "in": "hpf",
   "size": 0.65,
   "damp": 0.45,
   "mix": "space"
  }
 ],
 "out": "room*(1 - smooth(dur - 0.3, dur - 0.005, t))",
 "presets": {
  "Chiptune": {
   "bright": 0.68,
   "space": 0,
   "speed": 11
  },
  "Storybook": {
   "bright": 0.05,
   "space": 0.25,
   "speed": 9
  },
  "Gritty": {
   "bright": 0.97,
   "space": 0,
   "speed": 11.5
  }
 }
}
