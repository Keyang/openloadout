{
  "format": "sfxpatch/0.1",
  "id": "menu-wood-confirm",
  "name": "Wood confirm",
  "category": "ui",
  "description": "Choosing an item: a quick double tap on a little tuned wooden bar, then a brighter, longer note well above it, the same every time. Change its pitch, speed, brightness and how loud the quick first tap is.",
  "meta": {
    "type": "sfx",
    "role": "interface/confirm",
    "themes": ["neutral", "fantasy"],
    "gameTypes": ["arcade", "puzzle", "card-game", "turn-based-rpg", "top-down-rpg"],
    "words": ["menu", "confirm", "select", "accept", "choose", "ok", "start", "wooden", "marimba", "tap", "button", "yes"],
    "license": "draft"
  },
  "duration": "0.025 + 2 / speed",
  "params": [
    { "id": "pitch", "label": "Pitch", "unit": "Hz", "min": 440, "max": 1000, "default": 660, "scale": "log" },
    { "id": "speed", "label": "Speed", "unit": "notes/s", "min": 6.2, "max": 16, "default": 10, "scale": "log" },
    { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.5 },
    { "id": "flam", "label": "Flam", "min": 0, "max": 1, "default": 0.5 }
  ],
  "nodes": [
    { "id": "hitA", "type": "ad", "attack": 0.0004, "decay": 0.0012, "curve": 2 },
    { "id": "c2", "type": "clock", "rate": 1, "count": 1, "delay": "0.025 * clamp(flam * 3, 0, 1)" },
    { "id": "hitB", "type": "ad", "attack": 0.0004, "decay": 0.0012, "curve": 2, "trig": "c2" },
    { "id": "c3", "type": "clock", "rate": 1, "count": 1, "delay": "0.025 * clamp(flam * 3, 0, 1) + 0.8 / speed" },
    { "id": "hitC", "type": "ad", "attack": 0.0004, "decay": 0.0012, "curve": 2, "trig": "c3" },
    { "id": "malletA", "type": "filter", "mode": "lp", "in": "hitA * flam * 0.6 + hitB", "freq": "1200 + bright * 3000", "q": 0.6 },
    { "id": "barA", "type": "modal", "in": "malletA", "freq": "pitch", "ratios": [1, 3.9, 9.2], "gains": [1, 1.5, 0.5], "decay": "0.9 / speed", "tilt": "1.3 - bright * 0.6" },
    { "id": "malletB", "type": "filter", "mode": "lp", "in": "hitC", "freq": "1200 + bright * 3000", "q": 0.6 },
    { "id": "barB", "type": "modal", "in": "malletB", "freq": "pitch * semi(9)", "ratios": [1, 3.9, 9.2], "gains": [1, 1.5, 0.5], "decay": "1.6 / speed", "tilt": "1.3 - bright * 0.6" },
    { "id": "sum", "type": "expr", "expr": "barA * 0.065 + barB * 0.09" },
    { "id": "tone", "type": "filter", "mode": "lp", "in": "sum", "freq": "2500 + bright * 9000", "q": 0.6 },
    { "id": "clean", "type": "filter", "mode": "hp", "in": "tone", "freq": 80 }
  ],
  "out": "clean",
  "presets": {
    "Select": { "pitch": 660, "speed": 12.5, "bright": 0.5, "flam": 0.3 },
    "Accept": { "pitch": 660, "speed": 10, "bright": 0.55, "flam": 0.5 },
    "Start game": { "pitch": 587, "speed": 7, "bright": 0.7, "flam": 0.9 }
  }
}
