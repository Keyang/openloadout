{
 "format": "sfxpatch/0.1",
 "id": "metal-hit",
 "name": "Metal hit",
 "category": "impact",
 "tags": [
  "clang",
  "bell",
  "sword",
  "pipe",
  "modal"
 ],
 "description": "Ringing metal struck once. Turn up Clang to go from a tuned bell to a clanging pipe.",
 "meta": {
  "type": "sfx",
  "role": "effects/impact",
  "themes": [
   "fantasy",
   "neutral"
  ],
  "gameTypes": [
   "turn-based-rpg",
   "platformer",
   "top-down-rpg"
  ],
  "words": [
   "metal",
   "clang",
   "hit",
   "clash",
   "strike",
   "block",
   "parry",
   "anvil",
   "sword",
   "bell",
   "pipe",
   "armor"
  ],
  "license": "draft"
 },
 "duration": "ring*0.6 + 0.08",
 "params": [
  {
   "id": "pitch",
   "label": "Pitch",
   "min": 150,
   "max": 3000,
   "default": 520,
   "unit": "Hz",
   "scale": "log"
  },
  {
   "id": "ring",
   "label": "Ring",
   "min": 0.1,
   "max": 4,
   "default": 1.2,
   "unit": "s",
   "scale": "log"
  },
  {
   "id": "hard",
   "label": "Hardness",
   "min": 0,
   "max": 1,
   "default": 0.6
  },
  {
   "id": "inharm",
   "label": "Clang",
   "min": 0,
   "max": 1,
   "default": 0.7
  },
  {
   "id": "thud",
   "label": "Body thud",
   "min": 0,
   "max": 1,
   "default": 0.3
  }
 ],
 "nodes": [
  {
   "id": "n",
   "type": "noise"
  },
  {
   "id": "strike",
   "type": "ad",
   "attack": 0.0003,
   "decay": "0.002 + (1 - hard)*0.02",
   "curve": 2
  },
  {
   "id": "exc",
   "type": "filter",
   "mode": "lp",
   "in": "n*strike",
   "freq": "800 + hard*12000"
  },
  {
   "id": "bell",
   "type": "modal",
   "in": "exc",
   "freq": "pitch",
   "ratios": [
    1,
    "mix(2, 2.76, inharm)",
    "mix(3, 5.4, inharm)",
    "mix(4, 8.93, inharm)",
    "mix(5, 11.34, inharm)",
    "mix(6, 14.42, inharm)"
   ],
   "decay": "ring",
   "tilt": 0.8
  },
  {
   "id": "bodyAmp",
   "type": "ad",
   "attack": 0.001,
   "decay": 0.08
  },
  {
   "id": "body",
   "type": "osc",
   "freq": "pitch*0.25"
  },
  {
   "id": "bellHp",
   "type": "filter",
   "mode": "hp",
   "in": "bell",
   "freq": "20 + pitch*1.3*(1 - smooth(200, 350, pitch))",
   "q": 0.7
  }
 ],
 "out": "bellHp*0.2 + body*bodyAmp*thud*2 + exc*0.1",
 "presets": {
  "Sword clash": {
   "pitch": 1900,
   "ring": 0.5,
   "hard": 1,
   "inharm": 1,
   "thud": 0
  },
  "Temple bell": {
   "pitch": 220,
   "ring": 3.0,
   "hard": 0.4,
   "inharm": 0.45,
   "thud": 0.5
  },
  "Tin can": {
   "pitch": 900,
   "ring": 0.15,
   "hard": 0.8,
   "inharm": 0.9,
   "thud": 0.2
  }
 }
}
