{
 "format": "sfxpatch/0.1",
 "id": "hearthvale-cave",
 "name": "Cave theme",
 "category": "music",
 "tags": [
  "music",
  "exploration",
  "cave",
  "marimba",
  "wooden",
  "adaptive",
  "loop"
 ],
 "description": "A damp, hollow, curious loop for caves and tunnels: low broken chords on wooden bars with a woodblock that drips, then a rolled bass bar and a tune that hops down in the gaps, a log drum and a scrape, and at the top a high wooden echo of the tune. Intensity brings the layers in; you can change the speed, pitch, bounce, room and the instrument that plays the tune.",
 "meta": {
  "type": "music",
  "role": "music/exploration",
  "themes": [
   "fantasy",
   "dungeon"
  ],
  "gameTypes": [
   "top-down-rpg",
   "platformer"
  ],
  "words": [
   "cave",
   "cavern",
   "tunnel",
   "underground",
   "mine",
   "drips",
   "echo",
   "hollow",
   "damp",
   "curious",
   "mysterious",
   "marimba",
   "wooden",
   "exploration"
  ],
  "license": "draft"
 },
 "loop": true,
 "wrap": true,
 "normalize": false,
 "gain": 0.85,
 "duration": "round(bars/8)*8*4*60/bpm",
 "params": [
  {
   "id": "intensity",
   "label": "Intensity",
   "min": 0,
   "max": 1,
   "default": 0.85
  },
  {
   "id": "bpm",
   "label": "Speed",
   "min": 80,
   "max": 104,
   "default": 92,
   "unit": "bpm"
  },
  {
   "id": "key",
   "label": "Pitch",
   "min": -5,
   "max": 6,
   "default": 0,
   "unit": "semitones"
  },
  {
   "id": "bars",
   "label": "Length",
   "min": 8,
   "max": 32,
   "default": 16,
   "unit": "bars",
   "step": 8
  },
  {
   "id": "inst",
   "label": "Melody instrument",
   "min": 0,
   "max": 4,
   "default": 4,
   "options": [
    "Synth lead",
    "Flute",
    "Chiptune",
    "Bell",
    "Plucked string"
   ]
  },
  {
   "id": "bright",
   "label": "Brightness",
   "min": 0,
   "max": 1,
   "default": 0.5
