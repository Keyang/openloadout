{
 "format": "sfxpatch/0.1",
 "id": "wyrm-roar",
 "name": "Wyrm roar",
 "category": "impact",
 "tags": [
  "dragon",
  "roar",
  "wyrm",
  "growl",
  "fire breath"
 ],
 "description": "A stylised dragon voice: detuned saws that rise and fall once through a mouth-like sweep, with a 30 Hz growl and a breath of noise. Fire turns it into rushing flame.",
 "meta": {
  "type": "sfx",
  "role": "characters/voice",
  "themes": [
   "fantasy",
   "dungeon"
  ],
  "gameTypes": [
   "turn-based-rpg",
   "platformer",
   "top-down-rpg"
  ],
  "words": [
   "dragon",
   "wyrm",
   "roar",
   "growl",
   "beast",
   "monster",
   "boss",
   "fire breath",
   "flame",
   "rumble",
   "voice",
   "scream"
  ],
  "license": "draft"
 },
 "duration": "length",
 "params": [
  {
   "id": "pitch",
   "label": "Pitch",
   "min": 55,
   "max": 150,
   "default": 90,
   "unit": "Hz",
   "scale": "log"
  },
  {
   "id": "length",
   "label": "Length",
   "min": 1,
   "max": 1.6,
   "default": 1.3,
   "unit": "s",
   "scale": "log"
  },
  {
   "id": "growl",
   "label": "Growl",
   "min": 0,
   "max": 1,
   "default": 0.6
  },
  {
   "id": "breath",
   "label": "Fire",
   "min": 0,
   "max": 1,
   "default": 0.3
  },
  {
   "id": "bright",
   "label": "Brightness",
   "min": 0,
   "max": 1,
   "default": 0.5
  }
 ],
 "nodes": [
  {
   "id": "n",
   "type": "noise"
  },
  {
   "id": "rv",
   "type": "rand",
   "lo": -1,
   "hi": 1
  },
  {
   "id": "f0",
   "type": "env",
   "points": [
    [
     0,
     "pitch*0.82"
    ],
    [
     "length*0.3",
     "pitch*1.22",
     "exp"
    ],
    [
     "length*0.92",
     "pitch*0.7",
     "exp"
    ]
   ]
  },
  {
   "id": "fv",
   "type": "expr",
   "expr": "f0*(1 + rv*0.03)"
  },
  {
   "id": "wob",
   "type": "osc",
   "freq": 30
  },
  {
   "id": "sa",
   "type": "osc",
   "wave": "saw",
   "freq": "fv"
  },
  {
   "id": "sb",
   "type": "osc",
   "wave": "saw",
   "freq": "fv*1.021"
  },
  {
   "id": "throat",
   "type": "expr",
   "expr": "(sa + sb)*0.5"
  },
  {
   "id": "mouth",
   "type": "env",
   "points": [
    [
     0,
     400
    ],
    [
     "length*0.35",
     900
    ],
    [
     "length*0.95",
     300
    ]
   ]
  },
  {
   "id": "mouthB",
   "type": "expr",
   "expr": "mouth*(0.6 + bright*0.9)"
  },
  {
   "id": "rasp",
   "type": "shaper",
   "in": "throat",
   "drive": "2 + growl*2",
   "mode": "tanh"
  },
  {
   "id": "fm1",
   "type": "filter",
   "mode": "bp",
   "in": "rasp",
   "freq": "mouthB",
   "q": 3
  },
  {
   "id": "fm2",
   "type": "filter",
   "mode": "bp",
   "in": "rasp",
   "freq": "mouthB*2.6",
   "q": 4
  },
  {
   "id": "voice",
   "type": "expr",
   "expr": "fm1*1.0 + fm2*0.7 + rasp*0.12"
  },
  {
   "id": "vEnv",
   "type": "env",
   "points": [
    [
     0,
     0
    ],
    [
     0.05,
     0.9
    ],
    [
     "length*0.28",
     1
    ],
    [
     "length*0.7",
     0.8
    ],
    [
     "length*0.97",
     0,
     1.6
    ]
   ]
  },
  {
   "id": "gAmp",
   "type": "expr",
   "expr": "1 - growl*0.85*(0.5 + 0.5*wob)"
  },
  {
   "id": "vox",
   "type": "expr",
   "expr": "voice*vEnv*gAmp*(1 - 0.85*breath)"
  },
  {
   "id": "bEnv",
   "type": "env",
   "points": [
    [
     0,
     0.15
    ],
    [
     "length*0.25",
     1
    ],
    [
     "length*0.75",
     0.9
    ],
    [
     "length*0.97",
     0,
     1.6
    ]
   ]
  },
  {
   "id": "bHp",
   "type": "filter",
   "mode": "hp",
   "in": "n",
   "freq": 350
  },
  {
   "id": "bBp",
   "type": "filter",
   "mode": "bp",
   "in": "bHp",
   "freq": "mouthB*1.8",
   "q": 0.9
  },
  {
   "id": "air",
   "type": "expr",
   "expr": "bBp*bEnv*(0.12 + breath*0.95)*(0.8 + 0.2*wob)"
  },
  {
   "id": "sum",
   "type": "expr",
   "expr": "vox*1.6 + air*0.9"
  },
  {
   "id": "lp",
   "type": "filter",
   "mode": "lp",
   "in": "sum",
   "freq": "1200 + bright*7000"
  },
  {
   "id": "hpf",
   "type": "filter",
   "mode": "hp",
   "in": "lp",
   "freq": 40
  },
  {
   "id": "verb",
   "type": "reverb",
   "in": "hpf",
   "size": 0.6,
   "damp": 0.5,
   "mix": 0.16
  },
  {
   "id": "fin",
   "type": "env",
   "points": [
    [
     0,
     1
    ],
    [
     "length*0.9",
     1
    ],
    [
     "length*0.999",
     0,
     1.5
    ]
   ]
  }
 ],
 "out": "verb*fin",
 "presets": {
  "Wyrm roar": {
   "pitch": 90,
   "length": 1.3,
   "growl": 0.6,
   "breath": 0.3,
   "bright": 0.5
  },
  "Fire breath": {
   "pitch": 100,
   "length": 1.4,
   "growl": 0.2,
   "breath": 1,
   "bright": 0.7
  },
  "Distant growl": {
   "pitch": 62,
   "length": 1.6,
   "growl": 1,
   "breath": 0.1,
   "bright": 0.1
  }
 }
}
