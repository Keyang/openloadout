{
 "format": "sfxpatch/0.1",
 "id": "night-insects",
 "name": "Night insects",
 "category": "ambience",
 "description": "A warm night full of crickets chirping at their own pitches and rates over a soft bed of far-off insects. Change their pitch, how fast they chirp, the brightness and how many crickets sing.",
 "meta": {
  "type": "ambience",
  "role": "environment/ambience",
  "themes": ["neutral", "forest", "farm"],
  "gameTypes": ["top-down-rpg", "farming-sim", "turn-based-rpg", "platformer"],
  "words": ["night", "crickets", "insects", "bugs", "chirp", "evening", "summer", "nighttime", "countryside", "marsh", "camp", "calm"],
  "license": "draft"
 },
 "loop": true,
 "duration": 6,
 "params": [
  { "id": "pitch", "label": "Pitch", "unit": "Hz", "min": 2500, "max": 6000, "default": 4200, "scale": "log" },
  { "id": "speed", "label": "Speed", "min": 0, "max": 1, "default": 0.5, "hint": "Slow, cool-night chirps on the left; fast, warm-night chirps on the right." },
  { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.5 },
  { "id": "crickets", "label": "Crickets", "min": 3, "max": 5, "default": 4, "step": 1 }
 ],
 "nodes": [
  { "id": "base", "type": "expr", "expr": "0.6 + speed * 2.4" },
  { "id": "prate", "type": "expr", "expr": "26 + speed * 34" },

  { "id": "r1", "type": "expr", "expr": "max(1, round(dur * base * 1.00)) / dur" },
  { "id": "r2", "type": "expr", "expr": "max(1, round(dur * base * 1.37) + 2) / dur" },
  { "id": "r3", "type": "expr", "expr": "max(1, round(dur * base * 0.71) - 1) / dur" },
  { "id": "r4", "type": "expr", "expr": "max(1, round(dur * base * 1.19) + 1) / dur" },
  { "id": "r5", "type": "expr", "expr": "max(1, round(dur * base * 0.53) - 2) / dur" },

  { "id": "u1", "type": "expr", "expr": "((t * r1 + 0.00) % 1) / r1" },
  { "id": "u2", "type": "expr", "expr": "((t * r2 + 0.31) % 1) / r2" },
  { "id": "u3", "type": "expr", "expr": "((t * r3 + 0.57) % 1) / r3" },
  { "id": "u4", "type": "expr", "expr": "((t * r4 + 0.13) % 1) / r4" },
  { "id": "u5", "type": "expr", "expr": "((t * r5 + 0.79) % 1) / r5" },

  { "id": "g1", "type": "expr", "expr": "(u1 < 3 / prate) * pow(sin(pi * u1 * prate), 2) * (0.8 + 0.2 * sin(tau * t * 2 / dur))" },
  { "id": "g2", "type": "expr", "expr": "(u2 < 4 / (prate * 0.9)) * pow(sin(pi * u2 * prate * 0.9), 2) * (0.75 + 0.25 * sin(tau * t * 3 / dur + 1))" },
  { "id": "g3", "type": "expr", "expr": "(u3 < 2 / (prate * 1.15)) * pow(sin(pi * u3 * prate * 1.15), 2) * (0.8 + 0.2 * sin(tau * t * 1 / dur + 2))" },
  { "id": "g4", "type": "expr", "expr": "step(3.5, crickets) * (u4 < 5 / (prate * 0.8)) * pow(sin(pi * u4 * prate * 0.8), 2) * (0.7 + 0.3 * sin(tau * t * 2 / dur + 4))" },
  { "id": "g5", "type": "expr", "expr": "step(4.5, crickets) * (u5 < 3 / (prate * 1.05)) * pow(sin(pi * u5 * prate * 1.05), 2) * (0.8 + 0.2 * sin(tau * t * 1 / dur + 5))" },

  { "id": "c1", "type": "osc", "wave": "sine", "freq": "pitch * 1.00" },
  { "id": "c2", "type": "osc", "wave": "sine", "freq": "pitch * 0.87" },
  { "id": "c3", "type": "osc", "wave": "sine", "freq": "pitch * 1.14" },
  { "id": "c4", "type": "osc", "wave": "sine", "freq": "pitch * 0.79" },
  { "id": "c5", "type": "osc", "wave": "sine", "freq": "pitch * 1.23" },
  { "id": "h1", "type": "osc", "wave": "tri", "freq": "pitch * 1.00" },

  { "id": "v1", "type": "expr", "expr": "(c1 + h1 * bright * 0.5) * g1" },
  { "id": "v2", "type": "expr", "expr": "c2 * g2 * 0.8" },
  { "id": "v3", "type": "expr", "expr": "c3 * g3 * 0.7" },
  { "id": "v4", "type": "expr", "expr": "c4 * g4 * 0.6" },
  { "id": "v5", "type": "expr", "expr": "c5 * g5 * 0.55" },

  { "id": "chorL", "type": "expr", "expr": "v1 * 0.55 + v2 * 0.85 + v3 * 0.25 + v4 * 0.6 + v5 * 0.35" },
  { "id": "chorR", "type": "expr", "expr": "v1 * 0.45 + v2 * 0.15 + v3 * 0.75 + v4 * 0.4 + v5 * 0.65" },
  { "id": "sheenL", "type": "filter", "mode": "lp", "in": "chorL", "freq": "pitch * (1.1 + bright * 3)", "q": 0.7 },
  { "id": "sheenR", "type": "filter", "mode": "lp", "in": "chorR", "freq": "pitch * (1.1 + bright * 3)", "q": 0.7 },

  { "id": "pn", "type": "noise", "color": "pink" },
  { "id": "far", "type": "filter", "mode": "bp", "in": "pn", "freq": "pitch * 0.92", "q": 4 },
  { "id": "trill", "type": "expr", "expr": "0.55 + 0.45 * sin(tau * t * prate * 1.4)" },
  { "id": "swell", "type": "expr", "expr": "0.7 + 0.3 * sin(tau * t * 1 / dur)" },
  { "id": "bed", "type": "expr", "expr": "far * trill * swell * (0.5 + bright * 0.4)" },
  { "id": "bn", "type": "noise", "color": "brown" },
  { "id": "air", "type": "filter", "mode": "lp", "in": "bn", "freq": 280 }
 ],
 "out": ["sheenL + bed * 0.4 + air * 0.12", "sheenR + bed * 0.4 + air * 0.12"],
 "presets": {
  "Summer night": { "pitch": 4600, "speed": 0.7, "bright": 0.6, "crickets": 5 },
  "Marsh": { "pitch": 3200, "speed": 0.45, "bright": 0.35, "crickets": 4 },
  "Cool evening": { "pitch": 3900, "speed": 0.1, "bright": 0.45, "crickets": 3 }
 }
}
