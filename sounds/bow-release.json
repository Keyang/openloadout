{
  "format": "sfxpatch/0.1",
  "id": "bow-release",
  "name": "Bow release",
  "category": "weapon",
  "description": "A bowstring let go: a taut twang, a soft thump of the bow and a quick hiss of the arrow leaving. Change its pitch, length, brightness and how tight the string is.",
  "meta": {
    "type": "sfx",
    "role": "actions/shoot",
    "themes": [
      "neutral",
      "fantasy",
      "forest"
    ],
    "gameTypes": [
      "top-down-rpg",
      "turn-based-rpg",
      "platformer",
      "roguelike-action"
    ],
    "words": [
      "bow",
      "arrow",
      "crossbow",
      "shoot",
      "fire",
      "release",
      "twang",
      "string",
      "archer",
      "ranged",
      "loose",
      "bolt"
    ],
    "license": "draft"
  },
  "duration": "length + 0.02",
  "params": [
    {
      "id": "pitch",
      "label": "Pitch",
      "unit": "Hz",
      "min": 90,
      "max": 320,
      "default": 160,
      "scale": "log"
    },
    {
      "id": "length",
      "label": "Length",
      "unit": "s",
      "min": 0.2,
      "max": 0.6,
      "default": 0.35,
      "scale": "log"
    },
    {
      "id": "bright",
      "label": "Brightness",
      "min": 0,
      "max": 1,
      "default": 0.5
    },
    {
      "id": "tension",
      "label": "Tension",
      "min": 0,
      "max": 1,
      "default": 0.5
    }
  ],
  "nodes": [
    {
      "id": "n",
      "type": "noise"
    },
    {
      "id": "np",
      "type": "noise",
      "color": "pink"
    },
    {
      "id": "bend",
      "type": "env",
      "points": [
        [
          0,
          "pitch * (1.15 + tension * 0.35) * rnd(0.98, 1.02)"
        ],
        [
          "0.03 + (1 - tension) * 0.03",
          "pitch",
          "exp"
        ]
      ]
    },
    {
      "id": "pluckIn",
      "type": "ad",
      "attack": 0.0003,
      "decay": 0.004,
      "curve": 2
    },
    {
      "id": "string",
      "type": "pluck",
      "freq": "bend",
      "decay": "length * (1.6 + tension * 0.8)",
      "damp": "0.55 - bright * 0.35 - tension * 0.15",
      "in": "n * pluckIn * 0.6"
    },
    {
      "id": "twangAmp",
      "type": "env",
      "points": [
        [
          0,
          1
        ],
        [
          "length * 0.6",
          0.55,
          1
        ],
        [
          "length",
          0,
          1.3
        ]
      ]
    },
    {
      "id": "buzz",
      "type": "filter",
      "mode": "bp",
      "in": "string",
      "freq": "pitch * 6 * (0.7 + bright * 0.8)",
      "q": 2
    },
    {
      "id": "thumpEnv",
      "type": "ad",
      "attack": 0.001,
      "decay": "0.05 + (1 - tension) * 0.04",
      "curve": 2.5
    },
    {
      "id": "thumpF",
      "type": "env",
      "points": [
        [
          0,
          190
        ],
        [
          0.05,
          85,
          "exp"
        ]
      ]
    },
    {
      "id": "thump",
      "type": "osc",
      "wave": "sine",
      "freq": "thumpF"
    },
    {
      "id": "knock",
      "type": "filter",
      "mode": "bp",
      "in": "np",
      "freq": "520 + tension * 300",
      "q": 1.2
    },
    {
      "id": "clickEnv",
      "type": "ad",
      "attack": 0.0002,
      "decay": "0.003 + tension * 0.004",
      "curve": 3
    },
    {
      "id": "click",
      "type": "filter",
      "mode": "hp",
      "in": "n",
      "freq": "1800 + bright * 2000"
    },
    {
      "id": "go",
      "type": "clock",
      "rate": 1,
      "count": 1,
      "delay": "0.012 * rnd(0.8, 1.2)"
    },
    {
      "id": "hissEnv",
      "type": "env",
      "trig": "go",
      "points": [
        [
          0,
          0
        ],
        [
          0.012,
          1
        ],
        [
          "0.06 + length * 0.15",
          0,
          1.6
        ]
      ]
    },
    {
      "id": "hissF",
      "type": "env",
      "trig": "go",
      "points": [
        [
          0,
          "5500 + bright * 3000"
        ],
        [
          "0.06 + length * 0.15",
          "2200 + bright * 1500",
          "exp"
        ]
      ]
    },
    {
      "id": "hiss",
      "type": "filter",
      "mode": "bp",
      "in": "n",
      "freq": "hissF",
      "q": 1.5
    },
    {
      "id": "sum",
      "type": "expr",
      "expr": "string * twangAmp * (0.9 + tension * 0.5) + buzz * twangAmp * bright * 0.8 + thump * thumpEnv * 0.35 + knock * thumpEnv * 0.6 + click * clickEnv * (0.15 + tension * 0.45) + hiss * hissEnv * (0.25 + bright * 0.3)"
    },
    {
      "id": "clean",
      "type": "filter",
      "mode": "hp",
      "in": "sum",
      "freq": 50
    }
  ],
  "out": "clean",
  "presets": {
    "Short bow": {
      "pitch": 210,
      "length": 0.28,
      "bright": 0.55,
      "tension": 0.4
    },
    "Long bow": {
      "pitch": 125,
      "length": 0.48,
      "bright": 0.45,
      "tension": 0.65
    },
    "Crossbow": {
      "pitch": 260,
      "length": 0.25,
      "bright": 0.7,
      "tension": 1
    }
  }
}