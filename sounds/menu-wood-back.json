{
  "format": "sfxpatch/0.1",
  "id": "menu-wood-back",
  "name": "Wood back",
  "category": "ui",
  "description": "Leaving a page: two notes on a little tuned wooden bar stepping down, the second shorter and softer with a small paper flick, the same every time. Change its pitch, speed, brightness and how much paper you hear.",
  "meta": {
    "type": "sfx",
    "role": "interface/click",
    "themes": ["neutral", "fantasy"],
    "gameTypes": ["arcade", "puzzle", "card-game", "turn-based-rpg", "top-down-rpg"],
    "words": ["menu", "back", "cancel", "return", "close", "exit", "previous", "wooden", "marimba", "paper", "button", "no"],
    "license": "draft"
  },
  "duration": "1.5 / speed",
  "params": [
    { "id": "pitch", "label": "Pitch", "unit": "Hz", "min": 440, "max": 1000, "default": 660, "scale": "log" },
    { "id": "speed", "label": "Speed", "unit": "notes/s", "min": 6, "max": 15, "default": 9.5, "scale": "log" },
    { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.5 },
    { "id": "paper", "label": "Paper", "min": 0, "max": 1, "default": 0.4 }
  ],
  "nodes": [
    { "id": "hitA", "type": "ad", "attack": 0.0004, "decay": 0.0012, "curve": 2 },
    { "id": "malletA", "type": "filter", "mode": "lp", "in": "hitA", "freq": "1200 + bright * 3000", "q": 0.6 },
    { "id": "barA", "type": "modal", "in": "malletA", "freq": "pitch", "ratios": [1, 3.9, 9.2], "gains": [1, 1.5, 0.5], "decay": "1.0 / speed", "tilt": "1.3 - bright * 0.6" },
    { "id": "c2", "type": "clock", "rate": 1, "count": 1, "delay": "0.6 / speed" },
    { "id": "hitB", "type": "ad", "attack": 0.0004, "decay": 0.0012, "curve": 2, "trig": "c2" },
    { "id": "malletB", "type": "filter", "mode": "lp", "in": "hitB", "freq": "800 + bright * 1800", "q": 0.6 },
    { "id": "barB", "type": "modal", "in": "malletB", "freq": "pitch * semi(-5)", "ratios": [1, 3.9, 9.2], "gains": [1, 1.5, 0.5], "decay": "0.75 / speed", "tilt": "1.4 - bright * 0.6" },
    { "id": "rustle", "type": "noise", "color": "pink", "seed": 3 },
    { "id": "flick", "type": "ad", "attack": 0.002, "decay": "0.35 / speed", "curve": 2.5, "trig": "c2" },
    { "id": "sheet", "type": "filter", "mode": "bp", "in": "rustle * flick", "freq": "2800 + bright * 1800", "q": 0.9 },
    { "id": "sum", "type": "expr", "expr": "barA * 0.065 + barB * 0.028 + sheet * paper * (1.2 - bright * 0.6)" },
    { "id": "tone", "type": "filter", "mode": "lp", "in": "sum", "freq": "2500 + bright * 9000", "q": 0.6 },
    { "id": "clean", "type": "filter", "mode": "hp", "in": "tone", "freq": 80 }
  ],
  "out": "clean",
  "presets": {
    "Back": { "pitch": 660, "speed": 10, "bright": 0.5, "paper": 0.35 },
    "Cancel": { "pitch": 622, "speed": 7.5, "bright": 0.4, "paper": 0.6 }
  }
}
