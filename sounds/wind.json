{
 "format": "sfxpatch/0.1",
 "id": "wind",
 "name": "Wind",
 "category": "ambience",
 "tags": [
  "weather",
  "outdoor",
  "loop"
 ],
 "description": "Gusting filtered noise with an optional whistle.",
 "meta": {
  "type": "ambience",
  "role": "environment/weather",
  "themes": [
   "neutral",
   "forest"
  ],
  "gameTypes": [
   "platformer",
   "turn-based-rpg",
   "top-down-rpg",
   "farming-sim"
  ],
  "words": [
   "wind",
   "breeze",
   "gust",
   "storm",
   "blizzard",
   "weather",
   "howl",
   "whistle",
   "outdoor",
   "mountain",
   "desert",
   "air"
  ],
  "license": "draft"
 },
 "loop": true,
 "duration": 8,
 "params": [
  {
   "id": "strength",
   "label": "Strength",
   "min": 0,
   "max": 1,
   "default": 0.5
  },
  {
   "id": "gust",
   "label": "Gustiness",
   "min": 0,
   "max": 1,
   "default": 0.5
  },
  {
   "id": "pitch",
   "label": "Pitch",
   "min": 150,
   "max": 1500,
   "default": 500,
   "unit": "Hz",
   "scale": "log"
  },
  {
   "id": "whistle",
   "label": "Whistle",
   "min": 0,
   "max": 1,
   "default": 0.25
  }
 ],
 "nodes": [
  {
   "id": "n",
   "type": "noise",
   "color": "pink"
  },
  {
   "id": "gclk",
   "type": "clock",
   "rate": 0.8,
   "jitter": 0.6
  },
  {
   "id": "gr",
   "type": "rand",
   "trig": "gclk"
  },
  {
   "id": "g",
   "type": "lag",
   "in": "gr",
   "time": 0.9
  },
  {
   "id": "level",
   "type": "expr",
   "expr": "(1 - gust) + gust*g*1.6"
  },
  {
   "id": "body",
   "type": "filter",
   "mode": "bp",
   "in": "n",
   "freq": "pitch*(0.6 + level*0.9)",
   "q": 0.9
  },
  {
   "id": "low",
   "type": "filter",
   "mode": "lp",
   "in": "n",
   "freq": "200 + 300*strength"
  },
  {
   "id": "wh",
   "type": "filter",
   "mode": "bp",
   "in": "n",
   "freq": "pitch*3*(0.8 + g*0.5)",
   "q": "8 + whistle*20"
  }
 ],
 "out": "(body*1.2 + low*0.8*strength + wh*whistle*0.7) * (0.25 + strength*0.75) * level",
 "presets": {
  "Breeze": {
   "strength": 0.2,
   "gust": 0.2,
   "pitch": 800,
   "whistle": 0
  },
  "Storm": {
   "strength": 1,
   "gust": 0.9,
   "pitch": 300,
   "whistle": 0.6
  }
 }
}