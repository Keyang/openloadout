   "id": "eO",
   "type": "expr",
   "expr": "exO"
  },
  {
   "id": "duck",
   "type": "expr",
   "expr": "1 - kA*gDrums*0.2"
  },
  {
   "id": "ctr",
   "type": "expr",
   "expr": "kO*0.45*gDrums*gLift + sO*0.4*gDrums*gLift + (bO*0.16 + bU*0.07)*gBass"
  },
  {
   "id": "muL",
   "type": "expr",
   "expr": "(pH*0.5*gKeys*(1 - 0.3*gTune*lead) + lcO*0.5*lead*gTune*gLift + eO*0.17*0.8*lead*gAnswer + hO*0.3*gDrums*gLift*0.9 + xO*0.12*gBed*1.2)*duck"
  },
  {
   "id": "muR",
   "type": "expr",
   "expr": "(pH*0.5*gKeys*(1 - 0.3*gTune*lead) + lcO*0.5*lead*gTune*gLift + eO*0.17*1.2*lead*gAnswer + hO*0.3*gDrums*gLift*1.1 + xO*0.12*gBed*0.8)*duck"
  },
  {
   "id": "rv",
   "type": "reverb",
   "in": "(muL + muR)*0.5",
   "size": 0.5,
   "damp": 0.7,
   "mix": 1
  },
  {
   "id": "mL",
   "type": "shaper",
   "in": "(ctr + muL + rv*space*2)*0.85",
   "drive": 1
  },
  {
   "id": "mR",
   "type": "shaper",
   "in": "(ctr + muR + rv*space*2)*0.85",
   "drive": 1
  },
  {
   "id": "tpXL",
   "type": "crush",
   "in": "mL",
   "bits": 11,
   "rate": 18000
  },
  {
   "id": "tpL",
   "type": "filter",
   "mode": "lp",
   "in": "tpXL",
   "freq": "3500 + bright*3500",
   "q": 0.7
  },
  {
   "id": "tpXR",
   "type": "crush",
   "in": "mR",
   "bits": 11,
   "rate": 18000
  },
  {
   "id": "tpR",
   "type": "filter",
   "mode": "lp",
   "in": "tpXR",
   "freq": "3500 + bright*3500",
   "q": 0.7
  }
 ],
