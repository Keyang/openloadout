{
  "format": "sfxpatch/0.1",
  "id": "menu-wood-toggle",
  "name": "Wood toggle",
  "category": "ui",
  "description": "Flipping a switch or ticking a box: a small wooden latch clicks, then two quick notes on a little tuned wooden bar step up when it turns on and down when it turns off, the same every time. Change its pitch, length, brightness and which way it switches.",
  "meta": {
    "type": "sfx",
    "role": "interface/click",
    "themes": ["neutral", "fantasy"],
    "gameTypes": ["arcade", "puzzle", "card-game", "turn-based-rpg", "top-down-rpg"],
    "words": ["menu", "toggle", "switch", "checkbox", "tick", "on", "off", "option", "setting", "latch", "wooden", "marimba", "button"],
    "license": "draft"
  },
  "duration": "length + 0.006",
  "params": [
    { "id": "pitch", "label": "Pitch", "unit": "Hz", "min": 440, "max": 1000, "default": 660, "scale": "log" },
    { "id": "length", "label": "Length", "unit": "s", "min": 0.08, "max": 0.2, "default": 0.12, "scale": "log" },
    { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.5 },
    { "id": "dir", "label": "Switch", "min": 0, "max": 1, "default": 1, "options": ["Off", "On"] }
  ],
  "nodes": [
    { "id": "latchHit", "type": "ad", "attack": 0.0003, "decay": 0.0008, "curve": 2 },
    { "id": "latch", "type": "modal", "in": "latchHit", "freq": "pitch * 2.2", "ratios": [1, 2.4, 4.1], "gains": [1, 0.6, 0.25], "decay": "0.008 + length * 0.04", "tilt": "1.2 - bright * 0.5" },
    { "id": "c1", "type": "clock", "rate": 1, "count": 1, "delay": "length * 0.14" },
    { "id": "hitA", "type": "ad", "attack": 0.0004, "decay": 0.0012, "curve": 2, "trig": "c1" },
    { "id": "malletA", "type": "filter", "mode": "lp", "in": "hitA", "freq": "1200 + bright * 3000", "q": 0.6 },
    { "id": "barA", "type": "modal", "in": "malletA", "freq": "pitch", "ratios": [1, 3.9, 9.2], "gains": [1, 1.5, 0.5], "decay": "length * 0.55", "tilt": "1.3 - bright * 0.6" },
    { "id": "c2", "type": "clock", "rate": 1, "count": 1, "delay": "length * 0.42" },
    { "id": "hitB", "type": "ad", "attack": 0.0004, "decay": 0.0012, "curve": 2, "trig": "c2" },
    { "id": "malletB", "type": "filter", "mode": "lp", "in": "hitB", "freq": "1200 + bright * 3000", "q": 0.6 },
    { "id": "barB", "type": "modal", "in": "malletB", "freq": "pitch * (dir > 0.5 ? semi(7) : semi(-5))", "ratios": [1, 3.9, 9.2], "gains": [1, 1.5, 0.5], "decay": "length * 0.75", "tilt": "1.3 - bright * 0.6" },
    { "id": "sum", "type": "expr", "expr": "latch * 0.1 + barA * 0.055 + barB * 0.07" },
    { "id": "tone", "type": "filter", "mode": "lp", "in": "sum", "freq": "2500 + bright * 9000", "q": 0.6 },
    { "id": "clean", "type": "filter", "mode": "hp", "in": "tone", "freq": 80 }
  ],
  "out": "clean",
  "presets": {
    "Switch on": { "pitch": 660, "length": 0.12, "bright": 0.55, "dir": 1 },
    "Switch off": { "pitch": 660, "length": 0.12, "bright": 0.45, "dir": 0 }
  }
}
