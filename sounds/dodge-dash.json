     "exp"
    ]
   ]
  },
  {
   "id": "band",
   "type": "filter",
   "mode": "bp",
   "in": "n",
   "freq": "bf",
   "q": "1.2+(1-air)*2"
  },
  {
   "id": "aAmp",
   "type": "env",
