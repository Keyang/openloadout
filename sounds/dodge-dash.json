     2
    ]
   ]
  },
  {
   "id": "cf",
   "type": "env",
   "points": [
    [
     0,
     "pitch"
    ],
    [
     "length*0.45",
     "pitch*4",
     "exp"
    ],
    [
     "length",
     "pitch",
     "exp"
    ]
   ]
  },
  {
   "id": "ch",
   "type": "osc",
   "freq": "cf"
  },
  {
   "id": "cAmp",
   "type": "env",
   "points": [
