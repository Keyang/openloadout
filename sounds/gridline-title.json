  },
  {
   "id": "sV",
   "type": "sah",
   "in": "sT",
   "trig": "sT"
  },
  {
   "id": "sA",
   "type": "ad",
   "trig": "sT",
   "attack": 0.0005,
   "hold": 0.005,
   "decay": 0.09,
   "curve": 1.5
  },
  {
   "id": "sO",
