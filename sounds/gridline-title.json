   "id": "eG",
   "type": "pattern",
   "trig": "c16",
   "steps": "................|................|................|..........XXX.x.|................|................|................|..........XXX.xx"
  },
  {
   "id": "eS",
   "type": "seq",
   "trig": "c16",
   "loop": true,
   "steps": "16 16 16 16 16 16 16 16 16 16 16 16 16 16 16 16 | 16 16 16 16 16 16 16 16 16 16 16 16 16 16 16 16 | 16 16 16 16 16 16 16 16 16 16 16 16 16 16 16 16 | 16 16 16 16 16 16 16 16 16 16 17 21 26 26 21 21 | 21 21 21 21 21 21 21 21 21 21 21 21 21 21 21 21 | 21 21 21 21 21 21 21 21 21 21 21 21 21 21 21 21 | 21 21 21 21 21 21 21 21 21 21 21 21 21 21 21 21 | 21 21 21 21 21 21 21 21 21 21 16 19 24 24 19 16"
