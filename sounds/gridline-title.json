  },
  {
   "id": "hH",
   "type": "filter",
   "mode": "hp",
   "in": "hC",
   "freq": 3000,
   "q": 0.7
  },
  {
   "id": "hV",
   "type": "sah",
   "in": "hT",
   "trig": "hT"
  },
  {
   "id": "hA",
   "type": "ad",
   "trig": "hT",
   "attack": 0.0005,
   "decay": 0.035,
   "curve": 2
  },
  {
   "id": "hO",
   "type": "expr",
   "expr": "hH*hA*hV*0.8"
  },
  {
   "id": "bG",
   "type": "pattern",
   "trig": "c16",
   "steps": "X...x...x...x..."
  },
  {
   "id": "bS",
   "type": "seq",
