{
  "format": "sfxpatch/0.1",
  "id": "crowd-murmur",
  "name": "Crowd",
  "category": "ambience",
  "description": "A murmur of people heard from far off, with no words to make out: hushed in a hall, a steady babble, or a cheering roar with clapping. Change how big the crowd is, its mood, how bright it is and how much it rises and falls.",
  "meta": {
    "type": "ambience",
    "role": "environment/ambience",
    "themes": [
      "city",
      "fantasy",
      "neutral"
    ],
    "gameTypes": [
      "top-down-rpg",
      "turn-based-rpg",
      "racing",
      "arcade",
      "card-game"
    ],
    "words": [
      "crowd",
      "people",
      "murmur",
      "babble",
      "audience",
      "cheer",
      "cheering",
      "clapping",
      "applause",
      "market",
      "arena",
      "stadium",
      "hall",
      "background"
    ],
    "license": "draft"
  },
  "loop": true,
  "duration": 8,
  "params": [
    {
      "id": "size",
      "label": "Crowd size",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "hint": "From a dozen people to a stadium"
    },
    {
      "id": "mood",
      "label": "Mood",
      "min": 0,
      "max": 2,
      "default": 1,
      "options": [
        "Hushed",
        "Chatting",
        "Cheering"
      ]
    },
    {
      "id": "bright",
      "label": "Brightness",
      "min": 0,
      "max": 1,
      "default": 0.5
    },
    {
      "id": "swell",
      "label": "Swells",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "hint": "How much it rises and falls"
    }
  ],
  "nodes": [
    { "id": "hush", "type": "expr", "expr": "mood < 0.5 ? 1 : 0" },
    { "id": "cheer", "type": "expr", "expr": "mood > 1.5 ? 1 : 0" },
    { "id": "gClk", "type": "clock", "rate": "rnd(0.45, 0.6)", "jitter": 0.5 },
    { "id": "gRnd", "type": "rand", "lo": 0, "hi": 1, "trig": "gClk" },
    { "id": "gLag", "type": "lag", "in": "gRnd", "time": 0.55 },
    { "id": "wave", "type": "expr", "expr": "clamp(0.5 + (gLag - 0.5) * (2.2 - 0.9 * cheer) + cheer * 0.34 * sin(tau * 0.375 * t + rnd(0, 6.28)), 0, 1)" },
    { "id": "swl", "type": "expr", "expr": "1 - swell * (0.8 + 0.12 * cheer) * (1 - wave)" },
    { "id": "pShift", "type": "expr", "expr": "1.15 - 0.3 * size" },
    { "id": "bShift", "type": "expr", "expr": "(0.78 + 0.5 * bright) * (1.08 - 0.16 * size) * (1 - 0.18 * hush)" },
    { "id": "qq", "type": "expr", "expr": "(3.6 - 1.8 * size) * (1 - 0.55 * cheer)" },
    { "id": "fDepth", "type": "expr", "expr": "(0.92 - 0.4 * size) * (1 - 0.45 * cheer)" },
    { "id": "buzzAmt", "type": "expr", "expr": "(0.5 - 0.22 * size) * (1 + 0.1 * hush - 0.3 * cheer)" },
    { "id": "v1pc", "type": "clock", "rate": "rnd(0.6, 1.3)", "jitter": 0.6, "delay": "rnd(0, 0.5)" },
    { "id": "v1pr", "type": "rand", "lo": -1, "hi": 1, "trig": "v1pc" },
    { "id": "v1pl", "type": "lag", "in": "v1pr", "time": 0.35 },
    { "id": "v1bz", "type": "osc", "wave": "saw", "freq": "128 * rnd(0.96, 1.04) * pShift * (1 + v1pl * 0.12)", "phase": 0 },
    { "id": "v1ns", "type": "noise", "color": "pink" },
    { "id": "v1fc", "type": "clock", "rate": "rnd(3, 6)", "jitter": 0.75, "delay": "rnd(0, 0.2)" },
    { "id": "v1fr", "type": "rand", "lo": 0, "hi": 1, "trig": "v1fc" },
    { "id": "v1fl", "type": "lag", "in": "v1fr", "time": 0.045 },
    { "id": "v1ar", "type": "rand", "lo": 0, "hi": 1, "trig": "v1fc" },
    { "id": "v1al", "type": "lag", "in": "v1ar", "time": 0.11 },
    { "id": "v1br", "type": "rand", "lo": 0, "hi": 1, "trig": "v1fc" },
    { "id": "v1bl", "type": "lag", "in": "v1br", "time": 0.13 },
    { "id": "v1sc", "type": "clock", "rate": "rnd(0.45, 0.9)", "jitter": 0.7, "delay": "rnd(0, 0.8)" },
    { "id": "v1sd", "type": "rand", "lo": 0, "hi": 1, "trig": "v1sc" },
    { "id": "v1sl", "type": "lag", "in": "v1sd", "time": 0.4 },
    { "id": "v1src", "type": "expr", "expr": "v1bz * buzzAmt + v1ns" },
    { "id": "v1f1", "type": "filter", "mode": "bp", "in": "v1src", "freq": "(400 + v1al * 500 + cheer * 250) * bShift", "q": "qq" },
    { "id": "v1f2", "type": "filter", "mode": "bp", "in": "v1src", "freq": "(1000 + v1bl * 1400 - cheer * v1bl * 500) * bShift", "q": "qq" },
    { "id": "v1lv", "type": "expr", "expr": "(hush > 0.5 ? clamp((v1sl - 0.5) * 6, 0, 1) : (0.35 + 0.3 * cheer) + (0.65 - 0.3 * cheer) * v1sl) * (1 - fDepth + fDepth * v1fl * v1fl * 1.6)" },
    { "id": "v1", "type": "expr", "expr": "(v1f1 + v1f2 * (0.5 + 0.3 * bright + 0.2 * cheer - 0.2 * hush)) * v1lv" },
    { "id": "v2pc", "type": "clock", "rate": "rnd(0.6, 1.3)", "jitter": 0.6, "delay": "rnd(0, 0.5)" },
