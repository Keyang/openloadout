    { "id": "v8sl", "type": "lag", "in": "v8sd", "time": 0.4 },
    { "id": "v8src", "type": "expr", "expr": "v8bz * buzzAmt + v8ns" },
    { "id": "v8f1", "type": "filter", "mode": "bp", "in": "v8src", "freq": "(400 + v8al * 500 + cheer * 250) * bShift", "q": "qq" },
    { "id": "v8f2", "type": "filter", "mode": "bp", "in": "v8src", "freq": "(1000 + v8bl * 1400 - cheer * v8bl * 500) * bShift", "q": "qq" },
    { "id": "v8lv", "type": "expr", "expr": "(hush > 0.5 ? clamp((v8sl - 0.5) * 6, 0, 1) : (0.35 + 0.3 * cheer) + (0.65 - 0.3 * cheer) * v8sl) * (1 - fDepth + fDepth * v8fl * v8fl * 1.6)" },
    { "id": "v8", "type": "expr", "expr": "(v8f1 + v8f2 * (0.5 + 0.3 * bright + 0.2 * cheer - 0.2 * hush)) * v8lv" },
    { "id": "washNL", "type": "noise", "color": "pink" },
    { "id": "washNR", "type": "noise", "color": "pink" },
    { "id": "washLo", "type": "filter", "mode": "bp", "in": "washNL", "freq": "(520 + cheer * 260) * bShift", "q": 0.8 },
    { "id": "washHi", "type": "filter", "mode": "bp", "in": "washNL", "freq": "(1500 + cheer * 300) * bShift", "q": 0.8 },
    { "id": "washLo2", "type": "filter", "mode": "bp", "in": "washNR", "freq": "(560 + cheer * 260) * bShift", "q": 0.8 },
    { "id": "washHi2", "type": "filter", "mode": "bp", "in": "washNR", "freq": "(1400 + cheer * 300) * bShift", "q": 0.8 },
    { "id": "washAmt", "type": "expr", "expr": "(0.15 + 1.1 * size * size + cheer * (0.9 + 0.8 * size)) * (1 - 0.7 * hush)" },
    { "id": "clapDL", "type": "dust", "density": "(60 + 420 * size) * (0.45 + 0.55 * wave)", "spread": 0.8 },
    { "id": "clapDR", "type": "dust", "density": "(60 + 420 * size) * (0.45 + 0.55 * wave)", "spread": 0.8 },
    { "id": "clapL", "type": "filter", "mode": "bp", "in": "clapDL", "freq": "(1500 + bright * 900) * rnd(0.9, 1.1)", "q": 1.3 },
    { "id": "clapR", "type": "filter", "mode": "bp", "in": "clapDR", "freq": "(1700 + bright * 900) * rnd(0.9, 1.1)", "q": 1.3 },
    { "id": "clapAmt", "type": "expr", "expr": "cheer * (20 - 7 * size)" },
    { "id": "sumL", "type": "expr", "expr": "(v1 * 0.94 + v2 * 0.31 + v3 * 0.62 + v4 * 0.99 + v5 * 0.12 + v6 * 0.83 * smooth(0.1, 0.3, size) + v7 * 0.45 * smooth(0.38, 0.58, size) + v8 * 0.73 * smooth(0.66, 0.86, size)) + (washLo + washHi * 0.6) * washAmt + clapL * clapAmt" },
    { "id": "sumR", "type": "expr", "expr": "(v1 * 0.35 + v2 * 0.95 + v3 * 0.79 + v4 * 0.16 + v5 * 0.99 + v6 * 0.56 * smooth(0.1, 0.3, size) + v7 * 0.89 * smooth(0.38, 0.58, size) + v8 * 0.68 * smooth(0.66, 0.86, size)) + (washLo2 + washHi2 * 0.6) * washAmt + clapR * clapAmt" },
    { "id": "farL", "type": "filter", "mode": "lp", "in": "sumL * swl", "freq": "(2200 + bright * 4200) * (1.15 - 0.4 * size)", "q": 0.6 },
    { "id": "farR", "type": "filter", "mode": "lp", "in": "sumR * swl", "freq": "(2200 + bright * 4200) * (1.15 - 0.4 * size)", "q": 0.6 },
    { "id": "roomL", "type": "reverb", "in": "farL", "size": "0.45 + 0.4 * size", "damp": 0.5, "mix": "0.18 + 0.27 * size" },
    { "id": "roomR", "type": "reverb", "in": "farR", "size": "0.5 + 0.4 * size", "damp": 0.5, "mix": "0.18 + 0.27 * size" },
    { "id": "outL", "type": "filter", "mode": "hp", "in": "roomL", "freq": 70 },
    { "id": "outR", "type": "filter", "mode": "hp", "in": "roomR", "freq": 70 }
  ],
  "out": [
    "outL",
    "outR"
  ],
