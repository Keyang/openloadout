  },
  {
   "id": "aLf",
   "type": "filter",
   "mode": "lp",
   "in": "aL",
   "freq": "500 + bright*6000",
   "q": 0.7
  },
  {
   "id": "aRf",
   "type": "filter",
   "mode": "lp",
   "in": "aR",
   "freq": "500 + bright*6000",
   "q": 0.7
  },
  {
   "id": "duck",
   "type": "expr",
   "expr": "1 - kA*gKit*0.12"
  },
  {
   "id": "ctr",
   "type": "expr",
   "expr": "kO*0.5*gKit*gLift + sO*0.3*gTop*gLift + bO*0.22"
  },
  {
   "id": "muL",
   "type": "expr",
   "expr": "(oL*0.4 + lF*0.6*lead*gTune*gLift + aLf*0.2*gTop + rO*0.14*gKit*gLift*(0.45 + 1.1*bright))*duck"
  },
  {
   "id": "muR",
   "type": "expr",
   "expr": "(oR*0.4 + lF*0.6*lead*gTune*gLift + aRf*0.3*gTop + rO*0.2*gKit*gLift*(0.45 + 1.1*bright))*duck"
  },
  {
   "id": "rv",
   "type": "reverb",
   "in": "(muL + muR)*0.5 + (sO*0.2*gTop)",
   "size": 0.95,
   "damp": 0.45,
   "mix": 1
  },
  {
   "id": "mL",
   "type": "shaper",
   "in": "(ctr + muL + rv*space*2)*0.95",
   "drive": 1
  },
  {
   "id": "mR",
   "type": "shaper",
   "in": "(ctr + muR + rv*space*2)*0.95",
   "drive": 1
  }
 ],
 "out": [
  "mL",
  "mR"
 ],
