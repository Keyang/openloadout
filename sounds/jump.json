{
 "format": "sfxpatch/0.1",
 "id": "jump",
 "name": "Jump",
 "category": "movement",
 "tags": [
  "platformer",
  "hop",
  "retro"
 ],
 "description": "Rising pulse-wave chirp.",
 "meta": {
  "type": "sfx",
  "role": "actions/jump",
  "themes": [
   "neutral"
  ],
  "gameTypes": [
   "platformer",
   "arcade"
  ],
  "words": [
   "jump",
   "hop",
   "leap",
   "bounce",
   "spring",
   "boing",
   "double jump",
   "retro",
   "chiptune",
   "8-bit"
  ],
  "license": "draft"
 },
 "duration": "length + 0.02",
 "params": [
  {
   "id": "pitch",
   "label": "Start pitch",
   "min": 120,
   "max": 900,
   "default": 300,
   "unit": "Hz",
   "scale": "log"
  },
  {
   "id": "rise",
   "label": "Rise",
   "min": 0.2,
   "max": 2.5,
   "default": 1.2,
   "unit": "oct"
  },
  {
   "id": "length",
   "label": "Length",
   "min": 0.08,
   "max": 0.5,
   "default": 0.2,
   "unit": "s",
   "scale": "log"
  },
  {
   "id": "duty",
   "label": "Pulse width",
   "min": 0.08,
   "max": 0.5,
   "default": 0.25
  },
  {
   "id": "soft",
   "label": "Softness",
   "min": 0,
   "max": 1,
   "default": 0.3
  }
 ],
 "nodes": [
  {
   "id": "sweep",
   "type": "env",
   "points": [
    [
     0,
     "pitch"
    ],
    [
     "length",
     "pitch * 2^rise",
     "exp"
    ]
   ]
  },
  {
   "id": "pulse",
   "type": "osc",
   "wave": "pulse",
   "freq": "sweep",
   "width": "duty"
  },
  {
   "id": "amp",
   "type": "ad",
   "attack": 0.004,
   "decay": "length",
   "curve": 1.2
  },
  {
   "id": "tone",
   "type": "filter",
   "mode": "lp",
   "in": "pulse",
   "freq": "mix(14000, 1200, soft)",
   "q": 0.8
  }
 ],
 "out": "tone * amp",
 "presets": {
  "Tiny hop": {
   "pitch": 520,
   "rise": 0.8,
   "length": 0.1,
   "duty": 0.5,
   "soft": 0.5
  },
  "Big leap": {
   "pitch": 180,
   "rise": 2.2,
   "length": 0.4,
   "duty": 0.15,
   "soft": 0.1
  }
 }
}