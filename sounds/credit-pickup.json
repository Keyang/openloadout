{
  "format": "sfxpatch/0.1",
  "id": "credit-pickup",
  "name": "Credit pickup",
  "category": "pickup",
  "tags": ["sci-fi", "gritty", "coin", "reward"],
  "description": "The coin sound of the sci-fi kit: two quick digital FM blips, the second higher, with a crushed sparkle on the second. Pitch, interval, speed, ring and grit can be changed; with a very wide interval it becomes a run of five rising blips. Identical every time.",
  "meta": {
    "type": "sfx",
    "role": "items/pickup",
    "themes": ["sci-fi", "space"],
    "gameTypes": ["roguelike-action", "shooter", "arcade"],
    "words": ["credit", "coin", "chip", "money", "pickup", "collect", "loot", "reward", "payout", "keycard", "cash", "blip", "score"],
    "license": "draft"
  },
  "duration": "speed*(1 + 3*step(12, spread)) + ring + 0.02",
  "params": [
    { "id": "pitch", "label": "Pitch", "min": 500, "max": 2000, "default": 1100, "unit": "Hz", "scale": "log" },
    { "id": "spread", "label": "Interval", "min": 2, "max": 16, "default": 7, "unit": "semitones" },
    { "id": "speed", "label": "Speed", "min": 0.04, "max": 0.1, "default": 0.065, "unit": "s", "scale": "log" },
    { "id": "ring", "label": "Ring", "min": 0.06, "max": 0.22, "default": 0.12, "unit": "s", "scale": "log" },
    { "id": "grit", "label": "Grit", "min": 0, "max": 1, "default": 0.5 }
  ],
  "nodes": [
    { "id": "clk", "type": "clock", "rate": "1/speed", "count": "2 + 3*step(12, spread)" },
    { "id": "note", "type": "seq", "steps": ["pitch", "pitch*semi(spread/(1 + 3*step(12, spread)))", "pitch*semi(spread/2)", "pitch*semi(spread*0.75)", "pitch*semi(spread)"], "trig": "clk" },
    { "id": "modOsc", "type": "osc", "wave": "sine", "freq": "note*2" },
    { "id": "fmAd", "type": "ad", "attack": 0.0005, "decay": 0.045, "curve": 2, "trig": "clk" },
    { "id": "car", "type": "osc", "wave": "sine", "freq": "note", "pm": "modOsc*fmAd*(0.12 + grit*0.3)" },
    { "id": "tri", "type": "osc", "wave": "tri", "freq": "note*2" },
    { "id": "amp", "type": "ad", "attack": 0.001, "decay": "ring", "curve": 2.4, "trig": "clk" },
    { "id": "lastClk", "type": "clock", "rate": 1, "count": 1, "delay": "speed*(1 + 3*step(12, spread))" },
    { "id": "lastNote", "type": "expr", "expr": "pitch*semi(spread)" },
    { "id": "spkOsc", "type": "osc", "wave": "pulse", "width": 0.25, "freq": "lastNote*3.01" },
    { "id": "spkCrush", "type": "crush", "in": "spkOsc", "bits": "6 - grit*3", "rate": "9000 - grit*4000" },
    { "id": "spkAd", "type": "ad", "attack": 0.0008, "decay": "0.05 + ring*0.4", "curve": 2.5, "trig": "lastClk" },
    { "id": "tick", "type": "noise" },
    { "id": "tickAd", "type": "ad", "attack": 0.0003, "decay": 0.008, "curve": 2.5, "trig": "clk" },
    { "id": "tickF", "type": "filter", "mode": "hp", "in": "tick", "freq": 3000, "q": 0.8 },
    { "id": "sum", "type": "expr", "expr": "car*amp*0.9 + tri*amp*0.18 + spkCrush*spkAd*(0.2 + grit*0.3) + tickF*tickAd*0.06" },
    { "id": "clean", "type": "filter", "mode": "hp", "in": "sum", "freq": 200, "q": 0.7 }
  ],
  "out": "clean",
  "presets": {
    "Credit chip": { "pitch": 1100, "spread": 7, "speed": 0.065, "ring": 0.12, "grit": 0.5 },
    "Keycard": { "pitch": 760, "spread": 5, "speed": 0.085, "ring": 0.16, "grit": 0.2 },
    "Big payout": { "pitch": 880, "spread": 15, "speed": 0.05, "ring": 0.1, "grit": 0.6 }
  }
}
