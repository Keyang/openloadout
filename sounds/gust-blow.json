{
  "format": "sfxpatch/0.1",
  "id": "gust-blow",
  "name": "Gust",
  "category": "magic",
  "description": "A single push of wind that swells and dies away, for a blown gust or a room's wind starting. Change how high it sweeps, its length, brightness, whistle and how soon it peaks.",
  "meta": {
    "type": "sfx",
    "role": "effects/magic",
    "themes": ["fantasy", "forest"],
    "gameTypes": ["platformer", "arcade"],
    "words": ["gust", "wind", "blow", "puff", "breath", "air", "push", "whistle", "breeze", "blast", "exhale", "airy"],
    "license": "draft"
  },
  "duration": "length + 0.02",
  "params": [
    { "id": "pitch", "label": "Pitch", "unit": "Hz", "min": 600, "max": 3000, "default": 1400, "scale": "log", "hint": "How high the wind sweeps at its peak" },
    { "id": "length", "label": "Length", "unit": "s", "min": 0.3, "max": 1.2, "default": 0.6, "scale": "log" },
    { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.5 },
    { "id": "whistle", "label": "Whistle", "min": 0, "max": 1, "default": 0.3 },
    { "id": "attack", "label": "Swell", "min": 0.05, "max": 0.8, "default": 0.35, "hint": "How far into the gust it is strongest" }
  ],
  "nodes": [
    { "id": "air", "type": "noise", "color": "pink" },
    { "id": "level", "type": "env", "points": [[0, 0], ["length * attack", "rnd(0.82, 1)", 0.5], ["length", 0, 0.6]] },
    { "id": "centre", "type": "env", "start": 400, "points": [[0, 400], ["length * attack", "pitch * rnd(0.9, 1.12)", "exp"], ["length", 400, "exp"]] },
    { "id": "band", "type": "filter", "mode": "bp", "in": "air", "freq": "centre", "q": 1.4 },
    { "id": "wob", "type": "rand", "lo": 0.93, "hi": 1.07 },
    { "id": "thin", "type": "filter", "mode": "bp", "in": "air", "freq": "centre * 3 * wob", "q": 16 },
    { "id": "hiss", "type": "filter", "mode": "hp", "in": "air", "freq": 4500 },
    { "id": "tone", "type": "filter", "mode": "lp", "in": "band + thin * whistle * 0.5 + hiss * bright * 0.5", "freq": "1200 + bright * 9000" },
    { "id": "clean", "type": "filter", "mode": "hp", "in": "tone", "freq": 120 }
  ],
  "out": "clean * level",
  "presets": {
    "Gust": {},
    "Toad puff": { "length": 0.35, "attack": 0.08, "pitch": 1900, "whistle": 0.1 },
    "Dying": { "length": 1.0, "attack": 0.05, "pitch": 900, "bright": 0.3 }
  }
}
