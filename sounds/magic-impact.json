{
  "format": "sfxpatch/0.1",
  "id": "magic-impact",
  "name": "Magic impact",
  "category": "magic",
  "description": "A spell landing: a soft thump, a short tone that blooms and falls, and a spray of tiny bright pings scattering downward. Change its pitch, length, brightness, sparks, element and room.",
  "meta": { "type": "sfx", "role": "effects/impact", "themes": ["neutral", "fantasy", "dungeon"], "gameTypes": ["turn-based-rpg", "top-down-rpg", "platformer", "roguelike-action", "arcade"],
    "words": ["magic", "spell", "impact", "hit", "burst", "land", "explode", "sparks", "arcane", "fireball", "shadow", "damage", "blast"], "license": "draft" },
  "duration": "length + space * 0.2",
  "params": [
    { "id": "pitch", "label": "Pitch", "unit": "Hz", "min": 300, "max": 1200, "default": 600, "scale": "log" },
    { "id": "length", "label": "Length", "unit": "s", "min": 0.25, "max": 0.9, "default": 0.45, "scale": "log" },
    { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.5 },
    { "id": "sparks", "label": "Sparks", "min": 0, "max": 1, "default": 0.5 },
    { "id": "element", "label": "Element", "min": 0, "max": 2, "default": 0, "options": ["Arcane", "Fire", "Shadow"] },
    { "id": "space", "label": "Room", "min": 0, "max": 0.4, "default": 0.15 }
  ],
  "nodes": [
    { "id": "isFire", "type": "expr", "expr": "element == 1 ? 1 : 0" },
    { "id": "isShadow", "type": "expr", "expr": "element == 2 ? 1 : 0" },

    { "id": "thF", "type": "env", "points": [[0, "190 * rnd(0.9, 1.1)"], [0.07, 62, "exp"]] },
    { "id": "thump", "type": "osc", "freq": "thF", "phase": 0.25 },
    { "id": "thAmp", "type": "ad", "attack": 0.003, "decay": "0.07 + length * 0.12", "curve": 2.2 },
    { "id": "thN", "type": "noise" },
    { "id": "thPuff", "type": "filter", "mode": "bp", "in": "thN", "freq": "500 + bright * 500", "q": 0.8 },
    { "id": "puffAmp", "type": "ad", "attack": 0.002, "decay": 0.05, "curve": 2 },

    { "id": "fall", "type": "env", "points": [[0, "pitch * rnd(0.97, 1.03)"], ["length * 0.1", "pitch * rnd(0.97, 1.03)"], ["length * 0.7", "pitch * semi(-7)", "exp"]] },
    { "id": "bloom", "type": "env", "points": [[0, 0.15], ["length * 0.12", 1, 0.6], ["length * 0.75", 0.05, 2]] },
    { "id": "tMod", "type": "osc", "freq": "fall * 2.005" },
    { "id": "tone", "type": "osc", "freq": "fall", "pm": "tMod * bloom * (0.25 + bright * 0.7)" },
    { "id": "toneHi", "type": "osc", "wave": "tri", "freq": "fall * 2" },
    { "id": "toneAmp", "type": "ad", "attack": 0.003, "hold": "length * 0.08", "decay": "length * 0.85", "curve": 2 },

    { "id": "grF", "type": "env", "points": [[0, "pitch * 0.3 * rnd(0.94, 1.06)"], ["length * 0.9", "pitch * 0.13", "exp"]] },
    { "id": "grWob", "type": "noise", "color": "brown" },
    { "id": "grRaw", "type": "osc", "wave": "saw", "freq": "grF * (1 + grWob * 0.12)" },
    { "id": "grFold", "type": "shaper", "in": "grRaw * (0.8 + grWob * 0.5)", "drive": "2.5 + bright * 3", "mode": "fold" },
    { "id": "growl", "type": "filter", "mode": "lp", "in": "grFold", "freq": "grF * (5 + bright * 9)", "q": 1.4 },
    { "id": "rasp", "type": "filter", "mode": "bp", "in": "grFold", "freq": "700 + bright * 900", "q": 0.9 },
    { "id": "grAmp", "type": "ad", "attack": 0.004, "hold": "length * 0.1", "decay": "length * 0.85", "curve": 1.7 },

    { "id": "fN", "type": "noise" },
    { "id": "fCut", "type": "env", "points": [[0, "1400 + bright * 2600"], ["length * 0.7", 350, "exp"]] },
    { "id": "roar", "type": "filter", "mode": "lp", "in": "fN", "freq": "fCut", "q": 1.1 },
    { "id": "roarAmp", "type": "ad", "attack": 0.004, "hold": "length * 0.06", "decay": "length * 0.75", "curve": 1.6 },

    { "id": "clk", "type": "clock", "rate": "(6 + round(sparks * 4)) / (length * 0.6)", "jitter": 0.7, "delay": "rnd(0.012, 0.03)", "count": "6 + round(sparks * 4)" },
    { "id": "rp", "type": "rand", "trig": "clk" },
    { "id": "scatter", "type": "env", "points": [[0, 1], ["length * 0.65", 0.42, "exp"]] },
    { "id": "pF", "type": "sah", "in": "pitch * (3.2 + bright * 2.4) * scatter * (0.8 + rp * 0.5)", "trig": "clk" },
    { "id": "ping", "type": "osc", "freq": "pF" },
    { "id": "pingAmp", "type": "ad", "attack": 0.001, "decay": "0.03 + length * 0.07", "curve": 2.4, "trig": "clk" },
    { "id": "pingLvl", "type": "env", "points": [[0, 1], ["length * 0.7", 0.35]] },

    { "id": "dry", "type": "expr", "expr": "thump * thAmp * 0.9 + thPuff * puffAmp * 0.5 + (tone * 0.5 + toneHi * 0.12 * bright) * toneAmp * (1 - isShadow) + (growl * 0.2 + rasp * 1.3) * grAmp * isShadow + roar * roarAmp * 1.1 * isFire + ping * pingAmp * pingLvl * (0.05 + sparks * 0.9)" },
    { "id": "top", "type": "filter", "mode": "lp", "in": "dry", "freq": "3500 + bright * 12000" },
    { "id": "room", "type": "reverb", "in": "top", "size": 0.55, "damp": 0.35, "mix": "space" },
    { "id": "clean", "type": "filter", "mode": "hp", "in": "room", "freq": 35 }
  ],
  "out": "clean",
  "presets": {
    "Arcane hit": { "element": 0 },
    "Fire hit": { "element": 1, "pitch": 480, "bright": 0.55 },
    "Shadow hit": { "element": 2, "pitch": 420, "length": 0.55, "bright": 0.4 }
  }
}
