{
 "format": "sfxpatch/0.1",
 "id": "shop-bell",
 "name": "Shop bell",
 "category": "ui",
 "description": "The little bell over a shop door, knocked by the door and ringing out; the same every time. Change its pitch, how long it rings, how much it shines and how many times it is struck.",
 "meta": {
  "type": "sfx",
  "role": "world/door",
  "themes": ["neutral", "fantasy", "farm"],
  "gameTypes": ["top-down-rpg", "turn-based-rpg", "farming-sim", "arcade", "puzzle"],
  "words": ["bell", "shop", "store", "door", "enter", "ding", "ring", "jingle", "merchant", "inn", "counter", "welcome", "trade"],
  "license": "draft"
 },
 "duration": "(swing - 1)*0.13 + ring + 0.05",
 "params": [
  { "id": "pitch", "label": "Pitch", "unit": "Hz", "min": 900, "max": 2600, "default": 1500, "scale": "log" },
  { "id": "ring", "label": "Ring", "unit": "s", "min": 0.5, "max": 1.25, "default": 0.75, "scale": "log" },
  { "id": "shine", "label": "Shine", "min": 0, "max": 1, "default": 0.5 },
  { "id": "swing", "label": "Swing", "min": 1, "max": 3, "default": 2, "step": 1 }
 ],
 "nodes": [
  { "id": "clk", "type": "clock", "rate": 7.7, "count": "swing" },
  { "id": "force", "type": "seq", "steps": [1, 0.62, 0.42], "trig": "clk" },
  { "id": "tap", "type": "ad", "attack": 0.0003, "decay": 0.003, "curve": 2, "trig": "clk" },
  { "id": "hit", "type": "expr", "expr": "(clk + tap*0.15)*force" },
  { "id": "low", "type": "modal", "in": "hit", "freq": "pitch", "ratios": [1, 2.41], "gains": [1, 0.55], "decay": "ring*2.6", "tilt": 0.5 },
  { "id": "lowB", "type": "modal", "in": "hit", "freq": "pitch*1.004", "ratios": [1], "decay": "ring*2.3", "tilt": 0.5 },
  { "id": "high", "type": "modal", "in": "hit", "freq": "pitch", "ratios": [4.18, 6.37, 8.85], "gains": [1, 0.8, 0.6], "decay": "ring*1.1", "tilt": 0.6 },
  { "id": "clank", "type": "modal", "in": "hit", "freq": "pitch*1.7", "ratios": [1, 1.6, 2.3], "decay": 0.02, "tilt": 0.3 },
  { "id": "dry", "type": "expr", "expr": "low*0.6 + lowB*0.25 + high*(0.03 + 0.4*shine) + clank*(0.04 + 0.16*shine)" },
  { "id": "clean", "type": "filter", "mode": "hp", "in": "dry", "freq": 120 }
 ],
 "out": "clean*(1 - smooth(dur - 0.12, dur - 0.003, t))",
 "presets": {
  "Shop door": { "pitch": 1500, "ring": 0.75, "shine": 0.5, "swing": 2 },
  "Inn door": { "pitch": 1050, "ring": 1.0, "shine": 0.3, "swing": 3 },
  "Counter bell": { "pitch": 2200, "ring": 1.1, "shine": 0.8, "swing": 1 }
 }
}
