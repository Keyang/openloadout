  {
   "id": "vib",
   "type": "osc",
   "freq": 5.8
  },
  {
   "id": "lA",
   "type": "ad",
   "trig": "lG",
   "attack": 0.006,
   "hold": 0.12,
   "decay": 0.35,
   "curve": 1.4
