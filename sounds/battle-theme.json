   "expr": "inst < 0.5 ? (lO1*0.6 + lO2*0.5)*lA : inst < 1.5 ? (fO1 + fO2*0.18 + fN*0.5)*fA*0.8 : inst < 2.5 ? (cO1*0.6 + cO2*0.22)*cA2*1 : inst < 3.5 ? beC*beA*1 : plS*1.7"
  },
  {
   "id": "lF",
   "type": "filter",
   "mode": "lp",
   "in": "lIn",
   "freq": "1200 + bright*4500 + lA*1500",
   "q": 1.3
  },
  {
   "id": "lE",
   "type": "delay",
   "in": "lF",
   "time": "60/bpm*0.75",
   "feedback": 0.35,
   "mix": 0.3,
   "max": 0.6
  },
  {
   "id": "duck",
   "type": "expr",
