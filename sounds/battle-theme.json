  },
  {
   "id": "stT",
   "type": "pattern",
   "trig": "c16",
   "steps": "X..x..x...x.x...|X..x..x...x.x.x."
  },
  {
   "id": "stA",
   "type": "ad",
   "trig": "stT",
   "attack": 0.004,
   "hold": 0.03,
   "decay": 0.16,
   "curve": 1.5
  },
  {
   "id": "stO1",
   "type": "osc",
   "wave": "saw",
   "freq": "midi(50 + tr)"
  },
  {
   "id": "stO2",
   "type": "osc",
   "wave": "saw",
   "freq": "midi(50 + tr + third)"
  },
  {
   "id": "stO3",
   "type": "osc",
   "wave": "saw",
   "freq": "midi(57 + tr)"
  },
  {
