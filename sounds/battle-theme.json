   "wave": "saw",
   "freq": "aF"
  },
  {
   "id": "aO2",
   "type": "osc",
   "wave": "saw",
   "freq": "aF*1.007"
  },
  {
   "id": "aL",
   "type": "filter",
   "mode": "lp",
   "in": "aO1*aA",
   "freq": "900 + bright*3500 + aA*1500",
