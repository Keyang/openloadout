   "size": 0.75,
   "damp": 0.35,
   "mix": 1
  },
  {
   "id": "mL",
   "type": "shaper",
   "in": "(dr + bD*0.34 + muL + rv*space*2)*0.7",
   "drive": "1 + grit*0.8"
  },
  {
   "id": "mR",
   "type": "shaper",
   "in": "(dr + bD*0.34 + muR + rv*space*2)*0.7",
   "drive": "1 + grit*0.8"
  }
 ],
 "out": [
