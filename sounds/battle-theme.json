  {
   "id": "fA",
   "type": "ad",
   "trig": "lG",
   "attack": 0.035,
   "hold": 0.12,
   "decay": 0.3,
   "curve": 1.3
  },
  {
   "id": "fO1",
   "type": "osc",
   "freq": "lP*(1 + vib*0.009)"
  },
  {
   "id": "fO2",
   "type": "osc",
   "wave": "tri",
   "freq": "lP*2*(1 + vib*0.009)"
  },
  {
   "id": "fN",
   "type": "filter",
   "mode": "bp",
   "in": "nz",
   "freq": "lP*2",
   "q": 3
  },
  {
   "id": "cA2",
   "type": "ad",
   "trig": "lG",
   "attack": 0.002,
   "hold": 0.09,
   "decay": 0.16,
   "curve": 1.2
  },
  {
   "id": "cO1",
   "type": "osc",
