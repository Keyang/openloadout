   "wave": "tri",
   "freq": "sP"
  },
  {
   "id": "hT",
   "type": "pattern",
   "trig": "c16",
   "steps": "X.xoX.xoX.xoX.xo|X.xoX.xoX.xoXoxx"
  },
  {
   "id": "hV",
   "type": "sah",
   "in": "hT",
   "trig": "hT"
  },
  {
   "id": "hA",
   "type": "ad",
   "trig": "hT",
   "attack": 0.0005,
   "decay": 0.035,
   "curve": 2
  },
  {
   "id": "hN",
   "type": "filter",
   "mode": "hp",
   "in": "nz",
   "freq": "6500 + bright*2500",
   "q": 0.8
  },
  {
   "id": "cT",
   "type": "pattern",
   "trig": "c16",
   "every": 16,
   "steps": "x...x..."
  },
  {
   "id": "cA",
   "type": "ad",
   "trig": "cT",
   "attack": 0.002,
   "decay": 1.4,
   "curve": 3
  },
  {
   "id": "cN",
   "type": "filter",
   "mode": "hp",
   "in": "nz",
   "freq": 4500
  },
  {
   "id": "bG",
