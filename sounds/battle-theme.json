  {
   "id": "stR",
   "type": "filter",
   "mode": "lp",
   "in": "(stO1*0.5 + stO3*0.6 + stO4*0.35)*stA",
   "freq": "500 + stA*(1500 + bright*4000)",
   "q": 1.5
  },
  {
   "id": "lG",
   "type": "pattern",
   "trig": "c16",
   "steps": "X..x..x.X...x.x.|X..x..X.......x.|X..x..x.X...x.x.|X..x..x.x...X...|X..x..X.x...x.x.|X..x..X.....x.x.|X..x..x.x...x.x.|X...x...x.x.x.X."
  },
  {
   "id": "lS",
   "type": "seq",
   "trig": "c16",
   "loop": true,
   "steps": "0 _ _ 0 _ _ 3 _ 7 _ _ _ 5 _ 3 _ | 2 _ _ 3 _ _ 0 _ _ _ _ _ _ _ -5 _ | -4 _ _ 0 _ _ 3 _ 8 _ _ _ 7 _ 5 _ | 5 _ _ 2 _ _ -2 _ 2 _ _ _ 5 _ _ _ | 7 _ _ 7 _ _ 12 _ 10 _ _ _ 7 _ 3 _ | 5 _ _ 7 _ _ 3 _ _ _ _ _ 0 _ 3 _ | 8 _ _ 7 _ _ 5 _ 3 _ _ _ 5 _ 7 _ | 2 _ _ _ -1 _ _ _ 2 _ 7 _ 11 _ 14 _"
