{
  "format": "sfxpatch/0.1",
  "id": "gear-equip",
  "name": "Equip gear",
  "category": "pickup",
  "description": "Armour or clothing put on: a short rustle as it is pulled into place, a firm buckle clack, then a soft double pat for cloth, a dry creak for leather or two small plates clinking for metal. Change its weight, length, brightness, what it is made of and how hard the buckle snaps.",
  "meta": {
    "type": "sfx",
    "role": "items/equip",
    "themes": [
      "neutral",
      "fantasy",
      "dungeon"
    ],
    "gameTypes": [
      "top-down-rpg",
      "turn-based-rpg",
      "roguelike-action",
      "platformer",
      "arcade"
    ],
    "words": [
      "equip",
      "gear",
      "armour",
      "armor",
      "clothing",
      "wear",
      "put on",
      "buckle",
      "strap",
      "rustle",
      "leather",
      "cloth",
      "plate",
      "inventory"
    ],
    "license": "draft"
  },
  "duration": "length + 0.005",
  "params": [
    {
      "id": "weight",
      "label": "Weight",
      "min": 0.5,
      "max": 2,
      "default": 1,
      "scale": "log"
    },
    {
      "id": "length",
      "label": "Length",
      "unit": "s",
      "min": 0.2,
      "max": 0.6,
      "default": 0.35,
      "scale": "log"
    },
    {
      "id": "bright",
      "label": "Brightness",
      "min": 0,
      "max": 1,
      "default": 0.5
    },
    {
      "id": "gear",
      "label": "Gear",
      "min": 0,
      "max": 2,
      "default": 1,
      "options": [
        "Cloth",
        "Leather",
        "Metal"
      ]
    },
    {
      "id": "buckle",
      "label": "Buckle",
      "min": 0,
      "max": 1,
      "default": 0.6
    }
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "noise",
      "seed": 11
    },
    {
      "id": "n2",
      "type": "noise",
      "color": "pink",
      "seed": 23
    },
    {
      "id": "n3",
      "type": "noise",
      "seed": 37
    },
    {
      "id": "wob",
      "type": "lag",
      "in": "abs(n3)",
      "time": 0.004
    },
    {
      "id": "rusEnv",
      "type": "ad",
      "attack": 0.003,
      "hold": 0.02,
      "decay": "clamp(length * 0.2, 0.05, 0.1)",
      "curve": 1.6
    },
    {
      "id": "rusSweep",
      "type": "env",
      "points": [
        [
          0,
          0.75
        ],
        [
          "clamp(length * 0.25, 0.06, 0.12)",
          1.35
        ]
      ]
    },
    {
      "id": "rusBand",
      "type": "filter",
      "mode": "bp",
      "in": "n1",
      "freq": "1900 * pow(weight, -0.45) * (0.75 + bright * 0.5) * rusSweep",
      "q": 0.9
    },
    {
      "id": "rustle",
      "type": "expr",
      "expr": "rusBand * rusEnv * (0.35 + wob * 1.3)"
    },
    {
      "id": "bTrig",
      "type": "clock",
      "rate": 1,
      "count": 1,
      "delay": "length * 0.3"
    },
    {
      "id": "clickEnv",
      "type": "ad",
      "attack": 0.0003,
      "decay": 0.009,
      "curve": 3,
      "trig": "bTrig"
    },
    {
      "id": "clickBand",
      "type": "filter",
      "mode": "hp",
      "in": "n1",
      "freq": "1800 + bright * 2200"
    },
    {
      "id": "snapRing",
      "type": "modal",
      "in": "bTrig",
      "freq": "2300 * pow(weight, -0.35) * (0.85 + bright * 0.3)",
      "ratios": [
        1,
        1.59,
        2.31
      ],
      "decay": 0.022,
      "tilt": 0.5
    },
    {
      "id": "thockPitch",
      "type": "env",
      "points": [
        [
          0,
          "230 / weight"
        ],
        [
          0.035,
          "125 / weight",
          "exp"
        ]
      ],
      "trig": "bTrig"
    },
    {
      "id": "thockOsc",
      "type": "osc",
      "wave": "sine",
      "freq": "thockPitch"
    },
    {
      "id": "thockEnv",
      "type": "ad",
      "attack": 0.001,
      "decay": "0.045 * (0.7 + weight * 0.3)",
      "curve": 2.2,
      "trig": "bTrig"
    },
    {
      "id": "knockBand",
      "type": "filter",
      "mode": "bp",
      "in": "n2",
      "freq": "620 / pow(weight, 0.6)",
      "q": 2.5
    },
    {
      "id": "clack",
      "type": "expr",
      "expr": "(clickBand * clickEnv * 1.1 + snapRing * 0.5 + thockOsc * thockEnv * 0.55 + knockBand * thockEnv * 1.6) * (0.12 + buckle * 1.5)"
    },
    {
      "id": "patTrig",
      "type": "clock",
      "rate": "1 / (length * 0.23)",
      "count": 2,
      "delay": "length * 0.47"
    },
    {
      "id": "patEnv",
      "type": "ad",
      "attack": 0.004,
      "decay": "clamp(length * 0.16, 0.035, 0.09)",
      "curve": 2,
      "trig": "patTrig"
    },
    {
      "id": "patFade",
      "type": "env",
      "points": [
        [
          0,
          1
        ],
        [
          "length * 0.47 + length * 0.1",
          1
        ],
        [
          "length * 0.47 + length * 0.3",
          0.55
        ]
      ]
    },
    {
      "id": "patLow",
      "type": "filter",
      "mode": "lp",
      "in": "n2",
      "freq": "520 / pow(weight, 0.5) * (0.8 + bright * 0.4)"
    },
    {
      "id": "patMid",
      "type": "filter",
      "mode": "bp",
      "in": "n3",
      "freq": "1300 * pow(weight, -0.4) * (0.7 + bright * 0.6)",
      "q": 0.8
    },
    {
      "id": "pats",
      "type": "expr",
      "expr": "(patLow * 1.5 + patMid * 0.55) * patEnv * patFade"
    },
    {
      "id": "tTrig",
      "type": "clock",
      "rate": 1,
      "count": 1,
      "delay": "length * 0.47"
    },
    {
      "id": "creakRate",
      "type": "env",
      "points": [
        [
          0,
          48
        ],
        [
          "length * 0.5 * 0.45",
          112
        ],
        [
          "length * 0.5 * 0.75",
          84
        ],
        [
          "length * 0.5",
          60
        ]
      ],
      "trig": "tTrig"
    },
    {
      "id": "creakJit",
      "type": "lag",
      "in": "n3",
      "time": 0.006
    },
    {
      "id": "creakSrc",
      "type": "osc",
      "wave": "pulse",
      "width": 0.08,
      "freq": "creakRate / pow(weight, 0.5) * (1 + creakJit * 2.4)"
    },
    {
      "id": "creakEnv",
      "type": "env",
      "points": [
        [
          0,
          0
        ],
        [
          0.012,
          1
        ],
        [
          "length * 0.5 * 0.55",
          0.8
        ],
        [
          "length * 0.5 * 0.96",
          0,
          1.5
        ]
      ],
      "trig": "tTrig"
    },
    {
      "id": "creakA",
      "type": "filter",
      "mode": "bp",
      "in": "creakSrc",
      "freq": "1150 * pow(weight, -0.4) * (0.8 + bright * 0.4)",
      "q": 5
    },
    {
      "id": "creakB",
      "type": "filter",
      "mode": "bp",
      "in": "creakSrc",
      "freq": "2450 * pow(weight, -0.4) * (0.8 + bright * 0.4)",
      "q": 6
    },
    {
      "id": "creak",
      "type": "expr",
      "expr": "(creakA + creakB * (0.4 + bright * 0.5) + n1 * 0.02) * creakEnv"
    },
    {
      "id": "c2Trig",
      "type": "clock",
      "rate": 1,
      "count": 1,
      "delay": "length * 0.47 + length * 0.19"
    },
    {
      "id": "plateA",
      "type": "modal",
      "in": "tTrig",
      "freq": "1520 * pow(weight, -0.3) * (0.92 + bright * 0.16)",
      "ratios": [
        1,
        1.34,
        1.71,
        1.93
      ],
      "decay": "0.07 + weight * 0.05",
      "tilt": 0.6
    },
    {
      "id": "plateB",
      "type": "modal",
      "in": "c2Trig",
      "freq": "1330 * pow(weight, -0.3) * (0.92 + bright * 0.16)",
      "ratios": [
        1,
        1.27,
        1.58,
        2.12
      ],
      "decay": "0.08 + weight * 0.06",
      "tilt": 0.6
    },
    {
      "id": "tickEnvA",
      "type": "ad",
      "attack": 0.0003,
      "decay": 0.005,
      "curve": 3,
      "trig": "tTrig"
    },
    {
      "id": "tickEnvB",
      "type": "ad",
      "attack": 0.0003,
      "decay": 0.005,
      "curve": 3,
      "trig": "c2Trig"
    },
    {
      "id": "clink",
      "type": "expr",
      "expr": "plateA * 0.25 + plateB * 0.2 + clickBand * (tickEnvA + tickEnvB * 0.8) * 0.5"
    },
    {
      "id": "tailMix",
      "type": "expr",
      "expr": "gear < 0.5 ? pats * 1.9 : (gear < 1.5 ? creak * 0.5 : clink * 1.9)"
    },
    {
      "id": "endFade",
      "type": "env",
      "points": [
        [
          0,
          1
        ],
        [
          "length * 0.82",
          1
        ],
        [
          "length",
          0,
          1.5
        ]
      ]
    },
    {
      "id": "sum",
      "type": "expr",
      "expr": "(rustle * 1.5 + clack + tailMix) * endFade"
    },
    {
      "id": "top",
      "type": "filter",
      "mode": "lp",
      "in": "sum",
      "freq": "3200 + bright * 11000"
    },
    {
      "id": "clean",
      "type": "filter",
      "mode": "hp",
      "in": "top",
      "freq": 50
    }
  ],
  "out": "clean",
  "presets": {
    "Robe": {
      "gear": 0,
      "weight": 0.8,
      "length": 0.32,
      "bright": 0.4,
      "buckle": 0.3
    },
    "Leather armour": {
      "gear": 1,
      "weight": 1,
      "length": 0.35,
      "bright": 0.5,
      "buckle": 0.6
    },
    "Plate armour": {
      "gear": 2,
      "weight": 1.6,
      "length": 0.45,
      "bright": 0.55,
      "buckle": 0.8
    }
  }
}
