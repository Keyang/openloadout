{
  "format": "sfxpatch/0.1",
  "id": "menu-harp-close",
  "name": "Harp close",
  "category": "ui",
  "description": "A panel going away: a finger swept quickly down across a few warm plucked strings, the last and lowest stopped by the flat of the hand so the run ends short and dull with nothing left ringing, the same every time. Change its pitch, length, brightness and how many strings are swept.",
  "meta": {
    "type": "sfx",
    "role": "interface/click",
    "themes": ["neutral", "fantasy"],
    "gameTypes": ["arcade", "card-game", "turn-based-rpg", "farming-sim", "puzzle"],
    "words": ["menu", "close", "panel", "window", "popup", "inventory", "dismiss", "harp", "plucked", "string", "strum", "sweep", "lyre"],
    "license": "draft"
  },
  "duration": "length + 0.006",
  "params": [
    { "id": "pitch", "label": "Pitch", "unit": "Hz", "min": 220, "max": 520, "default": 330, "scale": "log" },
    { "id": "length", "label": "Length", "unit": "s", "min": 0.16, "max": 0.45, "default": 0.26, "scale": "log" },
    { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.5 },
    { "id": "strings", "label": "Strings", "min": 3, "max": 7, "default": 5, "step": 2 }
  ],
  "nodes": [
    { "id": "hand", "type": "env", "points": [ [ 0, 0 ], [ "length * 0.6 + 0.026", 0, "hold" ], [ "length * 0.6 + 0.032", 1 ] ] },
    { "id": "tick1", "type": "ad", "attack": 0.0003, "decay": 0.002, "curve": 1.5 },
    { "id": "finger1", "type": "filter", "mode": "lp", "in": "tick1", "freq": "1400 + bright * 5000", "q": 0.6 },
    { "id": "string1", "type": "pluck", "freq": "pitch", "decay": "mix(0.15 + length * 1.2, 0.03 + length * 0.3, hand)", "damp": "mix(0.55 - bright * 0.2, 0.88, hand)", "in": "finger1", "trig": 0 },
    { "id": "c2", "type": "clock", "rate": 1, "count": 1, "delay": "1 * length * 0.6 / (strings - 1)" },
    { "id": "tick2", "type": "ad", "attack": 0.0003, "decay": 0.002, "curve": 1.5, "trig": "c2" },
    { "id": "finger2", "type": "filter", "mode": "lp", "in": "tick2", "freq": "1400 + bright * 5000", "q": 0.6 },
    { "id": "string2", "type": "pluck", "freq": "pitch * semi(-3)", "decay": "mix(0.15 + length * 1.2, 0.03 + length * 0.3, hand)", "damp": "mix(0.55 - bright * 0.2, 0.88, hand)", "in": "finger2", "trig": 0 },
    { "id": "c3", "type": "clock", "rate": 1, "count": 1, "delay": "2 * length * 0.6 / (strings - 1)" },
    { "id": "tick3", "type": "ad", "attack": 0.0003, "decay": 0.002, "curve": 1.5, "trig": "c3" },
    { "id": "finger3", "type": "filter", "mode": "lp", "in": "tick3", "freq": "(1400 + bright * 5000) * (1 - 0.3 * (strings < 3.5 ? 1 : 0))", "q": 0.6 },
    { "id": "string3", "type": "pluck", "freq": "pitch * semi(-5)", "decay": "mix(0.15 + length * 1.2, 0.03 + length * 0.3, hand)", "damp": "mix(0.55 - bright * 0.2 + 0.1 * (strings < 3.5 ? 1 : 0), 0.88, hand)", "in": "finger3", "trig": 0 },
    { "id": "c4", "type": "clock", "rate": 1, "count": 1, "delay": "3 * length * 0.6 / (strings - 1)" },
    { "id": "tick4", "type": "ad", "attack": 0.0003, "decay": 0.002, "curve": 1.5, "trig": "c4" },
    { "id": "finger4", "type": "filter", "mode": "lp", "in": "tick4", "freq": "(1400 + bright * 5000) * (1 - 0.3 * (strings < 4.5 ? 1 : 0))", "q": 0.6 },
    { "id": "string4", "type": "pluck", "freq": "pitch * semi(-8)", "decay": "mix(0.15 + length * 1.2, 0.03 + length * 0.3, hand)", "damp": "mix(0.55 - bright * 0.2 + 0.1 * (strings < 4.5 ? 1 : 0), 0.88, hand)", "in": "finger4", "trig": 0 },
    { "id": "c5", "type": "clock", "rate": 1, "count": 1, "delay": "4 * length * 0.6 / (strings - 1)" },
    { "id": "tick5", "type": "ad", "attack": 0.0003, "decay": 0.002, "curve": 1.5, "trig": "c5" },
    { "id": "finger5", "type": "filter", "mode": "lp", "in": "tick5", "freq": "(1400 + bright * 5000) * (1 - 0.3 * (strings < 5.5 ? 1 : 0))", "q": 0.6 },
    { "id": "string5", "type": "pluck", "freq": "pitch * semi(-10)", "decay": "mix(0.15 + length * 1.2, 0.03 + length * 0.3, hand)", "damp": "mix(0.55 - bright * 0.2 + 0.1 * (strings < 5.5 ? 1 : 0), 0.88, hand)", "in": "finger5", "trig": 0 },
    { "id": "c6", "type": "clock", "rate": 1, "count": 1, "delay": "5 * length * 0.6 / (strings - 1)" },
    { "id": "tick6", "type": "ad", "attack": 0.0003, "decay": 0.002, "curve": 1.5, "trig": "c6" },
    { "id": "finger6", "type": "filter", "mode": "lp", "in": "tick6", "freq": "(1400 + bright * 5000) * (1 - 0.3 * (strings < 6.5 ? 1 : 0))", "q": 0.6 },
    { "id": "string6", "type": "pluck", "freq": "pitch * semi(-12)", "decay": "mix(0.15 + length * 1.2, 0.03 + length * 0.3, hand)", "damp": "mix(0.55 - bright * 0.2 + 0.1 * (strings < 6.5 ? 1 : 0), 0.88, hand)", "in": "finger6", "trig": 0 },
    { "id": "c7", "type": "clock", "rate": 1, "count": 1, "delay": "6 * length * 0.6 / (strings - 1)" },
    { "id": "tick7", "type": "ad", "attack": 0.0003, "decay": 0.002, "curve": 1.5, "trig": "c7" },
    { "id": "finger7", "type": "filter", "mode": "lp", "in": "tick7", "freq": "(1400 + bright * 5000) * (1 - 0.3 * (strings < 7.5 ? 1 : 0))", "q": 0.6 },
    { "id": "string7", "type": "pluck", "freq": "pitch * semi(-15)", "decay": "mix(0.15 + length * 1.2, 0.03 + length * 0.3, hand)", "damp": "mix(0.55 - bright * 0.2 + 0.1 * (strings < 7.5 ? 1 : 0), 0.88, hand)", "in": "finger7", "trig": 0 },
    { "id": "run", "type": "expr", "expr": "string1 + string2 + string3 * step(3, strings) * (1 - 0.25 * (strings < 3.5 ? 1 : 0)) + string4 * step(4, strings) * (1 - 0.25 * (strings < 4.5 ? 1 : 0)) + string5 * step(5, strings) * (1 - 0.25 * (strings < 5.5 ? 1 : 0)) + string6 * step(6, strings) * (1 - 0.25 * (strings < 6.5 ? 1 : 0)) + string7 * step(7, strings) * (1 - 0.25 * (strings < 7.5 ? 1 : 0))" },
    { "id": "boxLow", "type": "filter", "mode": "bp", "in": "run", "freq": 230, "q": 1.4 },
    { "id": "boxHigh", "type": "filter", "mode": "bp", "in": "run", "freq": 470, "q": 1.4 },
    { "id": "sum", "type": "expr", "expr": "run + (boxLow * 1.1 + boxHigh * 1.3) * 0.8" },
    { "id": "tone", "type": "filter", "mode": "lp", "in": "sum", "freq": "2200 + bright * 8000", "q": 0.6 },
    { "id": "clean", "type": "filter", "mode": "hp", "in": "tone", "freq": 90 }
  ],
  "out": "clean",
  "presets": {
    "Menu": {
      "pitch": 330,
      "length": 0.26,
      "bright": 0.5,
      "strings": 5
    },
    "Pop-up": {
      "pitch": 392,
      "length": 0.17,
      "bright": 0.6,
      "strings": 3
    },
    "Inventory": {
      "pitch": 294,
      "length": 0.4,
      "bright": 0.45,
      "strings": 7
    }
  }
}
