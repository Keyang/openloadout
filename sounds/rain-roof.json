{
 "format": "sfxpatch/0.1",
 "id": "rain-roof",
 "name": "Rain on a roof",
 "category": "ambience",
 "description": "Light rain heard from indoors: separate drops tapping on a roof over a muffled hush, with a slow drip from the gutter now and then. Change how hard it rains, the size of the drops, the brightness, the kind of roof and how much the gutter drips.",
 "meta": {
  "type": "ambience",
  "role": "environment/weather",
  "themes": ["neutral", "farm", "fantasy"],
  "gameTypes": ["top-down-rpg", "turn-based-rpg", "farming-sim", "puzzle", "platformer"],
  "words": ["rain", "roof", "rooftop", "drops", "drip", "gutter", "indoors", "attic", "shed", "cabin", "cosy", "weather", "tapping", "rainy"],
  "license": "draft"
 },
 "loop": true,
 "duration": 6,
 "normalize": false,
 "params": [
  { "id": "amount", "label": "Rain", "min": 0, "max": 1, "default": 0.5 },
  { "id": "size", "label": "Drop size", "min": 0, "max": 1, "default": 0.5 },
  { "id": "bright", "label": "Brightness", "min": 0, "max": 1, "default": 0.5 },
  { "id": "roof", "label": "Roof", "min": 0, "max": 2, "default": 0, "options": ["Tiles", "Tin", "Wood"] },
  { "id": "drip", "label": "Gutter drip", "min": 0, "max": 1, "default": 0.5 }
 ],
 "nodes": [
  { "id": "isTiles", "type": "expr", "expr": "roof < 0.5 ? 1 : 0" },
  { "id": "isTin", "type": "expr", "expr": "roof >= 0.5 && roof < 1.5 ? 1 : 0" },
  { "id": "isWood", "type": "expr", "expr": "roof >= 1.5 ? 1 : 0" },
  { "id": "dropF", "type": "expr", "expr": "1.3 - 0.6*size" },

  { "id": "tapL", "type": "dust", "density": "10 + 20*amount", "spread": 1 },
  { "id": "tapR", "type": "dust", "density": "10 + 20*amount", "spread": 1 },
  { "id": "tapM", "type": "dust", "density": "4 + 8*amount", "spread": 1 },

  { "id": "tileL", "type": "modal", "in": "tapL", "freq": "(2300 + 900*bright)*dropF*rnd(0.95, 1.05)", "ratios": [1, 1.62, 2.41], "gains": [1, 0.7, 0.5], "decay": "0.012 + 0.012*size", "tilt": 0.6 },
  { "id": "tileR", "type": "modal", "in": "tapR", "freq": "(2700 + 900*bright)*dropF*rnd(0.95, 1.05)", "ratios": [1, 1.62, 2.41], "gains": [1, 0.7, 0.5], "decay": "0.012 + 0.012*size", "tilt": 0.6 },
  { "id": "tileM", "type": "modal", "in": "tapM", "freq": "(1900 + 900*bright)*dropF*rnd(0.95, 1.05)", "ratios": [1, 1.62, 2.41], "gains": [1, 0.7, 0.5], "decay": "0.012 + 0.012*size", "tilt": 0.6 },

  { "id": "tinL", "type": "modal", "in": "tapL", "freq": "1750*dropF*rnd(0.95, 1.05)", "ratios": [1, 2.76, 5.4, 8.93], "gains": [1, 0.5, "0.15 + 0.4*bright", "0.1 + 0.3*bright"], "decay": "0.09 + 0.08*size", "tilt": 0.7 },
  { "id": "tinR", "type": "modal", "in": "tapR", "freq": "2240*dropF*rnd(0.95, 1.05)", "ratios": [1, 2.76, 5.4, 8.93], "gains": [1, 0.5, "0.15 + 0.4*bright", "0.1 + 0.3*bright"], "decay": "0.08 + 0.07*size", "tilt": 0.7 },
  { "id": "tinM", "type": "modal", "in": "tapM", "freq": "1420*dropF*rnd(0.95, 1.05)", "ratios": [1, 2.76, 5.4, 8.93], "gains": [1, 0.5, "0.15 + 0.4*bright", "0.1 + 0.3*bright"], "decay": "0.1 + 0.08*size", "tilt": 0.7 },

  { "id": "woodL", "type": "modal", "in": "tapL", "freq": "520*dropF*rnd(0.95, 1.05)", "ratios": [1, 2.4, 4.1], "gains": [1, 0.6, 0.3], "decay": "0.025 + 0.02*size", "tilt": 0.9 },
  { "id": "woodR", "type": "modal", "in": "tapR", "freq": "610*dropF*rnd(0.95, 1.05)", "ratios": [1, 2.4, 4.1], "gains": [1, 0.6, 0.3], "decay": "0.025 + 0.02*size", "tilt": 0.9 },
  { "id": "woodM", "type": "modal", "in": "tapM", "freq": "450*dropF*rnd(0.95, 1.05)", "ratios": [1, 2.4, 4.1], "gains": [1, 0.6, 0.3], "decay": "0.025 + 0.02*size", "tilt": 0.9 },
  { "id": "clickL", "type": "filter", "mode": "bp", "in": "tapL", "freq": "(1800 + 2400*bright)*dropF", "q": 1.2 },
  { "id": "clickR", "type": "filter", "mode": "bp", "in": "tapR", "freq": "(1900 + 2400*bright)*dropF", "q": 1.2 },

  { "id": "hushL", "type": "noise", "color": "pink" },
  { "id": "hushR", "type": "noise", "color": "pink" },
  { "id": "hushLoL", "type": "filter", "mode": "lp", "in": "hushL", "freq": "600 + 700*bright" },
  { "id": "hushLoR", "type": "filter", "mode": "lp", "in": "hushR", "freq": "600 + 700*bright" },
  { "id": "hushBandL", "type": "filter", "mode": "hp", "in": "hushLoL", "freq": 220 },
  { "id": "hushBandR", "type": "filter", "mode": "hp", "in": "hushLoR", "freq": 220 },

  { "id": "drip1", "type": "clock", "rate": 1, "count": 1, "delay": "rnd(0.45, 1.5)" },
  { "id": "drip2", "type": "clock", "rate": 1, "count": 1, "delay": "rnd(2.3, 3.3)" },
  { "id": "drip3", "type": "clock", "rate": 1, "count": 1, "delay": "rnd(4.1, 5.2)" },
  { "id": "jump1", "type": "env", "points": [[0, 1], [0.025, "semi(rnd(3, 7))", "exp"]], "trig": "drip1" },
  { "id": "jump2", "type": "env", "points": [[0, 1], [0.025, "semi(rnd(3, 7))", "exp"]], "trig": "drip2" },
  { "id": "jump3", "type": "env", "points": [[0, 1], [0.025, "semi(rnd(3, 7))", "exp"]], "trig": "drip3" },
  { "id": "plink1", "type": "osc", "freq": "rnd(700, 1250)*jump1" },
  { "id": "plink2", "type": "osc", "freq": "rnd(700, 1250)*jump2" },
  { "id": "plink3", "type": "osc", "freq": "rnd(700, 1250)*jump3" },
  { "id": "amp1", "type": "ad", "attack": 0.002, "decay": "rnd(0.09, 0.14)", "curve": 2.2, "trig": "drip1" },
  { "id": "amp2", "type": "ad", "attack": 0.002, "decay": "rnd(0.09, 0.14)", "curve": 2.2, "trig": "drip2" },
  { "id": "amp3", "type": "ad", "attack": 0.002, "decay": "rnd(0.09, 0.14)", "curve": 2.2, "trig": "drip3" },
  { "id": "third", "type": "rand", "lo": 0, "hi": 1 },
  { "id": "dripMix", "type": "expr", "expr": "plink1*amp1*rnd(0.7, 1) + plink2*amp2*rnd(0.7, 1) + plink3*amp3*(third > 0.45 ? rnd(0.6, 1) : 0)" },

  { "id": "tapLvl", "type": "expr", "expr": "(0.5 + 0.5*amount)*(0.85 + 0.35*size)" },
  { "id": "mixL", "type": "expr", "expr": "((tileL*0.24 + tileM*0.11 + clickL*0.25)*isTiles + (tinL*0.21 + tinM*0.09)*isTin + (woodL*0.24 + woodM*0.1 + clickL*0.1)*isWood)*tapLvl + hushBandL*(0.012 + 0.03*amount) + dripMix*drip*0.55" },
  { "id": "mixR", "type": "expr", "expr": "((tileR*0.24 + tileM*0.11 + clickR*0.25)*isTiles + (tinR*0.21 + tinM*0.09)*isTin + (woodR*0.24 + woodM*0.1 + clickR*0.1)*isWood)*tapLvl + hushBandR*(0.012 + 0.03*amount) + dripMix*drip*0.42" },
  { "id": "outL", "type": "filter", "mode": "hp", "in": "mixL", "freq": 40 },
  { "id": "outR", "type": "filter", "mode": "hp", "in": "mixR", "freq": 40 }
 ],
 "out": ["outL", "outR"],
 "presets": {
  "Attic": { "amount": 0.45, "size": 0.4, "bright": 0.5, "roof": 0, "drip": 0.45 },
  "Tin shed": { "amount": 0.55, "size": 0.45, "bright": 0.6, "roof": 1, "drip": 0.6 },
  "Cabin": { "amount": 0.5, "size": 0.6, "bright": 0.35, "roof": 2, "drip": 0.4 }
 }
}
