{
 "format": "sfxpatch/0.1",
 "id": "menu-console-open",
 "name": "Console open",
 "category": "ui",
 "description": "A menu or window opening on a warm console: one soft electric-piano note sliding quickly up into place, with a gentle echo. Change its pitch, length, brightness, echo and how far it slides. The same every time.",
 "meta": {
  "type": "sfx",
  "role": "interface/click",
  "themes": [
   "neutral"
  ],
  "gameTypes": [
   "arcade",
   "turn-based-rpg",
   "puzzle",
   "card-game"
  ],
  "words": [
   "open",
   "menu",
   "window",
   "popup",
   "panel",
   "inventory",
   "appear",
   "slide",
   "retro",
   "console",
   "echo"
  ],
  "license": "draft"
 },
 "duration": "length + 0.09 + 0.01",
 "params": [
  {
   "id": "pitch",
   "label": "Pitch",
   "unit": "Hz",
   "min": 260,
   "max": 700,
   "default": 440,
   "scale": "log"
  },
  {
   "id": "length",
   "label": "Length",
   "unit": "s",
   "min": 0.15,
   "max": 0.4,
   "default": 0.25,
   "scale": "log"
  },
  {
   "id": "bright",
   "label": "Brightness",
   "min": 0,
   "max": 1,
   "default": 0.5
  },
  {
   "id": "echo",
   "label": "Echo",
   "min": 0.15,
   "max": 0.6,
   "default": 0.35
  },
  {
   "id": "glide",
   "label": "Glide",
   "unit": "semitones",
   "min": 5,
   "max": 19,
   "default": 12
  }
 ],
 "nodes": [
  {
   "id": "sl",
   "type": "env",
   "points": [
    [
     0,
     "pitch*semi(-glide)"
    ],
    [
     "length*0.4",
     "pitch",
     "exp"
    ]
   ]
  },
  {
   "id": "c1",
   "type": "clock",
   "rate": 1,
   "count": 1
  },
  {
   "id": "a1",
   "type": "ad",
   "attack": 0.002,
   "decay": "length",
   "curve": 2,
   "trig": "c1"
  },
  {
   "id": "k1",
   "type": "ad",
   "attack": 0.0005,
   "decay": "0.02 + length*0.3",
   "curve": 2,
   "trig": "c1"
  },
  {
   "id": "m1",
   "type": "osc",
   "freq": "sl"
  },
  {
   "id": "o1",
   "type": "osc",
   "freq": "sl",
   "pm": "m1*(0.04 + (0.08 + bright*0.12)*k1)"
  },
  {
   "id": "notes",
   "type": "expr",
   "expr": "o1*a1"
  },
  {
   "id": "grain",
   "type": "crush",
   "in": "notes",
   "bits": 12,
   "rate": 30000
  },
  {
   "id": "tone",
   "type": "filter",
   "mode": "lp",
   "in": "grain",
   "freq": "2000 + bright*3000",
   "q": 0.6
  },
  {
   "id": "rep",
   "type": "delay",
   "in": "tone",
   "time": 0.09,
   "feedback": 0,
   "mix": 1,
   "max": 0.2
  },
  {
   "id": "soft",
   "type": "filter",
   "mode": "lp",
   "in": "rep",
   "freq": "1500 + bright*1500",
   "q": 0.6
  },
  {
   "id": "clean",
   "type": "filter",
   "mode": "hp",
   "in": "tone + soft*echo",
   "freq": 120
  }
 ],
 "out": "clean",
 "presets": {
  "Menu": {
   "pitch": 440,
   "length": 0.25
  },
  "Pop-up": {
   "pitch": 494,
   "length": 0.18,
   "glide": 7
  },
  "Inventory": {
   "pitch": 440,
   "length": 0.35,
   "glide": 14,
   "echo": 0.45
  }
 }
}
