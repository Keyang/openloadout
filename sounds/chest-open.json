   "open",
   "lid",
   "creak",
   "latch",
   "reward",
   "wooden",
   "sparkle",
   "unlock",
   "box"
  ],
  "license": "draft"
 },
 "duration": "max(0.62, (0.16+0.2*creak) + 0.08 + 0.1 + 0.3*sparkle + 0.04)",
 "params": [
  {
   "id": "creak",
   "label": "Creak",
   "min": 0,
   "max": 1,
   "default": 0.6
  },
  {
   "id": "pitch",
   "label": "Pitch",
   "unit": "Hz",
   "min": 80,
   "max": 220,
   "default": 130,
   "scale": "log"
  },
  {
   "id": "latch",
   "label": "Click",
   "min": 0,
   "max": 1,
   "default": 0.6
  },
  {
   "id": "sparkle",
   "label": "Sparkle",
   "min": 0,
   "max": 1,
   "default": 0.8
  },
  {
   "id": "bright",
   "label": "Brightness",
   "min": 0,
   "max": 1,
   "default": 0.5
  }
 ],
 "nodes": [
  {
   "id": "ck",
   "type": "clock",
   "rate": 45,
   "jitter": 0.4
  },
  {
   "id": "wr",
   "type": "rand",
   "lo": -1,
   "hi": 1,
   "trig": "ck"
  },
  {
   "id": "wl",
   "type": "lag",
   "in": "wr",
   "time": 0.02
  },
  {
   "id": "gr",
   "type": "rand",
   "lo": 0.45,
   "hi": 1,
   "trig": "ck"
  },
  {
   "id": "gl",
   "type": "lag",
   "in": "gr",
   "time": 0.006
  },
  {
   "id": "cf",
   "type": "env",
   "points": [
    [
     0,
     "pitch*0.9"
    ],
    [
     "(0.16+0.2*creak)",
     "pitch*1.35",
     "lin"
    ]
   ]
  },
  {
   "id": "saw",
   "type": "osc",
   "wave": "saw",
   "freq": "cf*(1+0.22*wl)"
  },
  {
   "id": "bpf",
   "type": "env",
   "points": [
    [
     0,
     "450+700*bright"
    ],
    [
     "(0.16+0.2*creak)",
     "1300+1700*bright",
     "lin"
    ]
   ]
  },
  {
   "id": "cband",
   "type": "filter",
   "mode": "bp",
   "in": "saw",
   "freq": "bpf*(1+0.12*wl)",
   "q": 5
  },
  {
   "id": "camp",
   "type": "env",
   "points": [
    [
     0,
     0
    ],
    [
     0.03,
     1,
     "lin"
    ],
    [
     "(0.16+0.2*creak)",
     0.5,
     "lin"
    ],
    [
     "(0.16+0.2*creak)+0.02",
     0,
     "lin"
    ]
   ]
  },
  {
   "id": "creakSig",
   "type": "expr",
   "expr": "cband*camp*gl"
  },
  {
   "id": "lc",
   "type": "clock",
   "rate": 1,
   "count": 1,
   "delay": "(0.16+0.2*creak)"
  },
  {
   "id": "clickEnv",
   "type": "ad",
   "attack": 0.0004,
   "decay": 0.012,
   "curve": 2,
   "trig": "lc"
  },
  {
   "id": "cn",
   "type": "noise"
  },
  {
   "id": "clickN",
   "type": "filter",
   "mode": "bp",
   "in": "cn*clickEnv",
   "freq": "2200+2500*bright",
   "q": 2.5
  },
  {
   "id": "knockEx",
   "type": "ad",
   "attack": 0.0004,
   "decay": 0.006,
   "curve": 2,
   "trig": "lc"
  },
  {
   "id": "knock",
   "type": "modal",
   "in": "cn*knockEx",
   "freq": "pitch*2.2",
   "ratios": [
    1,
    2.3,
    3.9
   ],
   "decay": 0.16,
   "tilt": 0.9
  },
  {
   "id": "bc",
   "type": "clock",
   "rate": 11,
   "count": 2,
   "delay": "(0.16+0.2*creak)+0.06"
  },
  {
   "id": "bn",
   "type": "seq",
   "steps": [
    "1046*(pitch/130)^0.35",
    "1568*(pitch/130)^0.35"
   ],
   "trig": "bc"
  },
  {
   "id": "bamp",
   "type": "ad",
   "attack": 0.002,
   "decay": 0.26,
   "curve": 2.2,
   "trig": "bc"
  },
  {
   "id": "bt",
   "type": "osc",
   "wave": "tri",
   "freq": "bn"
  },
  {
   "id": "bq",
   "type": "osc",
   "wave": "square",
   "freq": "bn"
  },
  {
   "id": "bh",
   "type": "osc",
   "wave": "sine",
   "freq": "bn*3"
  },
  {
   "id": "bells",
   "type": "expr",
   "expr": "(bt*0.6 + bq*0.12 + bh*bright*0.35)*bamp"
  },
  {
   "id": "summ",
   "type": "expr",
   "expr": "creakSig*1.3 + clickN*latch*1.6 + knock*latch*0.22 + bells*sparkle*1.5"
  },
  {
   "id": "lp",
   "type": "filter",
   "mode": "lp",
   "in": "summ",
   "freq": "3500+9000*bright"
  },
  {
   "id": "hp",
   "type": "filter",
   "mode": "hp",
   "in": "lp",
   "freq": 40
  }
 ],
 "out": "hp",
 "presets": {
  "Treasure chest": {
   "creak": 0.6,
   "pitch": 130,
   "latch": 0.6,
   "sparkle": 0.8,
   "bright": 0.5
  },
  "Small box": {
   "creak": 0.1,
   "pitch": 210,
   "latch": 0.9,
   "sparkle": 0.4,
   "bright": 0.7
  },
  "Heavy lid": {
   "creak": 1,
   "pitch": 82,
   "latch": 0.8,
   "sparkle": 0.5,
   "bright": 0.25
  }
 }
}