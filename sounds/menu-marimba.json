  "type": "music",
  "role": "music/menu",
  "themes": [
   "neutral"
  ],
  "gameTypes": [
   "puzzle",
   "arcade"
  ],
  "words": [
   "menu",
   "title",
   "title screen",
   "puzzle",
   "marimba",
   "wooden",
   "mallet",
   "sunny",
   "curious",
   "bouncy",
   "playful",
   "clockwork"
  ],
  "license": "draft"
 },
